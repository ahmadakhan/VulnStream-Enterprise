{
	default_sni {$APP_HOST}
}

{$APP_HOST} {
	encode zstd gzip
	reverse_proxy {
		dynamic a app 8080 {
			refresh 2s
			versions ipv4
		}
		lb_policy round_robin
		lb_try_duration 5s
		lb_retry_match {
			method GET HEAD
		}
		fail_duration 10s
		max_fails 1
		unhealthy_status 503
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
		}
	}
}
