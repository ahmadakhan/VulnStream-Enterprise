    content: "              <div>\n                <label className=\"block text-zinc-400 mb-1 font-mono\">Operational Notes</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Enterprise SSL-VPN concentrator\"\n                  value={formData.notes}\n                  onChange={e => setFormData({ ...formData, notes: e.target.value })}\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"flex justify-end space-x-2 pt-3 border-t border-zinc-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddModal(false)}\n                  className=\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300\"\n                >\n                  Cancel\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold\"\n                >\n                  {editingItem ? \'Save Changes\' : \'Register Product\'}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* Bulk JSON Import Modal */}\n      {showBulkModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl relative\">\n            <button\n              onClick={() => {\n                setShowBulkModal(false);\n                setBulkFeedback(null);\n              }}\n              className=\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <h2 className=\"text-base font-bold text-zinc-100 mb-1 flex items-center gap-2\">\n              <Upload className=\"w-4 h-4 text-zinc-300\" />\n              Bulk Product Asset Import (JSON)\n            </h2>\n            <p className=\"text-xs text-zinc-400 mb-4\">\n              Import up to 1,000 product records. Provide vendor, product, assetTag, exposure, and optional CPE 2.3 expressions.\n            </p>\n\n            <div className=\"mb-2 flex justify-end\">\n              <button\n                onClick={() => setBulkJsonText(JSON.stringify(sampleJson, null, 2))}\n                className=\"text-[11px] text-zinc-400 hover:text-zinc-200 underline font-mono flex items-center gap-1\"\n              >\n                <Code className=\"w-3 h-3\" />\n                Load Sample JSON\n              </button>\n            </div>\n\n            <textarea\n              rows={9}\n              placeholder=\"Paste JSON array here...\"\n              value={bulkJsonText}\n              onChange={e => setBulkJsonText(e.target.value)}\n              className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-3 font-mono text-xs text-zinc-200 focus:outline-none focus:border-zinc-600\"\n            />\n\n            {bulkFeedback && (\n              <div\n                className={`mt-3 p-3 rounded-xl text-xs ${\n                  bulkFeedback.errors.length > 0\n                    ? \'bg-zinc-950 border border-zinc-700 text-zinc-300\'\n                    : \'bg-zinc-950 border border-emerald-800 text-emerald-300\'\n                }`}\n              >\n                <div className=\"font-bold\">\n                  {bulkFeedback.imported > 0\n                    ? `Imported ${bulkFeedback.imported} products.`\n                    : \'Import Failed\'}\n                </div>\n                {bulkFeedback.errors.map((err, i) => (\n                  <div key={i} className=\"text-[11px] text-zinc-400 mt-1\">\n                    \342\200\242 {err}\n                  </div>\n                ))}\n              </div>\n            )}\n\n            <div className=\"flex justify-end space-x-2 mt-4 pt-3 border-t border-zinc-800\">\n              <button\n                onClick={() => setShowBulkModal(false)}\n                className=\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleBulkImport}\n                disabled={!bulkJsonText.trim()}\n                className=\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold text-xs disabled:opacity-50\"\n              >\n                Ingest Product Records\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
