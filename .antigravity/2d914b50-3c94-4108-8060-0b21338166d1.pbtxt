              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const diff = new Date(deadlineIso).getTime() - Date.now();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    if (diff <= 0 || isBreached) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const overdueMins = Math.abs(Math.floor(diff / 60000));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const overdueHours = Math.floor(overdueMins / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      return `BREACHED (${overdueHours}h ${overdueMins % 60}m ago)`;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const mins = Math.floor(diff / 60000);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const hours = Math.floor(mins / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    const secs = Math.floor((diff % 60000) / 1000);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    return `${hours}h ${mins % 60}m ${secs}s remaining`;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
