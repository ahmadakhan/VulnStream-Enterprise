      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { Advisory } from \'../types\';\nimport {\n  FileText,\n  Download,\n  Printer,\n  Copy,\n  Check,\n  ExternalLink,\n  ShieldAlert,\n  Clock,\n  Send,\n  X,\n  AlertTriangle,\n  Mail,\n} from \'lucide-react\';\n\nexport const AdvisoriesView: React.FC = () => {\n  const { advisories, selectedAdvisory, setSelectedAdvisory } = useApp();\n  const [copied, setCopied] = useState(false);\n  const [activeModalAdvisory, setActiveModalAdvisory] = useState<Advisory | null>(null);\n\n  const handleCopyMarkdown = (adv: Advisory) => {\n    const md = `# SECURITY ADVISORY: ${adv.id}\n**Title:** ${adv.title}\n**Severity:** ${adv.severity}\n**Created:** ${new Date(adv.createdDate).toUTCString()}\n**Delivery Status:** ${adv.deliveryStatus} (${adv.recipientCount} Recipients)\n\n## Executive Summary\n${adv.executiveSummary}\n\n## Affected Vulnerabilities\n${adv.cveIds.map(c => `- ${c}`).join(\'\\n\')}\n\n## Affected Systems\n${adv.affectedSystems.map(s => `- ${s}`).join(\'\\n\')}\n\n## SLA & Remediation Instructions\n${adv.slaWarning}\n${adv.remediationInstructions}\n\n---\n*Generated autonomously by VulnStream Enterprise Threat Ingestion Engine.*`;\n\n    navigator.clipboard.writeText(md);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handlePrintPdf = (adv: Advisory) => {\n    const printWindow = window.open(\'\', \'_blank\');\n    if (!printWindow) {\n      alert(\'Pop-up was blocked. Please allow pop-ups for PDF generation.\');\n      return;\n    }\n\n    printWindow.document.write(`\n      <!DOCTYPE html>\n      <html>\n      <head>\n        <title>${adv.id} - Security Advisory</title>\n        <style>\n          body { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; padding: 40px; color: #1e293b; }\n          .header { border-bottom: 3px solid #dc2626; padding-bottom: 20px; margin-bottom: 30px; }\n          .title { font-size: 24px; font-weight: bold; margin: 0 0 8px 0; color: #0f172a; }\n          .badge { display: inline-block; background: #991b1b; color: white; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 12px; }\n          .section { margin-bottom: 25px; }\n          .section-title { font-size: 16px; font-weight: bold; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; margin-bottom: 10px; color: #334155; }\n          .sla-box { background: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #ef4444; padding: 12px; border-radius: 4px; margin-bottom: 20px; }\n          .mono { font-family: monospace; background: #f1f5f9; padding: 2px 6px; border-radius: 3px; }\n          .footer { margin-top: 50px; font-size: 11px; color: #64748b; border-top: 1px solid #cbd5e1; padding-top: 15px; }\n        </style>\n      </head>\n      <body>\n        <div class=\"header\">\n          <span class=\"badge\">${adv.severity} PRIORITY</span>\n          <h1 class=\"title\">${adv.id}: ${adv.title}</h1>\n          <p style=\"color: #64748b; font-size: 12px; margin: 0;\">Dispatched on ${new Date(adv.createdDate).toUTCString()} to ${adv.recipientCount} SOC stakeholders</p>\n        </div>\n\n        <div class=\"sla-box\">\n          <strong>SLA Enforcement Directive:</strong><br>\n          ${adv.slaWarning}\n        </div>\n\n        <div class=\"section\">\n          <div class=\"section-title\">1. Executive Summary</div>\n          <p style=\"line-height: 1.6;\">${adv.executiveSummary}</p>\n        </div>\n\n        <div class=\"section\">\n          <div class=\"section-title\">2. Affected Vulnerabilities &amp; Monitored Assets</div>\n          <p><strong>CVE Identifiers:</strong> <span class=\"mono\">${adv.cveIds.join(\', \')}</span></p>\n          <p><strong>Impacted Systems:</strong></p>\n          <ul>\n            ${adv.affectedSystems.map(s => `<li>${s}</li>`).join(\'\')}\n          </ul>\n        </div>\n\n        <div class=\"section\">\n          <div class=\"section-title\">3. Mandatory Remediation &amp; Containment Instructions</div>\n          <p style=\"line-height: 1.6;\">${adv.remediationInstructions}</p>\n        </div>\n\n        <div class=\"footer\">\n          CONFIDENTIAL &amp; PROPRIETARY \342\200\224 STRICT INTERNAL DISTRIBUTION ONLY.<br>\n          Produced by VulnStream Enterprise Threat Ingestion Engine.\n        </div>\n      </body>\n      </html>\n    `);\n\n    printWindow.document.close();\n    printWindow.focus();\n    setTimeout(() => {\n      printWindow.print();\n    }, 400);\n  };\n\n  const handleDownloadJson = (adv: Advisory) => {\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(adv, null, 2));\n    const downloadAnchor = document.createElement(\'a\');\n    downloadAnchor.setAttribute(\'href\', dataStr);\n    downloadAnchor.setAttribute(\'download\', `${adv.id}.json`);\n    document.body.appendChild(downloadAnchor);\n    downloadAnchor.click();\n    downloadAnchor.remove();\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-white tracking-tight flex items-center gap-2\">\n            <FileText className=\"w-5 h-5 text-indigo-400\" />\n            Security Advisories &amp; Notification Dispatch\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Formal vulnerability advisories generated during pipeline runs, linked to actionable CVEs, affected systems, and distribution delivery logs.\n          </p>\n        </div>\n      </div>\n\n      {/* Advisories Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {advisories.map(adv => {\n          const isCritical = adv.severity === \'CRITICAL\';\n\n          return (\n            <div\n              key={adv.id}\n              className={`bg-slate-900/90 border rounded-xl p-5 shadow-lg flex flex-col justify-between transition hover:border-slate-700 ${\n                isCritical ? \'border-red-900/60\' : \'border-slate-800\'\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-3\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"font-mono font-bold text-white text-sm bg-slate-950 px-2 py-0.5 rounded border border-slate-800\">\n                      {adv.id}\n                    </span>\n                    <span\n                      className={`text-[10px] font-bold font-mono px-2 py-0.5 rounded ${\n                        isCritical\n                          ? \'bg-red-950 text-red-300 border border-red-800\'\n                          : \'bg-amber-950 text-amber-300 border border-amber-800\'\n                      }`}\n                    >\n                      {adv.severity}\n                    </span>\n                  </div>\n\n                  <span className=\"text-[11px] font-mono text-emerald-400 flex items-center gap-1 bg-emerald-950/40 border border-emerald-800/40 px-2 py-0.5 rounded\">\n                    <Send className=\"w-3 h-3 text-emerald-400\" />\n                    <span>{adv.deliveryStatus} ({adv.recipientCount} Sent)</span>\n                  </span>\n                </div>\n\n                <h3 className=\"font-bold text-white text-sm mb-2 hover:text-indigo-300 transition\">\n                  {adv.title}\n                </h3>\n\n                <p className=\"text-xs text-slate-300 line-clamp-2 leading-relaxed mb-3\">\n                  {adv.executiveSummary}\n                </p>\n\n                {/* Affected CVEs & Systems pills */}\n                <div className=\"space-y-1.5 text-xs text-slate-400\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"font-mono text-[11px] text-slate-500\">CVEs:</span>\n                    <div className=\"flex flex-wrap gap-1\">\n                      {adv.cveIds.map(cve => (\n                        <span key={cve} className=\"bg-slate-950 text-indigo-300 px-1.5 py-0.2 rounded font-mono text-[10px] border border-slate-800\">\n                          {cve}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"font-mono text-[11px] text-slate-500\">Systems:</span>\n                    <span className=\"text-slate-300 font-mono text-[11px] line-clamp-1\">\n                      {adv.affectedSystems.join(\', \')}\n                    </span>\n                  </div>\n                </div>\n\n                {/* SLA Warning */}\n                <div className=\"mt-3 p-2.5 rounded bg-slate-950 border border-slate-800/80 text-[11px] text-amber-300/90 font-mono flex items-center gap-1.5\">\n                  <AlertTriangle className=\"w-3.5 h-3.5 text-amber-400 shrink-0\" />\n                  <span className=\"line-clamp-1\">{adv.slaWarning}</span>\n                </div>\n              </div>\n\n              {/* Actions Footer */}\n              <div className=\"mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs\">\n                <span className=\"text-[11px] text-slate-500 font-mono\">\n                  {new Date(adv.createdDate).toLocaleDateString()}\n                </span>\n\n                <div className=\"flex items-center space-x-2\">\n                  <button\n                    onClick={() => handleDownloadJson(adv)}\n                    className=\"p-1.5 rounded bg-slate-950 border border-slate-800 text-slate-400 hover:text-white transition\"\n                    title=\"Download JSON\"\n                  >\n                    <Download className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => handleCopyMarkdown(adv)}\n                    className=\"p-1.5 rounded bg-slate-950 border border-slate-800 text-slate-400 hover:text-white transition\"\n                    title=\"Copy Markdown\"\n                  >\n                    {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                  </button>\n                  <button\n                    onClick={() => handlePrintPdf(adv)}\n                    className=\"px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium border border-slate-700 flex items-center space-x-1\"\n                    title=\"Export High-Fidelity PDF\"\n                  >\n                    <Printer className=\"w-3.5 h-3.5 text-red-400\" />\n                    <span>PDF Export</span>\n                  </button>\n                  <button\n                    onClick={() => setActiveModalAdvisory(adv)}\n                    className=\"px-2.5 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow\"\n                  >\n                    View Bulletin\n                  </button>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Advisory Bulletin Modal */}\n      {activeModalAdvisory && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-slate-900 border border-slate-700 rounded-xl max-w-2xl w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={() => setActiveModalAdvisory(null)}\n              className=\"absolute top-4 right-4 text-slate-400 hover:text-white\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"border-b border-red-500/50 pb-4 mb-4\">\n              <span className=\"text-[10px] font-bold font-mono px-2 py-0.5 rounded bg-red-950 text-red-300 border border-red-800\">\n                {activeModalAdvisory.severity} ADVISORY\n              </span>\n              <h2 className=\"text-lg font-bold text-white mt-2\">\n                {activeModalAdvisory.id}: {activeModalAdvisory.title}\n              </h2>\n              <p className=\"text-xs text-slate-400 font-mono mt-0.5\">\n                Dispatched on {new Date(activeModalAdvisory.createdDate).toUTCString()}\n              </p>\n            </div>\n\n            <div className=\"space-y-4 text-xs\">\n              <div className=\"bg-slate-950 border border-slate-800 p-3 rounded-lg text-amber-300 font-mono\">\n                <div className=\"font-bold mb-0.5\">SLA Target Directive</div>\n                <div>{activeModalAdvisory.slaWarning}</div>\n              </div>\n\n              <div>\n                <h4 className=\"font-bold text-white uppercase tracking-wider mb-1 text-[11px]\">\n                  1. Executive Summary\n                </h4>\n                <p className=\"text-slate-300 leading-relaxed bg-slate-950/60 p-3 rounded border border-slate-800\">\n                  {activeModalAdvisory.executiveSummary}\n                </p>\n              </div>\n\n              <div>\n                <h4 className=\"font-bold text-white uppercase tracking-wider mb-1 text-[11px]\">\n                  2. Impacted CVEs &amp; Assets\n                </h4>\n                <div className=\"bg-slate-950/60 p-3 rounded border border-slate-800 space-y-1\">\n                  <div><strong>CVEs:</strong> {activeModalAdvisory.cveIds.join(\', \')}</div>\n                  <div><strong>Impacted Assets:</strong> {activeModalAdvisory.affectedSystems.join(\', \')}</div>\n                </div>\n              </div>\n\n              <div>\n                <h4 className=\"font-bold text-white uppercase tracking-wider mb-1 text-[11px]\">\n                  3. Technical Remediation Instructions\n                </h4>\n                <div className=\"bg-slate-950 p-3 rounded border border-slate-800 text-emerald-400 font-mono leading-relaxed\">\n                  {activeModalAdvisory.remediationInstructions}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex justify-end space-x-2 mt-6 pt-4 border-t border-slate-800\">\n              <button\n                onClick={() => handlePrintPdf(activeModalAdvisory)}\n                className=\"px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs flex items-center space-x-1\"\n              >\n                <Printer className=\"w-3.5 h-3.5\" />\n                <span>Print / Save PDF</span>\n              </button>\n              <button\n                onClick={() => setActiveModalAdvisory(null)}\n                className=\"px-4 py-1.5 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs\"\n              >\n                Close Bulletin\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
