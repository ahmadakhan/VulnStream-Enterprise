        target_content: "  for (const cve of enrichedCves) {\n    for (const asset of activeAssets) {\n      const matchResult = matchesWatchlistItem(\n        asset.cpes,\n        asset.vendor,\n        asset.product,\n        cve.cpeMatches,\n        cve.title,\n        cve.description\n      );\n\n      if (matchResult.matched) {\n        const uniqueKey = `${cve.cveId}::${asset.id}`;\n        \n        // Idempotency: Don\'t duplicate if already recorded\n        if (existingFindingCveAndAsset.has(uniqueKey)) {\n          continue;\n        }\n\n        const exploitRisk = determineExploitRisk(cve);\n\n        const finding: Finding = {\n          id: `fnd-${Math.random().toString(36).substring(2, 8)}`,\n          cveId: cve.cveId,\n          cve,\n          matchedAssetId: asset.id,\n          matchedAssetName: `${asset.assetTag} (${asset.vendor} ${asset.product})`,\n          matchedCpe: matchResult.matchedCpe || asset.cpes[0] || \'cpe:2.3:*:*:*:*:*:*:*:*:*:*\',\n          exposure: asset.exposure,\n          exploitRisk,\n          notificationStatus: \'QUEUED_FOR_DISPATCH\',\n          status: \'REMEDIATION_AVAILABLE\',\n          autoDispatchedAt: null,\n          advisoryId: null,\n          timeline: [\n            {\n              timestamp: new Date().toISOString(),\n              action: `Matched via ${matchResult.method}`,\n              system: \'Autonomous CPE Matcher\',\n              details: `Correlated product vulnerability ${cve.cveId} with asset ${asset.assetTag}. Risk: ${exploitRisk}.`,\n            },\n          ],\n        };\n\n        newFindings.push(finding);\n      }\n    }\n  }\n\n  phases.push({\n    name: \'Product Watch-List CPE Matching\',\n    status: \'SUCCESS\',\n    durationMs: Date.now() - p4Start + 110,\n    details: `Evaluated ${activeAssets.length} monitored product assets against ${enrichedCves.length} CVEs. Found ${newFindings.length} product impacts.`,\n    metrics: { matchedAssets: newFindings.length },\n  });"
        replacement_content: "  let vexSuppressedCount = 0;\n\n  for (const cve of enrichedCves) {\n    for (const asset of activeAssets) {\n      const matchResult = matchesWatchlistItem(\n        asset.cpes,\n        asset.vendor,\n        asset.product,\n        cve.cpeMatches,\n        cve.title,\n        cve.description,\n        cve.versionRange,\n        asset.purls,\n        cve.purls,\n        asset.targetHw\n      );\n\n      if (matchResult.matched) {\n        const uniqueKey = `${cve.cveId}::${asset.id}`;\n        \n        // Idempotency: Don\'t duplicate if already recorded\n        if (existingFindingCveAndAsset.has(uniqueKey)) {\n          continue;\n        }\n\n        const exploitRisk = determineExploitRisk(cve);\n        const isVexSuppressed = cve.vex?.status === \'not_affected\';\n        if (isVexSuppressed) vexSuppressedCount++;\n\n        const finding: Finding = {\n          id: `fnd-${Math.random().toString(36).substring(2, 8)}`,\n          cveId: cve.cveId,\n          cve,\n          matchedAssetId: asset.id,\n          matchedAssetName: `${asset.assetTag} (${asset.vendor} ${asset.product})`,\n          matchedCpe: matchResult.matchedCpe || asset.cpes[0] || \'cpe:2.3:*:*:*:*:*:*:*:*:*:*\',\n          matchingMethod: matchResult.method,\n          matchingEvidence: matchResult.evidence,\n          exposure: asset.exposure,\n          exploitRisk,\n          notificationStatus: isVexSuppressed ? \'SUPPRESSED_VEX_NOT_AFFECTED\' : \'QUEUED_FOR_DISPATCH\',\n          status: isVexSuppressed ? \'MONITORED\' : \'REMEDIATION_AVAILABLE\',\n          autoDispatchedAt: null,\n          advisoryId: null,\n          timeline: [\n            {\n              timestamp: new Date().toISOString(),\n              action: `Matched via ${matchResult.method} (${matchResult.confidence}% confidence)`,\n              system: \'Autonomous Matching Engine\',\n              details: matchResult.evidence,\n            },\n            ...(isVexSuppressed\n              ? [{\n                  timestamp: new Date().toISOString(),\n                  action: \'Suppressed by VEX (CSAF 2.0)\',\n                  system: \'Autonomous De-Noising Gate\',\n                  details: `Automated alert suppressed: ${cve.vex?.justification || \'Vendor verified component not affected in deployment runtime.\'}`,\n                }]\n              : []),\n          ],\n        };\n\n        newFindings.push(finding);\n      }\n    }\n  }\n\n  phases.push({\n    name: \'Product Watch-List CPE & PURL Matching\',\n    status: \'SUCCESS\',\n    durationMs: Date.now() - p4Start + 110,\n    details: `Evaluated ${activeAssets.length} monitored product assets against ${enrichedCves.length} CVEs. Found ${newFindings.length} product impacts (${vexSuppressedCount} suppressed via CSAF VEX).`,\n    metrics: { matchedAssets: newFindings.length, vexSuppressed: vexSuppressedCount },\n  });"
