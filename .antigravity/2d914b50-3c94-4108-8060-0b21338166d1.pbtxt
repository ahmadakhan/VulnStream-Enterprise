    content: "                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-300 h-1.5 rounded-full\"\n                    style={{ width: `${(internetFacingCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n\n              {/* Internal Critical */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    Internal Critical (Core Infrastructure)\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{internalCriticalCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-400 h-1.5 rounded-full\"\n                    style={{ width: `${(internalCriticalCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n\n              {/* DMZ */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    DMZ Inspection Zones\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{dmzCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-500 h-1.5 rounded-full\"\n                    style={{ width: `${(dmzCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n\n              {/* Workstations / Cloud */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    Workstations &amp; Cloud Infra\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{otherCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-600 h-1.5 rounded-full\"\n                    style={{ width: `${(otherCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-5 pt-4 border-t border-zinc-800/80\">\n            <button\n              onClick={() => setActiveTab(\'watchlist\')}\n              className=\"w-full text-xs py-2 bg-zinc-800/70 hover:bg-zinc-700/70 text-zinc-200 rounded-xl font-medium border border-zinc-700/40 transition text-center\"\n            >\n              Configure Monitored Products \342\206\222\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Autonomous Pipeline Steps */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-5 shadow-sm\">\n        <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-zinc-800/80\">\n          <div className=\"flex items-center space-x-2\">\n            <Cpu className=\"w-4 h-4 text-zinc-300\" />\n            <h2 className=\"text-xs font-semibold text-zinc-200 uppercase tracking-wider\">\n              Autonomous Pipeline Architecture (No Human Intervention)\n            </h2>\n          </div>\n          <span className=\"text-[11px] font-mono text-zinc-400\">\n            Interval: 60m \342\200\242 Auto-Dispatch: Enabled\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-3\">\n          {[\n            { phase: \'1. Feed Ingestion & SSRF\', desc: \'19 Vendor Feeds, STIX/TAXII, RSS & NVD\' },\n            { phase: \'2. Deduplication\', desc: \'Canonical CVE IDs, O(1) set check\' },\n            { phase: \'3. Auto-Enrichment\', desc: \'NVD CVSS v3.1, EPSS percentile, CISA KEV\' },\n            { phase: \'4. Product CPE Match\', desc: \'Strict component matching + fallback\' },\n            { phase: \'5. Instant Auto-Dispatch\', desc: \'Direct Mailgun / SMTP distribution without human gate\' },\n          ].map((step, idx) => (\n            <div key={idx} className=\"bg-zinc-950/60 border border-zinc-800/70 rounded-xl p-3 relative\">\n              <div className=\"text-[10px] font-mono text-zinc-400 flex items-center justify-between\">\n                <span>PHASE {idx + 1}</span>\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-zinc-400\" />\n              </div>\n              <div className=\"font-semibold text-xs text-zinc-200 mt-1\">{step.phase}</div>\n              <div className=\"text-[11px] text-zinc-400 mt-1\">{step.desc}</div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
