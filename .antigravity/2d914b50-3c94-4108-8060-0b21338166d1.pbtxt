ame=\"text-xs px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 flex items-center space-x-1.5 transition\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>Download JSON Report</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Ingestion Metric Counters */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs\">\n              <div className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800/80\">\n                <div className=\"text-zinc-500 text-[11px]\">Raw Feeds Ingested</div>\n                <div className=\"font-mono font-bold text-zinc-200 text-lg mt-0.5\">\n                  {activeExecution.stats.rawIngested}\n                </div>\n              </div>\n              <div className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800/80\">\n                <div className=\"text-zinc-500 text-[11px]\">Normalized CVEs</div>\n                <div className=\"font-mono font-bold text-zinc-200 text-lg mt-0.5\">\n                  {activeExecution.stats.normalized}\n                </div>\n              </div>\n              <div className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800/80\">\n                <div className=\"text-zinc-500 text-[11px]\">Duplicates Dropped</div>\n                <div className=\"font-mono font-bold text-zinc-400 text-lg mt-0.5\">\n                  {activeExecution.stats.inRunDuplicatesDropped}\n                </div>\n              </div>\n              <div className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800/80\">\n                <div className=\"text-zinc-500 text-[11px]\">Product Matches</div>\n                <div className=\"font-mono font-bold text-zinc-200 text-lg mt-0.5\">\n                  {activeExecution.stats.matchedWatchlist}\n                </div>\n              </div>\n              <div className=\"bg-zinc-950 p-3 rounde