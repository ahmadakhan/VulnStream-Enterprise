  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { Finding, FindingStatus, ExposureLevel } from \'../types\';\nimport {\n  Shield,\n  Flame,\n  CheckCircle2,\n  ExternalLink,\n  ChevronRight,\n  Filter,\n  Search,\n  RotateCcw,\n  Terminal,\n  FileCheck,\n  Copy,\n  Check,\n  X,\n  Send,\n  Cpu,\n} from \'lucide-react\';\n\nexport const FindingsView: React.FC = () => {\n  const {\n    findings,\n    selectedFinding,\n    setSelectedFinding,\n    updateFindingStatus,\n    resendNotification,\n  } = useApp();\n\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [severityFilter, setSeverityFilter] = useState(\'ALL\');\n  const [exposureFilter, setExposureFilter] = useState(\'ALL\');\n  const [statusFilter, setStatusFilter] = useState(\'ALL\');\n  const [copiedCmd, setCopiedCmd] = useState<string | null>(null);\n\n  const [statusModalOpen, setStatusModalOpen] = useState(false);\n  const [targetStatus, setTargetStatus] = useState<FindingStatus>(\'REMEDIATION_AVAILABLE\');\n  const [statusNote, setStatusNote] = useState(\'\');\n\n  const [resendModalOpen, setResendModalOpen] = useState(false);\n  const [resendReason, setResendReason] = useState(\'\');\n\n  const filteredFindings = findings.filter(f => {\n    const matchesSearch =\n      f.cveId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      f.matchedAssetName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      f.cve.title.toLowerCase().includes(searchTerm.toLowerCase());\n\n    const matchesSeverity =\n      severityFilter === \'ALL\' || f.cve.cvss.severity === severityFilter;\n\n    const matchesExposure =\n      exposureFilter === \'ALL\' || f.exposure === exposureFilter;\n\n    const matchesStatus =\n      statusFilter === \'ALL\' || f.status === statusFilter;\n\n    return matchesSearch && matchesSeverity && matchesExposure && matchesStatus;\n  });\n\n  const handleCopy = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedCmd(text);\n    setTimeout(() => setCopiedCmd(null), 2000);\n  };\n\n  const handleOpenStatusChange = (status: FindingStatus) => {\n    setTargetStatus(status);\n    setStatusNote(\'\');\n    setStatusModalOpen(true);\n  };\n\n  const handleConfirmStatusChange = () => {\n    if (selectedFinding) {\n      updateFindingStatus(selectedFinding.id, targetStatus, statusNote);\n      setSelectedFinding({\n        ...selectedFinding,\n        status: targetStatus,\n      });\n    }\n    setStatusModalOpen(false);\n  };\n\n  const handleConfirmResend = () => {\n    if (selectedFinding && resendReason.trim()) {\n      resendNotification(selectedFinding.cveId, resendReason);\n      setResendModalOpen(false);\n      setResendReason(\'\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\">\n            <Shield className=\"w-5 h-5 text-zinc-300\" />\n            Product Vulnerability Tracker\n          </h1>\n          <p className=\"text-xs text-zinc-400 mt-1\">\n            Correlated vulnerabilities matching monitored products. Notifications are dispatched autonomously upon detection.\n          </p>\n        </div>\n      </div>\n\n      {/* Filter and Search Bar (NextUI Card Style) */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-sm\">\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by CVE, product, or title...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 transition\"\n          />\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2\">\n          {/* Status Filter */}\n          <div className=\"flex items-center space-x-1.5 text-xs text-zinc-400\">\n            <span>Status:</span>\n            <select\n              value={statusFilter}\n              onChange={e => setStatusFilter(e.target.value)}\n              className=\"bg-zinc-950 border border-zinc-800 rounded-xl px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-600\"\n            >\n              <option value=\"ALL\">All Statuses</option>\n              <option value=\"MONITORED\">Monitored</option>\n              <option value=\"REMEDIATION_AVAILABLE\">Remediation Available</option>\n              <option value=\"PATCH_APPLIED\">Patch Applied</option>\n              <option value=\"RESOLVED\">Resolved</option>\n              <option value=\"FALSE_POSITIVE\">False Positive</option>\n            </select>\n          </div>\n\n          {/* Severity Filter */}\n          <div className=\"flex items-center space-x-1.5 text-xs text-zinc-400\">\n            <span>Severity:</span>\n            <select\n              value={severityFilter}\n              onChange={e => setSeverityFilter(e.target.value)}\n              className=\"bg-zinc-950 border border-zinc-800 rounded-xl px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-600\"\n            >\n              <option value=\"ALL\">All Severities</option>\n              <option value=\"CRITICAL\">Critical (9.0 - 10.0)</option>\n              <option value=\"HIGH\">High (7.0 - 8.9)</option>\n              <option value=\"MEDIUM\">Medium (4.0 - 6.9)</option>\n              <option value=\"LOW\">Low</option>\n            </select>\n          </div>\n\n          {/* Exposure Filter */}\n          <div className=\"flex items-center space-x-1.5 text-xs text-zinc-400\">\n            <span>Exposure:</span>\n            <select\n              value={exposureFilter}\n              onChange={e => setExposureFilter(e.target.value)}\n              className=\"bg-zinc-950 border border-zinc-800 rounded-xl px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-600\"\n            >\n              <option value=\"ALL\">All Exposure</option>\n              <option value=\"INTERNET_FACING\">Internet-Facing</option>\n              <option value=\"INTERNAL_CRITICAL\">Internal Critical</option>\n              <option value=\"DMZ\">DMZ</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Layout: Findings Table + Details Drawer */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* Table column */}\n        <div className={`transition-all ${selectedFinding ? \'lg:col-span-7\' : \'lg:col-span-12\'}`}>\n          <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-zinc-950/80 border-b border-zinc-800/80 text-zinc-400 font-mono uppercase text-[11px]\">\n                  <tr>\n                    <th className=\"py-3 px-3.5\">CVE Identifier</th>\n                    <th className=\"py-3 px-3.5\">Monitored Product</th>\n                    <th className=\"py-3 px-3.5\">CVSS / EPSS</th>\n                    <th className=\"py-3 px-3.5\">Exploit Risk</th>\n                    <th className=\"py-3 px-3.5\">Auto-Notification</th>\n                    <th className=\"py-3 px-3.5 text-right\">Details</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-zinc-800/60\">\n                  {filteredFindings.length === 0 ? (\n                    <tr>\n                      <td colSpan={6} className=\"py-8 text-center text-zinc-500 text-xs\">\n                        No product vulnerabilities match the current filter.\n                      </td>\n                    </tr>\n                  ) : (\n                    filteredFindings.map(finding => {\n                      const isSelected = selectedFinding?.id === finding.id;\n                      const isKev = finding.cve.cisaKev.isKev;\n\n                      return (\n                        <tr\n                          key={finding.id}\n                          onClick={() => setSelectedFinding(finding)}\n                          className={`cursor-pointer transition ${\n                            isSelected\n                              ? \'bg-zinc-800/70 border-l-2 border-zinc-400\'\n                              : \'hover:bg-zinc-800/30\'\n                          }`}\n                        >\n                          {/* CVE ID */}\n                          <td className=\"py-3 px-3.5\">\n                            <div className=\"font-mono font-bold text-zinc-100 flex items-center space-x-1.5\">\n                              <span>{finding.cveId}</span>\n                              {isKev && (\n                                <span title=\"CISA KEV Catalog\">\n                                  <Flame className=\"w-3.5 h-3.5 text-amber-500/80\" />\n                                </span>\n                              )}\n                            </div>\n                            <div className=\"text-[10px] text-zinc-400 line-clamp-1 max-w-[160px]\">\n                              {finding.cve.title}\n                            </div>\n                          </td>\n\n                          {/* Matched Product */}\n                          <td className=\"py-3 px-3.5\">\n                            <div className=\"font-medium text-zinc-200 line-clamp-1 max-w-[180px]\">\n                              {finding.matchedAssetName}\n                            </div>\n                            <div className=\"text-[10px] text-zinc-400 font-mono\">\n                              {finding.exposure.replace(\'_\', \' \')}\n                            </div>\n                          </td>\n\n                          {/* CVSS & EPSS */}\n                          <td className=\"py-3 px-3.5 font-mono text-[11px]\">\n                            <div className=\"flex items-center space-x-1.5\">\n                              <span className=\"font-bold text-zinc-200\">\n                                {finding.cve.cvss.score.toFixed(1)}\n                              </span>\n                              <span className=\"text-zinc-600\">|</span>\n                              <span className=\"text-zinc-400\">\n                                EPSS: {(finding.cve.epss.score * 100).toFixed(1)}%\n                              </span>\n                            </div>\n                          </td>\n\n                          {/* Exploit Risk */}\n                          <td className=\"py-3 px-3.5\">\n                            <span className=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-800/80 text-zinc-300 border border-zinc-700/60\">\n                              {finding.exploitRisk.replace(/_/g, \' \')}\n                            </span>\n                          </td>\n\n                          {/* Notification Status */}\n                          <td className=\"py-3 px-3.5\">\n                            <span className=\"inline-flex items-center gap-1 text-[10px] font-medium px-2 py-0.5 rounded-full bg-zinc-800/80 text-zinc-300 border border-zinc-700/60\">\n                              <Send className=\"w-2.5 h-2.5 text-emerald-400\" />\n                              <span>{finding.notificationStatus.replace(/_/g, \' \')}</span>\n                            </span>\n                          </td>\n\n                          {/* Action */}\n                          <td className=\"py-3 px-3.5 text-right\">\n                            <button\n                              onClick={() => setSelectedFinding(finding)}\n                              className=\"text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center space-x-0.5\"\n                            >\n                              <span>Playbook</span>\n                              <ChevronRight className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </td>\n                        </tr>\n                      );\n                    })\n                  )}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n\n        {/* Remediation Playbook Drawer (5 cols) */}\n        {selectedFinding && (\n          <div className=\"lg:col-span-5 bg-zinc-900/90 border border-zinc-800 rounded-2xl p-5 shadow-xl space-y-4 sticky top-20\">\n            {/* Drawer Header */}\n            <div className=\"flex items-start justify-between pb-3 border-b border-zinc-800\">\n              <div>\n                <div className=\"flex items-center space-x-2\">\n                  <span className=\"text-base font-bold font-mono text-zinc-100\">\n                    {selectedFinding.cveId}\n                  </span>\n                  {selectedFinding.cve.cisaKev.isKev && (\n                    <span className=\"text-[10px] font-medium bg-zinc-800 text-zinc-300 border border-zinc-700 px-2 py-0.5 rounded-full flex items-center gap-1\">\n                      <Flame className=\"w-3 h-3 text-amber-500\" />\n                      CISA KEV\n                    </span>\n                  )}\n                </div>\n                <div className=\"text-xs text-zinc-300 font-medium mt-1\">\n                  {selectedFinding.cve.title}\n                </div>\n              </div>\n\n              <button\n                onClick={() => setSelectedFinding(null)}\n                className=\"text-zinc-500 hover:text-zinc-200 p-1 rounded-lg\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Autonomous Notification Status Card */}\n            <div className=\"p-3.5 rounded-xl border border-zinc-800/80 bg-zinc-950/60 text-zinc-200\">\n              <div className=\"flex items-center justify-between text-xs mb-1\">\n                <span className=\"font-semibold flex items-center gap-1.5 text-zinc-300\">\n                  <Cpu className=\"w-4 h-4 text-zinc-400\" />\n                  Autonomous Notification Status\n                </span>\n                <span className=\"font-mono text-[11px] text-zinc-500\">\n                  Zero Human Gate\n                </span>\n              </div>\n              <div className=\"text-xs text-zinc-400\">\n                Notification <strong className=\"text-zinc-200 font-mono\">{selectedFinding.advisoryId || \'ADV-AUTO\'}</strong> automatically delivered to authorized distribution list.\n              </div>\n            </div>\n\n            {/* Status & Resend Actions */}\n            <div className=\"flex flex-wrap items-center gap-2 pt-1\">\n              <select\n                value={selectedFinding.status}\n                onChange={e => handleOpenStatusChange(e.target.value as FindingStatus)}\n                className=\"bg-zinc-950 border border-zinc-700/80 text-zinc-200 text-xs rounded-xl px-2.5 py-1.5 font-medium focus:outline-none\"\n              >\n                <option value=\"MONITORED\">Status: Monitored</option>\n                <option value=\"REMEDIATION_AVAILABLE\">Status: Remediation Available</option>\n                <option value=\"PATCH_APPLIED\">Status: Patch Applied</option>\n                <option value=\"RESOLVED\">Status: Resolved</option>\n                <option value=\"FALSE_POSITIVE\">Status: False Positive</option>\n              </select>\n\n              <button\n                onClick={() => setResendModalOpen(true)}\n                className=\"text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-2.5 py-1.5 rounded-xl flex items-center space-x-1.5 transition\"\n                title=\"Resend notification to distribution list\"\n              >\n                <Send className=\"w-3 h-3 text-zinc-400\" />\n                <span>Resend Notification</span>\n              </button>\n            </div>\n\n            {/* Matched Product Details */}\n            <div className=\"bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 text-xs space-y-1.5\">\n              <div className=\"text-zinc-500 font-mono text-[10px] uppercase\">Monitored Product Asset</div>\n              <div className=\"text-zinc-200 font-semibold\">{selectedFinding.matchedAssetName}</div>\n              <div className=\"text-zinc-400 font-mono text-[11px]\">\n                Exposure: {selectedFinding.exposure.replace(\'_\', \' \')}\n              </div>\n              <div className=\"text-zinc-500 font-mono text-[10px] break-all\">\n                CPE: {selectedFinding.matchedCpe}\n              </div>\n            </div>\n\n            {/* Vendor Advisory link */}\n            <div className=\"flex items-center justify-between text-xs bg-zinc-950/60 border border-zinc-800 p-3 rounded-xl\">\n              <div>\n                <div className=\"font-semibold text-zinc-200\">Vendor Advisory Reference</div>\n                <div className=\"text-[11px] text-zinc-500 font-mono\">\n                  Ref: {selectedFinding.cve.remediation.vendorAdvisoryRef}\n                </div>\n              </div>\n              <a\n                href={selectedFinding.cve.remediation.patchUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"px-3 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-xl font-medium flex items-center space-x-1 transition border border-zinc-700\"\n              >\n                <span>Vendor Advisory</span>\n                <ExternalLink className=\"w-3 h-3\" />\n              </a>\n            </div>\n\n            {/* Immediate Containment Actions */}\n            <div>\n              <h3 className=\"text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2\">\n                Containment Actions\n              </h3>\n              <ul className=\"space-y-1.5 text-xs text-zinc-300\">\n                {selectedFinding.cve.remediation.immediateActions.map((action, i) => (\n                  <li key={i} className=\"flex items-start space-x-2 bg-zinc-950/40 p-2 rounded-xl border border-zinc-800/60\">\n                    <span className=\"text-zinc-500 font-mono\">\342\200\242</span>\n                    <span>{action}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* CLI Execution Commands */}\n            <div>\n              <h3 className=\"text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <Terminal className=\"w-3.5 h-3.5 text-zinc-400\" />\n                Technical Commands\n              </h3>\n              <div className=\"space-y-2\">\n                {selectedFinding.cve.remediation.stepByStep.map((step, idx) => (\n                  <div key={idx} className=\"bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-xs\">\n                    <div className=\"flex items-center justify-between text-[10px] text-zinc-500 font-mono mb-1\">\n                      <span>Step {idx + 1}</span>\n                      <button\n                        onClick={() => handleCopy(step)}\n                        className=\"text-zinc-400 hover:text-zinc-200 transition flex items-center space-x-1\"\n                      >\n                        {copiedCmd === step ? (\n                          <Check className=\"w-3 h-3 text-emerald-400\" />\n                        ) : (\n                          <Copy className=\"w-3 h-3\" />\n                        )}\n                        <span className=\"text-[10px]\">{copiedCmd === step ? \'Copied\' : \'Copy\'}</span>\n                      </button>\n                    </div>\n                    <code className=\"text-zinc-300 font-mono block break-all text-[11px]\">\n                      {step}\n                    </code>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Rollback Plan */}\n            <div className=\"text-xs bg-zinc-950/60 border border-zinc-800 p-3 rounded-xl\">\n              <div className=\"text-zinc-400 font-semibold mb-1 flex items-center gap-1.5\">\n                <RotateCcw className=\"w-3.5 h-3.5 text-zinc-400\" />\n                Rollback Plan\n              </div>\n              <p className=\"text-zinc-400 text-[11px] leading-relaxed\">\n                {selectedFinding.cve.remediation.rollbackPlan}\n              </p>\n            </div>\n\n            {/* Timeline */}\n            <div>\n              <h3 className=\"text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2\">\n                Autonomous Tracking Timeline\n              </h3>\n              <div className=\"space-y-2 border-l border-zinc-800 pl-3 ml-1 text-xs\">\n                {selectedFinding.timeline.map((event, idx) => (\n                  <div key={idx} className=\"relative\">\n                    <div className=\"absolute -left-[17px] top-1 w-2 h-2 rounded-full bg-zinc-500\" />\n                    <div className=\"font-semibold text-zinc-200\">{event.action}</div>\n                    <div className=\"text-[10px] text-zinc-500 font-mono\">\n                      {new Date(event.timestamp).toLocaleString()} \342\200\242 {event.system}\n                    </div>\n                    <div className=\"text-[11px] text-zinc-400 mt-0.5\">{event.details}</div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Status Transition Modal */}\n      {statusModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-md w-full p-5 shadow-2xl\">\n            <h3 className=\"text-sm font-bold text-zinc-100 mb-1\">\n              Update Vulnerability Tracking Status\n            </h3>\n            <p className=\"text-xs text-zinc-400 mb-3\">\n              Transition status to <strong>{targetStatus}</strong>.\n            </p>\n            <textarea\n              rows={3}\n              placeholder=\"Operational note...\"\n              value={statusNote}\n              onChange={e => setStatusNote(e.target.value)}\n              className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-xs text-zinc-100 focus:outline-none focus:border-zinc-600\"\n            />\n            <div className=\"flex justify-end space-x-2 mt-4\">\n              <button\n                onClick={() => setStatusModalOpen(false)}\n                className=\"px-3 py-1.5 rounded-xl bg-zinc-800 text-zinc-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmStatusChange}\n                className=\"px-4 py-1.5 rounded-xl bg-zinc-100 text-zinc-900 font-semibold text-xs hover:bg-zinc-200\"\n              >\n                Save Status\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Resend Modal */}\n      {resendModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-md w-full p-5 shadow-2xl\">\n            <h3 className=\"text-sm font-bold text-zinc-100 mb-1 flex items-center gap-1.5\">\n              <Send className=\"w-4 h-4 text-zinc-300\" />\n              Resend Product Vulnerability Notification\n            </h3>\n            <p className=\"text-xs text-zinc-400 mb-3\">\n              Transmit an updated advisory email to the configured security distribution list.\n            </p>\n            <textarea\n              rows={3}\n              required\n              placeholder=\"e.g. Vendor released updated maintenance build; notifying team.\"\n              value={resendReason}\n              onChange={e => setResendReason(e.target.value)}\n              className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-xs text-zinc-100 focus:outline-none focus:border-zinc-600\"\n            />\n            <div className=\"flex justify-end space-x-2 mt-4\">\n              <button\n                onClick={() => setResendModalOpen(false)}\n                className=\"px-3 py-1.5 rounded-xl bg-zinc-800 text-zinc-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmResend}\n                disabled={!resendReason.trim()}\n                className=\"px-4 py-1.5 rounded-xl bg-zinc-100 text-zinc-900 font-semibold text-xs hover:bg-zinc-200 disabled:opacity-50\"\n              >\n                Dispatch Notification\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
