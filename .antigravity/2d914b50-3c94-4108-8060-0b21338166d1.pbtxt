  view_file {
    absolute_path_uri: "file:///src/types/index.ts"
    end_line: 308
    content: "import { NvdVersionRange } from \'../utils/versionComparator\';\n\nexport type Severity = \'CRITICAL\' | \'HIGH\' | \'MEDIUM\' | \'LOW\';\n\nexport type ExposureLevel = \n  | \'INTERNET_FACING\' \n  | \'INTERNAL_CRITICAL\' \n  | \'DMZ\' \n  | \'WORKSTATION\' \n  | \'CLOUD_INFRA\';\n\nexport type ExploitRiskLevel = \n  | \'CISA_KEV_EXPLOITED\'\n  | \'WEAPONIZED_EXPLOIT\'\n  | \'HIGH_EPSS_PROBABILITY\'\n  | \'ELEVATED\'\n  | \'STANDARD\';\n\nexport type NotificationStatus = \n  | \'AUTO_DISPATCHED\'\n  | \'QUEUED_FOR_DISPATCH\'\n  | \'DIGEST_BATCHED\'\n  | \'SUPPRESSED_VEX_NOT_AFFECTED\'\n  | \'DELIVERED\'\n  | \'DELIVERY_FAILED\';\n\nexport type FindingStatus = \n  | \'MONITORED\' \n  | \'REMEDIATION_AVAILABLE\' \n  | \'PATCH_APPLIED\' \n  | \'RESOLVED\' \n  | \'FALSE_POSITIVE\';\n\nexport type FeedType = \n  | \'RSS_ATOM\' \n  | \'STIX_2\' \n  | \'TAXII_21\' \n  | \'GITHUB_ADVISORY\' \n  | \'JSON_SEARCH_API\' \n  | \'NVD_API\' \n  | \'EPSS_API\' \n  | \'CISA_KEV\'\n  | \'CSAF_VEX\';\n\nexport type FeedAuthType = \'NONE\' | \'API_KEY\' | \'BEARER\' | \'BASIC\';\n\nexport interface CVSSData {\n  version: \'3.1\' | \'4.0\' | \'2.0\';\n  score: number;\n  vector: string;\n  severity: Severity;\n}\n\nexport interface EPSSData {\n  score: number;\n  percentile: number;\n}\n\nexport interface CisaKevData {\n  isKev: boolean;\n  dateAdded?: string;\n  dueDate?: string;\n  requiredAction?: string;\n  knownRansomwareCampaignUse?: \'Known\' | \'Unknown\';\n}\n\nexport interface VexStatement {\n  status: \'affected\' | \'not_affected\' | \'fixed\' | \'under_investigation\';\n  justification?: string;\n  impactStatement?: string;\n}\n\nexport interface RemediationPlaybook {\n  patchUrl: string;\n  vendorAdvisoryRef: string;\n  immediateActions: string[];\n  workarounds: string[];\n  rollbackPlan: string;\n  stepByStep: string[];\n}\n\nexport interface NormalizedCVE {\n  cveId: string; // Canonical CVE-YYYY-NNNNN\n  title: string;\n  description: string;\n  publishedDate: string;\n  modifiedDate: string;\n  cvss: CVSSData;\n  cwe: string[];\n  cpeMatches: string[]; // CPE 2.3 formatted strings\n  versionRange?: NvdVersionRange; // NVD Version Interval\n  purls?: string[]; // Package URLs (PURL)\n  vex?: VexStatement; // CSAF 2.0 VEX status\n  sourceFeeds: string[];\n  epss: EPSSData;\n  cisaKev: CisaKevData;\n  exploitStatus: \'Active Weaponized\' | \'POC Available\' | \'Reported In Wild\' | \'None\';\n  remediation: RemediationPlaybook;\n}\n\nexport interface WatchListItem {\n  id: string;\n  vendor: string;\n  product: string;\n  version?: string;\n  cpes: string[]; // Strict CPE 2.3 entries\n  purls?: string[]; // Optional PURLs\n  targetHw?: string; // Architecture e.g. x86_64, aarch64\n  exposure: ExposureLevel;\n  assetTag: string;\n  ownerGroup: string;\n  active: boolean;\n  notes?: string;\n  createdAt: string;\n}\n\nexport interface Finding {\n  id: string;\n  cveId: string;\n  cve: NormalizedCVE;\n  matchedAssetId: string;\n  matchedAssetName: string;\n  matchedCpe: string;\n  matchingMethod: string;\n  matchingEvidence: string;\n  exposure: ExposureLevel;\n  exploitRisk: ExploitRiskLevel;\n  notificationStatus: NotificationStatus;\n  status: FindingStatus;\n  autoDispatchedAt: string | null;\n  advisoryId: string | null;\n  timeline: {\n    timestamp: string;\n    action: string;\n    system: string;\n    details: string;\n  }[];\n}\n\nexport interface ThreatFeed {\n  id: string;\n  name: string;\n  type: FeedType;\n  url: string;\n  authType: FeedAuthType;\n  authSecretKey?: string;\n  rateLimitPerMin: number;\n  enabled: boolean;\n  healthStatus: \'HEALTHY\' | \'DEGRADED\' | \'DOWN\' | \'UNTESTED\';\n  lastSync: string | null;\n  latencyMs: number;\n  vendorSeed: boolean;\n  itemCountLastRun: number;\n  errorLog?: string | null;\n  ssrfValidated: boolean;\n  etag?: string;\n}\n\nexport interface Advisory {\n  id: string;\n  title: string;\n  severity: Severity;\n  cveIds: string[];\n  findingIds: string[];\n  createdDate: string;\n  deliveryStatus: \'DELIVERED\' | \'PENDING\' | \'FAILED\' | \'RETRYING\' | \'DRAFT\';\n  recipientCount: number;\n  executiveSummary: string;\n  remediationInstructions: string;\n  affectedSystems: string[];\n  isDigestBatch?: boolean;\n}\n\nexport interface PipelinePhase {\n  name: string;\n  status: \'PENDING\' | \'RUNNING\' | \'SUCCESS\' | \'WARNING\' | \'FAILED\';\n  durationMs: number;\n  details: string;\n  metrics?: Record<string, string | number>;\n}\n\nexport interface PipelineExecution {\n  id: string;\n  startTime: string;\n  endTime: string | null;\n  status: \'RUNNING\' | \'COMPLETED\' | \'FAILED\' | \'QUARANTINED\';\n  scopeHours: number;\n  phases: PipelinePhase[];\n  stats: {\n    rawIngested: number;\n    normalized: number;\n    deduplicated: number;\n    inRunDuplicatesDropped: number;\n    matchedWatchlist: number;\n    autoDispatchedNotifications: number;\n    advisoriesDispatched: number;\n    webhooksFired: number;\n    vexSuppressedCount: number;\n  };\n  logs: string[];\n}\n\nexport interface AlertedCVE {\n  cveId: string;\n  firstAlertedAt: string;\n  lastAlertedAt: string;\n  advisoryId: string;\n  recipientEmails: string[];\n  status: \'DISPATCHED\' | \'SUPPRESSED\';\n  dispatchCount: number;\n  lastDispatchReason?: string;\n}\n\nexport interface EmailRecipient {\n  id: string;\n  name: string;\n  email: string;\n  role: string;\n  subscriptionTier: \'ALL_SEVERITIES\' | \'CRITICAL_HIGH_ONLY\' | \'CISA_KEV_ONLY\';\n  enabled: boolean;\n  deliverySuccessRate: number;\n}\n\nexport interface WebhookEndpoint {\n  id: string;\n  name: string;\n  url: string;\n  provider: \'SLACK\' | \'TEAMS\' | \'GENERIC_HMAC\';\n  secretToken: string;\n  enabled: boolean;\n  events: (\'CRITICAL\' | \'CISA_KEV\' | \'ALL\')[];\n  deliveryCount: number;\n}\n\nexport interface WebhookDeliveryLog {\n  id: string;\n  endpointId: string;\n  endpointName: string;\n  provider: \'SLACK\' | \'TEAMS\' | \'GENERIC_HMAC\';\n  advisoryId: string;\n  cveId: string;\n  status: \'SUCCESS\' | \'FAILED\' | \'QUEUED\';\n  statusCode: number;\n  hmacSignature: string;\n  sentAt: string;\n}\n\nexport interface EmailDeliveryLog {\n  id: string;\n  recipientEmail: string;\n  advisoryId: string;\n  subject: string;\n  provider: \'Mailgun\' | \'SMTP_Relay\' | \'Local_Mock\';\n  status: \'DELIVERED\' | \'BOUNCED\' | \'RETRYING\' | \'FAILED\';\n  attemptCount: number;\n  retrySchedule: string[];\n  nextRetryTime: string | null;\n  sentAt: string;\n  errorMessage?: string;\n}\n\nexport interface AuditLog {\n  id: string;\n  timestamp: string;\n  category: \'PIPELINE\' | \'SECURITY\' | \'FEED\' | \'WATCHLIST\' | \'EMAIL\' | \'WEBHOOK\';\n  level: \'INFO\' | \'WARNING\' | \'ERROR\';\n  event: string;\n  details: string;\n  actor: string;\n  ipAddress: string;\n  prevHash: string;\n  hash: string;\n}\n\nexport interface AppSettings {\n  scopeHours: number;\n  schedulerIntervalMinutes: number;\n  schedulerEnabled: boolean;\n  advisoryPrefix: string;\n  autoDispatchEnabled: boolean;\n  digestBatchingEnabled: boolean;\n  digestWindowMinutes: number;\n  webhookSigningSecret: string;\n  authorityPrecedence: (\'VENDOR_PSIRT\' | \'CISA_KEV\' | \'FIRST_EPSS\' | \'NVD_BATCH\')[];\n  ssrfProtection: {\n    blockPrivateIps: boolean;\n    blockLoopback: boolean;\n    allowRedirects: boolean;\n  };\n  securityPolicy: {\n    sessionTimeoutMins: number;\n    csrfProtection: boolean;\n    minPasswordLen: number;\n    maxLoginAttempts: number;\n    lockoutMins: number;\n  };\n  ntpConfig: {\n    enabled: boolean;\n    server: string;\n    driftToleranceMs: number;\n  };\n  mailgunConfig: {\n    enabled: boolean;\n    apiKey: string;\n    domain: string;\n    fromEmail: string;\n  };\n}\n"
