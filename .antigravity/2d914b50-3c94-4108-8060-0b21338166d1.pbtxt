-medium text-zinc-200 line-clamp-1 max-w-[180px]\">\n                              {finding.matchedAssetName}\n                            </div>\n                            <div className=\"text-[10px] text-zinc-400 font-mono\">\n                              {finding.exposure.replace(\'_\', \' \')}\n                            </div>\n                          </td>\n\n                          {/* CVSS & EPSS */}\n                          <td className=\"py-3 px-3.5 font-mono text-[11px]\">\n                            <div className=\"flex items-center space-x-1.5\">\n                              <span className=\"font-bold text-zinc-200\">\n                                {finding.cve.cvss.score.toFixed(1)}\n                              </span>\n                              <span className=\"text-zinc-600\">|</span>\n                              <span className=\"text-zinc-400\">\n                                EPSS: {(finding.cve.epss.score * 100).toFixed(1)}%\n                              </span>\n                            </div>\n                          </td>\n\n                          {/* Exploit Risk */}\n                          <td className=\"py-3 px-3.5\">\n                            <span className=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-800/80 text-zinc-300 border border-zinc-700/60\">\n                              {finding.exploitRisk.replace(/_/g, \' \')}\n                            </span>\n                          </td>\n\n                          {/* Notification Status */}\n                          <td className=\"py-3 px-3.5\">\n                            <span className=\"inline-flex items-center gap-1 text-[10px] font-medium px-2 py-0.5 rounded-full bg-zinc-800/80 text-zinc-300 border border-zinc-700/60\">\n                              <Send className=\"w-2.5 h-2.5 text-emerald-400\" />\n                              <span>{finding.notificationStatus.replace(/_/g, \' \')}</span>\n                      