      name: "write_to_file"
      arguments_json: "{\"Append\":false,\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useApp } from \'../context/AppContext\';\\nimport { WatchListItem, ExposureLevel, NormalizedCVE } from \'../types\';\\nimport { generateCPE23, parseCPE23, matchesWatchlistItem, matchVendorWithAliases, matchProductWithAliases } from \'../utils/cpeMatcher\';\\nimport {\\n  Server,\\n  Plus,\\n  Upload,\\n  Download,\\n  Trash2,\\n  Edit2,\\n  Search,\\n  Filter,\\n  X,\\n  Code,\\n  FlaskConical,\\n  CheckCircle2,\\n  AlertCircle,\\n  ExternalLink,\\n  Zap,\\n  ArrowRight,\\n  Shield,\\n  Layers,\\n  Sparkles,\\n} from \'lucide-react\';\\n\\nexport const WatchListView: React.FC = () => {\\n  const {\\n    watchlist,\\n    addWatchlistItem,\\n    updateWatchlistItem,\\n    deleteWatchlistItem,\\n    bulkImportWatchlist,\\n    cveData,\\n  } = useApp();\\n\\n  // Primary view mode: Inventory vs Simulator Lab\\n  const [viewMode, setViewMode] = useState<\'inventory\' | \'simulator\'>(\'inventory\');\\n\\n  const [searchTerm, setSearchTerm] = useState(\'\');\\n  const [exposureFilter, setExposureFilter] = useState<string>(\'ALL\');\\n  const [showAddModal, setShowAddModal] = useState(false);\\n  const [showBulkModal, setShowBulkModal] = useState(false);\\n  const [editingItem, setEditingItem] = useState<WatchListItem | null>(null);\\n\\n  const [formData, setFormData] = useState({\\n    vendor: \'\',\\n    product: \'\',\\n    cpePart: \'a\' as \'a\' | \'o\' | \'h\',\\n    version: \'*\',\\n    targetHw: \'*\',\\n    purls: \'\',\\n    cpeString: \'\',\\n    exposure: \'INTERNET_FACING\' as ExposureLevel,\\n    assetTag: \'\',\\n    ownerGroup: \'\',\\n    notes: \'\',\\n  });\\n\\n  const [bulkJsonText, setBulkJsonText] = useState(\'\');\\n  const [bulkFeedback, setBulkFeedback] = useState<{ imported: number; errors: string[] } | null>(null);\\n\\n  // -------------------------------------------------------------\\n  // Simulator State\\n  // -------------------------------------------------------------\\n  const [simVendor, setSimVendor] = useState(\'paloaltonetworks\');\\n  const [simProduct, setSimProduct] = useState(\'pan-os\');\\n  const [simVersion, setSimVersion] = useState(\'10.2.3\');\\n  const [simHw, setSimHw] = useState<\'any\' | \'x86_64\' | \'aarch64\'>(\'any\');\\n  const [simPurl, setSimPurl] = useState(\'\');\\n  const [simVexStatus, setSimVexStatus] = useState<\'none\' | \'not_affected\' | \'affected\'>(\'none\');\\n  const [simResults, setSimResults] = useState<{\\n    testedAt: string;\\n    matchedCves: Array<{\\n      cve: NormalizedCVE;\\n      method: string;\\n      confidence: number;\\n      evidence: string;\\n      autoAction: string;\\n      suppressed: boolean;\\n      suppressionReason?: string;\\n    }>;\\n    totalScanned: number;\\n    ruleSummary: {\\n      cpeGenerated: string;\\n      aliasExpanded: boolean;\\n      intervalEvaluated: boolean;\\n      architectureFiltered: boolean;\\n    };\\n  } | null>(null);\\n\\n  const filteredAssets = watchlist.filter(item => {\\n    const matchesSearch =\\n      item.assetTag.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n      item.vendor.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n      item.product.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n      item.ownerGroup.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n      item.cpes.some(c => c.toLowerCase().includes(searchTerm.toLowerCase())) ||\\n      (item.purls && item.purls.some(p => p.toLowerCase().includes(searchTerm.toLowerCase())));\\n\\n    const matchesExposure = exposureFilter === \'ALL\' || item.exposure === exposureFilter;\\n\\n    return matchesSearch && matchesExposure;\\n  });\\n\\n  const handleVendorOrProductChange = (\\n    vendor: string,\\n    product: string,\\n    part: \'a\' | \'o\' | \'h\',\\n    version: string,\\n    targetHw: string\\n  ) => {\\n    const gen = generateCPE23(part, vendor, product, version, targetHw);\\n    setFormData(prev => ({\\n      ...prev,\\n      vendor,\\n      product,\\n      cpePart: part,\\n      version,\\n      targetHw,\\n      cpeString: gen,\\n    }));\\n  };\\n\\n  const handleOpenAdd = () => {\\n    setFormData({\\n      vendor: \'\',\\n      product: \'\',\\n      cpePart: \'a\',\\n      version: \'*\',\\n      targetHw: \'*\',\\n      purls: \'\',\\n      cpeString: \'cpe:2.3:a:vendor:product:*:*:*:*:*:*:*:*\',\\n      exposure: \'INTERNET_FACING\',\\n      assetTag: \'\',\\n      ownerGroup: \'SecOps-Perimeter\',\\n      notes: \'\',\\n    });\\n    setEditingItem(null);\\n    setShowAddModal(true);\\n  };\\n\\n  const handleOpenEdit = (item: WatchListItem) => {\\n    const parsed = parseCPE23(item.cpes[0] || \'\');\\n    setFormData({\\n      vendor: item.vendor,\\n      product: item.product,\\n      cpePart: (parsed.part === \'o\' || parsed.part === \'h\' ? parsed.part : \'a\') as \'a\' | \'o\' | \'h\',\\n      version: parsed.version || \'*\',\\n      targetHw: item.targetHw || \'*\',\\n      purls: (item.purls || []).join(\'\\\\n\'),\\n      cpeString: item.cpes.join(\'\\\\n\'),\\n      exposure: item.exposure,\\n      assetTag: item.assetTag,\\n      ownerGroup: item.ownerGroup,\\n      notes: item.notes || \'\',\\n    });\\n    setEditingItem(item);\\n    setShowAddModal(true);\\n  };\\n\\n  const handleSaveProduct = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!formData.vendor.trim() || !formData.product.trim() || !formData.assetTag.trim()) {\\n      return;\\n    }\\n\\n    const cpeList = formData.cpeString\\n      .split(\'\\\\n\')\\n      .map(s => s.trim())\\n      .filter(Boolean);\\n\\n    if (cpeList.length === 0) {\\n      cpeList.push(generateCPE23(formData.cpePart, formData.vendor, formData.product, formData.version, formData.targetHw));\\n    }\\n\\n    const purlList = formData.purls\\n      .split(\'\\\\n\')\\n      .map(s => s.trim())\\n      .filter(Boolean);\\n\\n    if (editingItem) {\\n      updateWatchlistItem({\\n        ...editingItem,\\n        vendor: formData.vendor.trim(),\\n        product: formData.product.trim(),\\n        cpes: cpeList,\\n        purls: purlList.length > 0 ? purlList : undefined,\\n        targetHw: formData.targetHw !== \'*\' ? formData.targetHw : undefined,\\n        exposure: formData.exposure,\\n        assetTag: formData.assetTag.trim(),\\n        ownerGroup: formData.ownerGroup.trim() || \'Unassigned\',\\n        notes: formData.notes.trim(),\\n      });\\n    } else {\\n      addWatchlistItem({\\n        vendor: formData.vendor.trim(),\\n        product: formData.product.trim(),\\n        cpes: cpeList,\\n        purls: purlList.length > 0 ? purlList : undefined,\\n        targetHw: formData.targetHw !== \'*\' ? formData.targetHw : undefined,\\n        exposure: formData.exposure,\\n        assetTag: formData.assetTag.trim(),\\n        ownerGroup: formData.ownerGroup.trim() || \'SecOps-Perimeter\',\\n        active: true,\\n        notes: formData.notes.trim(),\\n      });\\n    }\\n\\n    setShowAddModal(false);\\n  };\\n\\n  const handleBulkImport = () => {\\n    try {\\n      const parsed = JSON.parse(bulkJsonText);\\n      const res = bulkImportWatchlist(parsed);\\n      setBulkFeedback(res);\\n      if (res.imported > 0 && res.errors.length === 0) {\\n        setTimeout(() => {\\n          setShowBulkModal(false);\\n          setBulkJsonText(\'\');\\n          setBulkFeedback(null);\\n        }, 1200);\\n      }\\n    } catch (err: any) {\\n      setBulkFeedback({\\n        imported: 0,\\n        errors: [`JSON Parse Error: ${err.message}`],\\n      });\\n    }\\n  };\\n\\n  const handleExportJSON = () => {\\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(watchlist, null, 2));\\n    const downloadAnchor = document.createElement(\'a\');\\n    downloadAnchor.setAttribute(\'href\', dataStr);\\n    downloadAnchor.setAttribute(\'download\', `monitored-products-${new Date().toISOString().split(\'T\')[0]}.json`);\\n    document.body.appendChild(downloadAnchor);\\n    downloadAnchor.click();\\n    downloadAnchor.remove();\\n  };\\n\\n  // Run Simulator Engine\\n  const runSimulation = () => {\\n    const generatedCpe = generateCPE23(\\n      \'a\',\\n      simVendor,\\n      simProduct,\\n      simVersion || \'*\',\\n      simHw === \'any\' ? \'*\' : simHw\\n    );\\n\\n    const assetCpes = [generatedCpe];\\n    const assetPurls = simPurl ? [simPurl.trim()] : undefined;\\n\\n    const matches: Array<{\\n      cve: NormalizedCVE;\\n      method: string;\\n      confidence: number;\\n      evidence: string;\\n      autoAction: string;\\n      suppressed: boolean;\\n      suppressionReason?: string;\\n    }> = [];\\n\\n    let aliasUsed = false;\\n    let intervalUsed = false;\\n\\n    for (const cve of cveData) {\\n      const result = matchesWatchlistItem(\\n        assetCpes,\\n        simVendor,\\n        simProduct,\\n        cve.cpeMatches,\\n        cve.title,\\n        cve.description,\\n        cve.versionRange,\\n        assetPurls,\\n        cve.purls,\\n        simHw === \'any\' ? \'*\' : simHw\\n      );\\n\\n      if (result.matched) {\\n        if (result.method === \'VENDOR_PRODUCT_ALIAS\') aliasUsed = true;\\n        if (result.method === \'STRICT_CPE_INTERVAL\') intervalUsed = true;\\n\\n        const isVexSuppressed = simVexStatus === \'not_affected\' || cve.vex?.status === \'not_affected\';\\n        \\n        let autoAction = \'IMMEDIATE_NOTIFICATION (Slack + Email)\';\\n        if (isVexSuppressed) {\\n          autoAction = \'SUPPRESSED_BY_VEX (No Alert)\';\\n        } else if (cve.cvss.severity === \'LOW\' || cve.cvss.severity === \'MEDIUM\') {\\n          autoAction = \'SCHEDULED_DIGEST_BATCH\';\\n        }\\n\\n        matches.push({\\n          cve,\\n          method: result.method,\\n          confidence: result.confidence,\\n          evidence: result.evidence,\\n          autoAction,\\n          suppressed: isVexSuppressed,\\n          suppressionReason: isVexSuppressed\\n            ? \'CSAF 2.0 VEX: Vendor marked component as not_affected (vulnerable code path disabled)\'\\n            : undefined,\\n        });\\n      }\\n    }\\n\\n    setSimResults({\\n      testedAt: new Date().toLocaleTimeString(),\\n      matchedCves: matches,\\n      totalScanned: cveData.length,\\n      ruleSummary: {\\n        cpeGenerated: generatedCpe,\\n        aliasExpanded: aliasUsed,\\n        intervalEvaluated: intervalUsed,\\n        architectureFiltered: simHw !== \'any\',\\n      },\\n    });\\n  };\\n\\n  const loadPreset = (preset: \'paloalto\' | \'apache\' | \'cisco\' | \'fortinet\' | \'log4j\') => {\\n    if (preset === \'paloalto\') {\\n      setSimVendor(\'paloaltonetworks\');\\n      setSimProduct(\'pan-os\');\\n      setSimVersion(\'10.2.3\');\\n      setSimHw(\'any\');\\n      setSimPurl(\'\');\\n      setSimVexStatus(\'none\');\\n    } else if (preset === \'apache\') {\\n      setSimVendor(\'apache\');\\n      setSimProduct(\'http_server\');\\n      setSimVersion(\'2.4.49\');\\n      setSimHw(\'any\');\\n      setSimPurl(\'\');\\n      setSimVexStatus(\'none\');\\n    } else if (preset === \'cisco\') {\\n      setSimVendor(\'cisco\');\\n      setSimProduct(\'ios_xe\');\\n      setSimVersion(\'17.9.4\');\\n      setSimHw(\'any\');\\n      setSimPurl(\'\');\\n      setSimVexStatus(\'none\');\\n    } else if (preset === \'fortinet\') {\\n      setSimVendor(\'fortinet\');\\n      setSimProduct(\'fortios\');\\n      setSimVersion(\'7.2.4\');\\n      setSimHw(\'any\');\\n      setSimPurl(\'\');\\n      setSimVexStatus(\'none\');\\n    } else if (preset === \'log4j\') {\\n      setSimVendor(\'apache\');\\n      setSimProduct(\'log4j_core\');\\n      setSimVersion(\'2.14.1\');\\n      setSimHw(\'any\');\\n      setSimPurl(\'pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1\');\\n      setSimVexStatus(\'none\');\\n    }\\n  };\\n\\n  const sampleJson = [\\n    {\\n      assetTag: \\\"EXT-NGFW-01\\\",\\n      vendor: \\\"paloaltonetworks\\\",\\n      product: \\\"pan-os\\\",\\n      exposure: \\\"INTERNET_FACING\\\",\\n      cpes: [\\\"cpe:2.3:o:paloaltonetworks:pan-os:10.2:*:*:*:*:*:*:*\\\"],\\n      ownerGroup: \\\"SecOps-Network\\\",\\n      notes: \\\"Perimeter firewall with GlobalProtect\\\"\\n    },\\n    {\\n      assetTag: \\\"DC-PRIMARY-01\\\",\\n      vendor: \\\"microsoft\\\",\\n      product: \\\"windows_server_2022\\\",\\n      exposure: \\\"INTERNAL_CRITICAL\\\",\\n      cpes: [\\\"cpe:2.3:o:microsoft:windows_server_2022:*:*:*:*:*:*:*:*\\\"],\\n      ownerGroup: \\\"SysOps-Identity\\\",\\n      notes: \\\"Core domain controller\\\"\\n    }\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Top Header & Switcher */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h1 className=\\\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\\\">\\n            <Server className=\\\"w-5 h-5 text-zinc-300\\\" />\\n            Monitored Product Inventory &amp; Matching Engine\\n          </h1>\\n          <p className=\\\"text-xs text-zinc-400 mt-1\\\">\\n            Enterprise NIST CPE 2.3 strict component matching, PURL package resolution, version intervals, and alias thesaurus.\\n          </p>\\n        </div>\\n\\n        {/* View Switcher Tabs (NextUI Style) */}\\n        <div className=\\\"flex items-center space-x-1.5 bg-zinc-900 border border-zinc-800 p-1 rounded-xl\\\">\\n          <button\\n            onClick={() => setViewMode(\'inventory\')}\\n            className={`px-3 py-1.5 text-xs font-medium rounded-lg transition flex items-center space-x-1.5 ${\\n              viewMode === \'inventory\'\\n                ? \'bg-zinc-800 text-zinc-100 shadow-sm\'\\n                : \'text-zinc-400 hover:text-zinc-200\'\\n            }`}\\n          >\\n            <Server className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Monitored Products ({watchlist.length})</span>\\n          </button>\\n          <button\\n            onClick={() => {\\n              setViewMode(\'simulator\');\\n              if (!simResults) runSimulation();\\n            }}\\n            className={`px-3 py-1.5 text-xs font-medium rounded-lg transition flex items-center space-x-1.5 ${\\n              viewMode === \'simulator\'\\n                ? \'bg-zinc-800 text-zinc-100 shadow-sm\'\\n                : \'text-zinc-400 hover:text-zinc-200\'\\n            }`}\\n          >\\n            <FlaskConical className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Matching Simulator &amp; Rule Lab</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* VIEW 1: Monitored Products Inventory */}\\n      {viewMode === \'inventory\' && (\\n        <div className=\\\"space-y-4\\\">\\n          {/* Action Bar */}\\n          <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n            <div className=\\\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-3 flex-1 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm\\\">\\n              <div className=\\\"relative w-full sm:w-80\\\">\\n                <Search className=\\\"w-4 h-4 text-zinc-500 absolute left-3 top-2.5\\\" />\\n                <input\\n                  type=\\\"text\\\"\\n                  placeholder=\\\"Search products by tag, vendor, product, CPE, PURL...\\\"\\n                  value={searchTerm}\\n                  onChange={e => setSearchTerm(e.target.value)}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 transition\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center space-x-2 w-full sm:w-auto\\\">\\n                <Filter className=\\\"w-3.5 h-3.5 text-zinc-400\\\" />\\n                <span className=\\\"text-xs text-zinc-400\\\">Exposure:</span>\\n                <select\\n                  value={exposureFilter}\\n                  onChange={e => setExposureFilter(e.target.value)}\\n                  className=\\\"bg-zinc-950 border border-zinc-800 rounded-xl px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-zinc-600\\\"\\n                >\\n                  <option value=\\\"ALL\\\">All Exposures ({watchlist.length})</option>\\n                  <option value=\\\"INTERNET_FACING\\\">Internet-Facing</option>\\n                  <option value=\\\"INTERNAL_CRITICAL\\\">Internal Critical</option>\\n                  <option value=\\\"DMZ\\\">DMZ</option>\\n                  <option value=\\\"WORKSTATION\\\">Workstation</option>\\n                  <option value=\\\"CLOUD_INFRA\\\">Cloud Infra</option>\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center space-x-2 shrink-0\\\">\\n              <button\\n                onClick={() => setShowBulkModal(true)}\\n                className=\\\"text-xs px-3 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 font-medium transition flex items-center space-x-1.5\\\"\\n              >\\n                <Upload className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Bulk JSON</span>\\n              </button>\\n              <button\\n                onClick={handleExportJSON}\\n                className=\\\"text-xs px-3 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 font-medium transition flex items-center space-x-1.5\\\"\\n              >\\n                <Download className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Export</span>\\n              </button>\\n              <button\\n                onClick={handleOpenAdd}\\n                className=\\\"text-xs px-3.5 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold transition flex items-center space-x-1.5 shadow-sm\\\"\\n              >\\n                <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Register Product</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Products Table (NextUI style) */}\\n          <div className=\\\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full text-left text-xs\\\">\\n                <thead className=\\\"bg-zinc-950/80 border-b border-zinc-800/80 text-zinc-400 font-mono uppercase text-[11px]\\\">\\n                  <tr>\\n                    <th className=\\\"py-3 px-4\\\">Asset Tag / Host</th>\\n                    <th className=\\\"py-3 px-4\\\">Vendor &amp; Product</th>\\n                    <th className=\\\"py-3 px-4\\\">CPE 2.3 Expression &amp; PURL</th>\\n                    <th className=\\\"py-3 px-4\\\">Arch / Context</th>\\n                    <th className=\\\"py-3 px-4\\\">Exposure Level</th>\\n                    <th className=\\\"py-3 px-4\\\">Custodian Group</th>\\n                    <th className=\\\"py-3 px-4 text-right\\\">Actions</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-zinc-800/60\\\">\\n                  {filteredAssets.length === 0 ? (\\n                    <tr>\\n                      <td colSpan={7} className=\\\"py-8 text-center text-zinc-500 text-xs\\\">\\n                        No matching monitored products found.\\n                      </td>\\n                    </tr>\\n                  ) : (\\n                    filteredAssets.map(asset => (\\n                      <tr key={asset.id} className=\\\"hover:bg-zinc-800/30 transition\\\">\\n                        {/* Asset Tag */}\\n                        <td className=\\\"py-3 px-4 font-mono font-bold text-zinc-100\\\">\\n                          <div>{asset.assetTag}</div>\\n                          {asset.notes && (\\n                            <div className=\\\"text-[11px] text-zinc-400 font-sans font-normal mt-0.5 line-clamp-1\\\">\\n                              {asset.notes}\\n                            </div>\\n                          )}\\n                        </td>\\n\\n                        {/* Vendor & Product */}\\n                        <td className=\\\"py-3 px-4\\\">\\n                          <div className=\\\"font-medium text-zinc-200\\\">\\n                            {asset.vendor} / <span className=\\\"text-zinc-100 font-semibold\\\">{asset.product}</span>\\n                          </div>\\n                          <div className=\\\"text-[10px] text-zinc-500 font-mono mt-0.5\\\">\\n                            Created: {new Date(asset.createdAt).toLocaleDateString()}\\n                          </div>\\n                        </td>\\n\\n                        {/* CPE & PURL Expressions */}\\n                        <td className=\\\"py-3 px-4 font-mono text-[11px] max-w-xs\\\">\\n                          <div className=\\\"space-y-1\\\">\\n                            {asset.cpes.slice(0, 2).map((cpe, idx) => (\\n                              <div\\n                                key={idx}\\n                                className=\\\"bg-zinc-950/80 border border-zinc-800 px-2 py-0.5 rounded text-zinc-300 truncate\\\"\\n                                title={cpe}\\n                              >\\n                                {cpe}\\n                              </div>\\n                            ))}\\n                            {asset.purls && asset.purls.length > 0 && (\\n                              <div\\n                                className=\\\"bg-zinc-950/80 border border-zinc-700/60 px-2 py-0.5 rounded text-zinc-400 truncate\\\"\\n                                title={asset.purls.join(\', \')}\\n                              >\\n                                {asset.purls[0]}\\n                              </div>\\n                            )}\\n                          </div>\\n                        </td>\\n\\n                        {/* Arch / Context */}\\n                        <td className=\\\"py-3 px-4 font-mono text-[11px] text-zinc-400\\\">\\n                          <span className=\\\"bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded\\\">\\n                            {asset.targetHw || \'x86_64\'}\\n                          </span>\\n                        </td>\\n\\n                        {/* Exposure Level */}\\n                        <td className=\\\"py-3 px-4\\\">\\n                          <span\\n                            className={`px-2.5 py-1 rounded-full text-[10px] font-semibold border ${\\n                              asset.exposure === \'INTERNET_FACING\'\\n                                ? \'bg-zinc-800 text-zinc-200 border-zinc-600\'\\n                                : asset.exposure === \'INTERNAL_CRITICAL\'\\n                                ? \'bg-zinc-800/80 text-zinc-300 border-zinc-700\'\\n                                : \'bg-zinc-900 text-zinc-400 border-zinc-800\'\\n                            }`}\\n                          >\\n                            {asset.exposure.replace(\'_\', \' \')}\\n                          </span>\\n                        </td>\\n\\n                        {/* Custodian Group */}\\n                        <td className=\\\"py-3 px-4 text-zinc-300 font-mono text-[11px]\\\">\\n                          {asset.ownerGroup}\\n                        </td>\\n\\n                        {/* Actions */}\\n                        <td className=\\\"py-3 px-4 text-right\\\">\\n                          <div className=\\\"flex items-center justify-end space-x-2\\\">\\n                            <button\\n                              onClick={() => handleOpenEdit(asset)}\\n                              className=\\\"p-1 rounded hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 transition\\\"\\n                              title=\\\"Edit Product\\\"\\n                            >\\n                              <Edit2 className=\\\"w-3.5 h-3.5\\\" />\\n                            </button>\\n                            <button\\n                              onClick={() => {\\n                                if (confirm(`Remove monitored product ${asset.assetTag}?`)) {\\n                                  deleteWatchlistItem(asset.id);\\n                                }\\n                              }}\\n                              className=\\\"p-1 rounded hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 transition\\\"\\n                              title=\\\"Delete Product\\\"\\n                            >\\n                              <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                            </button>\\n                          </div>\\n                        </td>\\n                      </tr>\\n                    ))\\n                  )}\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* VIEW 2: Enterprise Matching Simulator & Rule Lab */}\\n      {viewMode === \'simulator\' && (\\n        <div className=\\\"space-y-6\\\">\\n          {/* Preset Buttons */}\\n          <div className=\\\"bg-zinc-900/60 border border-zinc-800 rounded-2xl p-4 shadow-sm\\\">\\n            <div className=\\\"text-xs font-mono text-zinc-400 mb-2 flex items-center gap-1.5\\\">\\n              <Sparkles className=\\\"w-3.5 h-3.5 text-zinc-300\\\" />\\n              <span>TESTING BENCH PRESETS:</span>\\n            </div>\\n            <div className=\\\"flex flex-wrap gap-2\\\">\\n              <button\\n                onClick={() => {\\n                  loadPreset(\'paloalto\');\\n                  setTimeout(runSimulation, 50);\\n                }}\\n                className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 text-xs font-medium transition\\\"\\n              >\\n                Palo Alto PAN-OS 10.2 (CVE-2024-3400)\\n              </button>\\n              <button\\n                onClick={() => {\\n                  loadPreset(\'apache\');\\n                  setTimeout(runSimulation, 50);\\n                }}\\n                className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 text-xs font-medium transition\\\"\\n              >\\n                Apache HTTP Server 2.4.49 (CVE-2021-41773)\\n              </button>\\n              <button\\n                onClick={() => {\\n                  loadPreset(\'fortinet\');\\n                  setTimeout(runSimulation, 50);\\n                }}\\n                className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 text-xs font-medium transition\\\"\\n              >\\n                Fortinet FortiOS 7.2.4 (CVE-2024-21762)\\n              </button>\\n              <button\\n                onClick={() => {\\n                  loadPreset(\'cisco\');\\n                  setTimeout(runSimulation, 50);\\n                }}\\n                className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 text-xs font-medium transition\\\"\\n              >\\n                Cisco IOS XE 17.9.4 (CVE-2023-20198)\\n              </button>\\n              <button\\n                onClick={() => {\\n                  loadPreset(\'log4j\');\\n                  setTimeout(runSimulation, 50);\\n                }}\\n                className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/60 text-xs font-medium transition\\\"\\n              >\\n                Log4j-Core PURL 2.14.1 (CVE-2021-44228)\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Playground Form */}\\n          <div className=\\\"bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 shadow-sm\\\">\\n            <h2 className=\\\"text-sm font-semibold text-zinc-100 mb-4 flex items-center gap-2\\\">\\n              <FlaskConical className=\\\"w-4 h-4 text-zinc-300\\\" />\\n              Configure Product Evaluation Criteria\\n            </h2>\\n\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Vendor / Alias</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={simVendor}\\n                  onChange={e => setSimVendor(e.target.value)}\\n                  placeholder=\\\"e.g. paloaltonetworks, msft, f5\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Product Name</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={simProduct}\\n                  onChange={e => setSimProduct(e.target.value)}\\n                  placeholder=\\\"e.g. pan-os, http_server\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Installed Version</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={simVersion}\\n                  onChange={e => setSimVersion(e.target.value)}\\n                  placeholder=\\\"e.g. 10.2.3, 2.4.49\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Target Architecture</label>\\n                <select\\n                  value={simHw}\\n                  onChange={e => setSimHw(e.target.value as any)}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                >\\n                  <option value=\\\"any\\\">Any / Wildcard (*)</option>\\n                  <option value=\\\"x86_64\\\">x86_64 (Intel/AMD)</option>\\n                  <option value=\\\"aarch64\\\">aarch64 (ARM64)</option>\\n                </select>\\n              </div>\\n\\n              <div className=\\\"md:col-span-2\\\">\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Package URL (PURL, Optional)</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={simPurl}\\n                  onChange={e => setSimPurl(e.target.value)}\\n                  placeholder=\\\"e.g. pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"md:col-span-2\\\">\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">CSAF 2.0 VEX Status</label>\\n                <select\\n                  value={simVexStatus}\\n                  onChange={e => setSimVexStatus(e.target.value as any)}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                >\\n                  <option value=\\\"none\\\">Standard Feed Statement (Default)</option>\\n                  <option value=\\\"not_affected\\\">VEX: not_affected (Suppresses Alert via Justification)</option>\\n                  <option value=\\\"affected\\\">VEX: confirmed affected</option>\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"mt-4 pt-4 border-t border-zinc-800 flex items-center justify-between\\\">\\n              <div className=\\\"text-[11px] font-mono text-zinc-400\\\">\\n                Generated Expression:{\' \'}\\n                <span className=\\\"text-zinc-200\\\">\\n                  {generateCPE23(\'a\', simVendor, simProduct, simVersion || \'*\', simHw === \'any\' ? \'*\' : simHw)}\\n                </span>\\n              </div>\\n\\n              <button\\n                onClick={runSimulation}\\n                className=\\\"px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold text-xs transition flex items-center space-x-2 shadow-sm\\\"\\n              >\\n                <Zap className=\\\"w-3.5 h-3.5 fill-current\\\" />\\n                <span>Simulate Matching Rules</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Simulation Output */}\\n          {simResults && (\\n            <div className=\\\"space-y-4\\\">\\n              {/* Summary telemetry */}\\n              <div className=\\\"grid grid-cols-2 md:grid-cols-4 gap-3\\\">\\n                <div className=\\\"bg-zinc-900/40 border border-zinc-800 rounded-2xl p-4\\\">\\n                  <div className=\\\"text-[11px] text-zinc-400 font-mono\\\">CVE Corpus Scanned</div>\\n                  <div className=\\\"text-2xl font-bold font-mono text-zinc-100 mt-1\\\">\\n                    {simResults.totalScanned}\\n                  </div>\\n                  <div className=\\\"text-[10px] text-zinc-500 mt-0.5\\\">Active normalized cache</div>\\n                </div>\\n\\n                <div className=\\\"bg-zinc-900/40 border border-zinc-800 rounded-2xl p-4\\\">\\n                  <div className=\\\"text-[11px] text-zinc-400 font-mono\\\">Matched Impacts</div>\\n                  <div className=\\\"text-2xl font-bold font-mono text-zinc-100 mt-1\\\">\\n                    {simResults.matchedCves.length}\\n                  </div>\\n                  <div className=\\\"text-[10px] text-zinc-500 mt-0.5\\\">Correlated vulnerabilities</div>\\n                </div>\\n\\n                <div className=\\\"bg-zinc-900/40 border border-zinc-800 rounded-2xl p-4\\\">\\n                  <div className=\\\"text-[11px] text-zinc-400 font-mono\\\">Alias Resolution</div>\\n                  <div className=\\\"text-sm font-semibold font-mono text-zinc-200 mt-2\\\">\\n                    {simResults.ruleSummary.aliasExpanded ? \'Expanded & Matched\' : \'Standard\'}\\n                  </div>\\n                  <div className=\\\"text-[10px] text-zinc-500 mt-0.5\\\">Thesaurus dictionary</div>\\n                </div>\\n\\n                <div className=\\\"bg-zinc-900/40 border border-zinc-800 rounded-2xl p-4\\\">\\n                  <div className=\\\"text-[11px] text-zinc-400 font-mono\\\">Zero-Human Action</div>\\n                  <div className=\\\"text-sm font-semibold font-mono text-zinc-200 mt-2\\\">\\n                    {simResults.matchedCves.length > 0 ? \'Direct Auto-Dispatch\' : \'Clean / No Action\'}\\n                  </div>\\n                  <div className=\\\"text-[10px] text-zinc-500 mt-0.5\\\">0 human approvals required</div>\\n                </div>\\n              </div>\\n\\n              {/* Matched CVE List with Evidence Trace */}\\n              <div className=\\\"bg-zinc-900/50 border border-zinc-800 rounded-2xl overflow-hidden shadow-sm\\\">\\n                <div className=\\\"p-4 bg-zinc-950/60 border-b border-zinc-800 flex items-center justify-between\\\">\\n                  <span className=\\\"text-xs font-semibold text-zinc-200\\\">\\n                    Simulation Match Results ({simResults.matchedCves.length})\\n                  </span>\\n                  <span className=\\\"text-[11px] font-mono text-zinc-400\\\">\\n                    Evaluated at {simResults.testedAt}\\n                  </span>\\n                </div>\\n\\n                {simResults.matchedCves.length === 0 ? (\\n                  <div className=\\\"p-8 text-center text-zinc-500 text-xs\\\">\\n                    No CVEs matched this product profile. System clean.\\n                  </div>\\n                ) : (\\n                  <div className=\\\"divide-y divide-zinc-800/60\\\">\\n                    {simResults.matchedCves.map((match, i) => (\\n                      <div key={i} className=\\\"p-4 hover:bg-zinc-800/20 transition\\\">\\n                        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\\\">\\n                          <div className=\\\"flex items-center space-x-2.5\\\">\\n                            <span className=\\\"text-xs font-mono font-bold text-zinc-100\\\">\\n                              {match.cve.cveId}\\n                            </span>\\n                            <span\\n                              className={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${\\n                                match.cve.cvss.severity === \'CRITICAL\'\\n                                  ? \'bg-zinc-800 text-zinc-100 border-zinc-600\'\\n                                  : \'bg-zinc-900 text-zinc-300 border-zinc-700\'\\n                              }`}\\n                            >\\n                              CVSS {match.cve.cvss.score} \342\200\242 {match.cve.cvss.severity}\\n                            </span>\\n                            {match.cve.cisaKev.isKev && (\\n                              <span className=\\\"text-[10px] font-semibold bg-zinc-800 text-zinc-200 border border-zinc-600 px-2 py-0.5 rounded-full\\\">\\n                                CISA KEV\\n                              </span>\\n                            )}\\n                            <span className=\\\"text-[10px] font-mono bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded text-zinc-400\\\">\\n                              {match.confidence}% Confidence\\n                            </span>\\n                          </div>\\n\\n                          <div className=\\\"text-[11px] font-mono text-zinc-400\\\">\\n                            Auto Route:{\' \'}\\n                            <strong className=\\\"text-zinc-200\\\">{match.autoAction}</strong>\\n                          </div>\\n                        </div>\\n\\n                        <div className=\\\"text-xs font-semibold text-zinc-300 mt-2\\\">\\n                          {match.cve.title}\\n                        </div>\\n\\n                        {/* Evidence Trace Breakdown */}\\n                        <div className=\\\"mt-2.5 bg-zinc-950/80 border border-zinc-800 rounded-xl p-3 font-mono text-[11px] text-zinc-400 space-y-1\\\">\\n                          <div className=\\\"text-zinc-300 font-semibold flex items-center gap-1.5\\\">\\n                            <CheckCircle2 className=\\\"w-3.5 h-3.5 text-zinc-400\\\" />\\n                            <span>Match Method: {match.method}</span>\\n                          </div>\\n                          <div>Evidence: {match.evidence}</div>\\n                          {match.suppressed && (\\n                            <div className=\\\"text-amber-400/90 pt-1 border-t border-zinc-800\\\">\\n                              [VEX SUPPRESSION] {match.suppressionReason}\\n                            </div>\\n                          )}\\n                        </div>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </div>\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {/* Add / Edit Product Modal */}\\n      {showAddModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\\\">\\n          <div className=\\\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-xl w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto\\\">\\n            <button\\n              onClick={() => setShowAddModal(false)}\\n              className=\\\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <h2 className=\\\"text-base font-bold text-zinc-100 mb-1 flex items-center gap-2\\\">\\n              <Server className=\\\"w-4 h-4 text-zinc-300\\\" />\\n              {editingItem ? \'Edit Monitored Product\' : \'Register Monitored Product\'}\\n            </h2>\\n            <p className=\\\"text-xs text-zinc-400 mb-4\\\">\\n              Configure product identity, strict CPE 2.3 expressions, and PURLs for continuous automated tracking.\\n            </p>\\n\\n            <form onSubmit={handleSaveProduct} className=\\\"space-y-4 text-xs\\\">\\n              <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Asset Tag / Hostname *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    placeholder=\\\"e.g. EXT-NGFW-01\\\"\\n                    value={formData.assetTag}\\n                    onChange={e => setFormData({ ...formData, assetTag: e.target.value })}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Custodian Group *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    placeholder=\\\"e.g. SecOps-Perimeter\\\"\\n                    value={formData.ownerGroup}\\n                    onChange={e => setFormData({ ...formData, ownerGroup: e.target.value })}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Vendor *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    placeholder=\\\"e.g. paloaltonetworks\\\"\\n                    value={formData.vendor}\\n                    onChange={e => {\\n                      const v = e.target.value;\\n                      handleVendorOrProductChange(v, formData.product, formData.cpePart, formData.version, formData.targetHw);\\n                    }}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Product *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    placeholder=\\\"e.g. pan-os\\\"\\n                    value={formData.product}\\n                    onChange={e => {\\n                      const p = e.target.value;\\n                      handleVendorOrProductChange(formData.vendor, p, formData.cpePart, formData.version, formData.targetHw);\\n                    }}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-3 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">CPE Part</label>\\n                  <select\\n                    value={formData.cpePart}\\n                    onChange={e => {\\n                      const part = e.target.value as \'a\' | \'o\' | \'h\';\\n                      handleVendorOrProductChange(formData.vendor, formData.product, part, formData.version, formData.targetHw);\\n                    }}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  >\\n                    <option value=\\\"a\\\">Application (a)</option>\\n                    <option value=\\\"o\\\">Operating System (o)</option>\\n                    <option value=\\\"h\\\">Hardware (h)</option>\\n                  </select>\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Version</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    placeholder=\\\"* or exact e.g. 10.2.3\\\"\\n                    value={formData.version}\\n                    onChange={e => {\\n                      const ver = e.target.value;\\n                      handleVendorOrProductChange(formData.vendor, formData.product, formData.cpePart, ver, formData.targetHw);\\n                    }}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Target Arch</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    placeholder=\\\"* or x86_64\\\"\\n                    value={formData.targetHw}\\n                    onChange={e => {\\n                      const hw = e.target.value;\\n                      handleVendorOrProductChange(formData.vendor, formData.product, formData.cpePart, formData.version, hw);\\n                    }}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Exposure Level</label>\\n                <select\\n                  value={formData.exposure}\\n                  onChange={e => setFormData({ ...formData, exposure: e.target.value as ExposureLevel })}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                >\\n                  <option value=\\\"INTERNET_FACING\\\">Internet Facing (High Priority Alerting)</option>\\n                  <option value=\\\"INTERNAL_CRITICAL\\\">Internal Critical Infrastructure</option>\\n                  <option value=\\\"DMZ\\\">Demilitarized Zone (DMZ)</option>\\n                  <option value=\\\"WORKSTATION\\\">Developer / Employee Workstation</option>\\n                  <option value=\\\"CLOUD_INFRA\\\">Cloud Infrastructure / VPC</option>\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">\\n                  Strict CPE 2.3 Expressions (One per line)\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  value={formData.cpeString}\\n                  onChange={e => setFormData({ ...formData, cpeString: e.target.value })}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 font-mono text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">\\n                  Package URLs (PURL, Optional - One per line)\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  placeholder=\\\"e.g. pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1\\\"\\n                  value={formData.purls}\\n                  onChange={e => setFormData({ ...formData, purls: e.target.value })}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 font-mono text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Operational Notes</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  placeholder=\\\"e.g. Enterprise SSL-VPN concentrator\\\"\\n                  value={formData.notes}\\n                  onChange={e => setFormData({ ...formData, notes: e.target.value })}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex justify-end space-x-2 pt-3 border-t border-zinc-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddModal(false)}\\n                  className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold\\\"\\n                >\\n                  {editingItem ? \'Save Changes\' : \'Register Product\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Bulk JSON Import Modal */}\\n      {showBulkModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\\\">\\n          <div className=\\\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl relative\\\">\\n            <button\\n              onClick={() => {\\n                setShowBulkModal(false);\\n                setBulkFeedback(null);\\n              }}\\n              className=\\\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <h2 className=\\\"text-base font-bold text-zinc-100 mb-1 flex items-center gap-2\\\">\\n              <Upload className=\\\"w-4 h-4 text-zinc-300\\\" />\\n              Bulk Product Asset Import (JSON)\\n            </h2>\\n            <p className=\\\"text-xs text-zinc-400 mb-4\\\">\\n              Import up to 1,000 product records. Provide vendor, product, assetTag, exposure, and optional CPE 2.3 expressions.\\n            </p>\\n\\n            <div className=\\\"mb-2 flex justify-end\\\">\\n              <button\\n                onClick={() => setBulkJsonText(JSON.stringify(sampleJson, null, 2))}\\n                className=\\\"text-[11px] text-zinc-400 hover:text-zinc-200 underline font-mono flex items-center gap-1\\\"\\n              >\\n                <Code className=\\\"w-3 h-3\\\" />\\n                Load Sample JSON\\n              </button>\\n            </div>\\n\\n            <textarea\\n              rows={9}\\n              placeholder=\\\"Paste JSON array here...\\\"\\n              value={bulkJsonText}\\n              onChange={e => setBulkJsonText(e.target.value)}\\n              className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-3 font-mono text-xs text-zinc-200 focus:outline-none focus:border-zinc-600\\\"\\n            />\\n\\n            {bulkFeedback && (\\n              <div\\n                className={`mt-3 p-3 rounded-xl text-xs ${\\n                  bulkFeedback.errors.length > 0\\n                    ? \'bg-zinc-950 border border-zinc-700 text-zinc-300\'\\n                    : \'bg-zinc-950 border border-emerald-800 text-emerald-300\'\\n                }`}\\n              >\\n                <div className=\\\"font-bold\\\">\\n                  {bulkFeedback.imported > 0\\n                    ? `Imported ${bulkFeedback.imported} products.`\\n                    : \'Import Failed\'}\\n                </div>\\n                {bulkFeedback.errors.map((err, i) => (\\n                  <div key={i} className=\\\"text-[11px] text-zinc-400 mt-1\\\">\\n                    \342\200\242 {err}\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n\\n            <div className=\\\"flex justify-end space-x-2 mt-4 pt-3 border-t border-zinc-800\\\">\\n              <button\\n                onClick={() => setShowBulkModal(false)}\\n                className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                onClick={handleBulkImport}\\n                disabled={!bulkJsonText.trim()}\\n                className=\\\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold text-xs disabled:opacity-50\\\"\\n              >\\n                Ingest Product Records\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\",\"Description\":\"Enhanced WatchListView with matching simulator lab, presets, and PURL support\",\"Overwrite\":true,\"TargetFile\":\"/src/components/WatchListView.tsx\",\"toolAction\":\"Writing WatchListView.tsx\",\"toolSummary\":\"Update WatchListView with simulator\"}"
      thought_signature: ""
      original_name: "write_to_file"
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "OBfXavnOIqel1MkPrNOl-QI"
  }
