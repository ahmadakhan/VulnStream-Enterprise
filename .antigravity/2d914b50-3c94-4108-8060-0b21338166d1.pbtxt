  view_file {
    absolute_path_uri: "file:///src/components/ThreatDataView.tsx"
    end_line: 119
    content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { NormalizedCVE } from \'../types\';\nimport {\n  Database,\n  Search,\n  Flame,\n  FileJson,\n  X,\n  Copy,\n  Check,\n} from \'lucide-react\';\n\nexport const ThreatDataView: React.FC = () => {\n  const { cveData } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [kevFilter, setKevFilter] = useState<\'ALL\' | \'KEV_ONLY\'>(\'ALL\');\n  const [epssFilter, setEpssFilter] = useState<\'ALL\' | \'HIGH_EPSS\'>(\'ALL\');\n  const [inspectCve, setInspectCve] = useState<NormalizedCVE | null>(null);\n  const [copied, setCopied] = useState(false);\n\n  const filteredCves = cveData.filter(cve => {\n    const matchesSearch =\n      cve.cveId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      cve.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      cve.sourceFeeds.some(s => s.toLowerCase().includes(searchTerm.toLowerCase())) ||\n      cve.cpeMatches.some(c => c.toLowerCase().includes(searchTerm.toLowerCase()));\n\n    const matchesKev = kevFilter === \'ALL\' || cve.cisaKev.isKev;\n    const matchesEpss = epssFilter === \'ALL\' || cve.epss.score >= 0.40;\n\n    return matchesSearch && matchesKev && matchesEpss;\n  });\n\n  const handleCopyJson = () => {\n    if (inspectCve) {\n      navigator.clipboard.writeText(JSON.stringify(inspectCve, null, 2));\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\">\n            <Database className=\"w-5 h-5 text-zinc-300\" />\n            Threat Intelligence Feed Cache\n          </h1>\n          <p className=\"text-xs text-zinc-400 mt-1\">\n            Normalized CVE cache unified from NVD CVSS, FIRST.org EPSS scores, CISA KEV catalogs, and vendor threat streams.\n          </p>\n        </div>\n      </div>\n\n      {/* Filter Bar */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-sm\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search normalized cache by CVE, title, or CPE...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 transition\"\n          />\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          {/* CISA KEV Filter */}\n          <button\n            onClick={() => setKevFilter(k => (k === \'ALL\' ? \'KEV_ONLY\' : \'ALL\'))}\n            className={`px-3 py-1.5 rounded-xl text-xs font-medium flex items-center space-x-1.5 transition border ${\n              kevFilter === \'KEV_ONLY\'\n                ? \'bg-zinc-800 text-zinc-100 border-zinc-600\'\n                : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            <Flame className=\"w-3.5 h-3.5 text-amber-500/80\" />\n            <span>CISA KEV Only</span>\n          </button>\n\n          {/* EPSS Filter */}\n          <button\n            onClick={() => setEpssFilter(e => (e === \'ALL\' ? \'HIGH_EPSS\' : \'ALL\'))}\n            className={`px-3 py-1.5 rounded-xl text-xs font-medium flex items-center space-x-1.5 transition border ${\n              epssFilter === \'HIGH_EPSS\'\n                ? \'bg-zinc-800 text-zinc-100 border-zinc-600\'\n                : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-zinc-200\'\n            }`}\n          >\n            <span>EPSS &gt; 0.40</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-zinc-950/80 border-b border-zinc-800/80 text-zinc-400 font-mono uppercase text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Canonical CVE</th>\n                <th className=\"py-3 px-4\">CVSS Score</th>\n                <th className=\"py-3 px-4\">EPSS Percentile</th>\n                <th className=\"py-3 px-4\">Exploit Status</th>\n                <th className=\"py-3 px-4\">Sources Ingested</th>\n                <th className=\"py-3 px-4 text-right\">Inspect</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-zinc-800/60\">\n              {filteredCves.map(cve => (\n                <tr key={cve.cveId} className=\"hover:bg-zinc-800/30 transition\">\n                  {/* Canonical CVE */}\n                  <td className=\"py-3 px-4\">\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-mono font-bold text-zinc-100 text-sm\">{cve.cveId}</span>\n                      {cve.cisaKev.isKev && ("
