              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                              <span"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                className={`text-[10px] font-mono font-bold px-1.5 py-0.5 rounded ${"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                  finding.priorityTier === \'P0_CISA_KEV\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                    ? \'bg-red-950 text-red-300 border border-red-800\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                    : finding.priorityTier === \'P1_CRITICAL\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                    ? \'bg-rose-950 text-rose-300 border border-rose-800\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                    : \'bg-amber-950 text-amber-300 border border-amber-800\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                }`}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
