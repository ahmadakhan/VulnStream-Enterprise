  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Shield,\n  Flame,\n  Radio,\n  FileText,\n  Server,\n  ArrowUpRight,\n  TrendingUp,\n  CheckCircle2,\n  ExternalLink,\n  Zap,\n  Cpu,\n  MailCheck,\n  Send,\n} from \'lucide-react\';\nimport { Finding } from \'../types\';\n\nexport const DashboardView: React.FC = () => {\n  const {\n    findings,\n    watchlist,\n    feeds,\n    advisories,\n    setActiveTab,\n    setSelectedFinding,\n    triggerPipelineRun,\n    isPipelineRunning,\n    emailLogs,\n  } = useApp();\n\n  const activeVulnerabilities = findings.filter(f => f.status !== \'RESOLVED\' && f.status !== \'FALSE_POSITIVE\');\n  const kevFindings = findings.filter(f => f.cve.cisaKev.isKev);\n  const criticalFindings = findings.filter(f => f.cve.cvss.severity === \'CRITICAL\');\n  const deliveredEmails = emailLogs.filter(e => e.status === \'DELIVERED\').length;\n\n  const internetFacingCount = watchlist.filter(w => w.exposure === \'INTERNET_FACING\').length;\n  const internalCriticalCount = watchlist.filter(w => w.exposure === \'INTERNAL_CRITICAL\').length;\n  const dmzCount = watchlist.filter(w => w.exposure === \'DMZ\').length;\n  const otherCount = watchlist.length - internetFacingCount - internalCriticalCount - dmzCount;\n\n  const handleSelectFinding = (finding: Finding) => {\n    setSelectedFinding(finding);\n    setActiveTab(\'findings\');\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Hero Card */}\n      <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 shadow-sm relative overflow-hidden\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2 text-xs font-mono text-zinc-400 mb-1\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n              <span>AUTONOMOUS ENGINE ACTIVE \342\200\242 ZERO-TOUCH NOTIFICATION</span>\n            </div>\n            <h1 className=\"text-xl font-bold tracking-tight text-zinc-100\">\n              Product Vulnerability Tracking &amp; Notification System\n            </h1>\n            <p className=\"text-xs text-zinc-400 max-w-2xl mt-1 leading-relaxed\">\n              Continuously ingests multi-source feeds (NVD, CISA KEV, GHSA, EPSS), matches monitored product inventory using strict CPE 2.3 identifiers, and automatically dispatches security notifications with zero human intervention.\n            </p>\n          </div>\n          <div className=\"flex items-center space-x-2.5 shrink-0\">\n            <button\n              onClick={() => setActiveTab(\'watchlist\')}\n              className=\"text-xs px-3.5 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 text-zinc-200 border border-zinc-700/50 font-medium transition\"\n            >\n              Monitored Products ({watchlist.length})\n            </button>\n            <button\n              onClick={() => triggerPipelineRun()}\n              disabled={isPipelineRunning}\n              className=\"text-xs px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold transition flex items-center space-x-2\"\n            >\n              <Zap className=\"w-3.5 h-3.5 fill-current\" />\n              <span>Trigger Ingestion</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* KPI Stats Cards (NextUI Style) */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">\n        {/* Monitored Products */}\n        <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 hover:border-zinc-700 transition\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs mb-1.5\">\n            <span>Products</span>\n            <Server className=\"w-3.5 h-3.5 text-zinc-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-zinc-100 font-mono\">{watchlist.length}</div>\n          <div className=\"text-[11px] text-zinc-500 mt-1\">\n            {internetFacingCount} Internet-Facing\n          </div>\n        </div>\n\n        {/* Active Vulnerabilities */}\n        <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 hover:border-zinc-700 transition\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs mb-1.5\">\n            <span>Vulnerabilities</span>\n            <Shield className=\"w-3.5 h-3.5 text-zinc-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-zinc-100 font-mono\">{activeVulnerabilities.length}</div>\n          <div className=\"text-[11px] text-zinc-500 mt-1\">\n            {criticalFindings.length} Critical Impact\n          </div>\n        </div>\n\n        {/* CISA KEV In Wild */}\n        <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 hover:border-zinc-700 transition\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs mb-1.5\">\n            <span>CISA KEV</span>\n            <Flame className=\"w-3.5 h-3.5 text-amber-500/80\" />\n          </div>\n          <div className=\"text-2xl font-bold text-zinc-100 font-mono\">{kevFindings.length}</div>\n          <div className=\"text-[11px] text-amber-500/80 mt-1 font-medium\">\n            Active in Wild\n          </div>\n        </div>\n\n        {/* Automated Notifications */}\n        <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 hover:border-zinc-700 transition\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs mb-1.5\">\n            <span>Auto-Dispatched</span>\n            <MailCheck className=\"w-3.5 h-3.5 text-emerald-500/80\" />\n          </div>\n          <div className=\"text-2xl font-bold text-zinc-100 font-mono\">{deliveredEmails}</div>\n          <div className=\"text-[11px] text-zinc-500 mt-1\">\n            Zero Human Touch\n          </div>\n        </div>\n\n        {/* Threat Feeds */}\n        <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 hover:border-zinc-700 transition\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs mb-1.5\">\n            <span>Threat Feeds</span>\n            <Radio className=\"w-3.5 h-3.5 text-zinc-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-zinc-100 font-mono\">\n            {feeds.filter(f => f.enabled).length}/{feeds.length}\n          </div>\n          <div className=\"text-[11px] text-zinc-500 mt-1\">\n            SSRF Guard Active\n          </div>\n        </div>\n\n        {/* Generated Advisories */}\n        <div className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 hover:border-zinc-700 transition\">\n          <div className=\"flex items-center justify-between text-zinc-400 text-xs mb-1.5\">\n            <span>Advisories</span>\n            <FileText className=\"w-3.5 h-3.5 text-zinc-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-zinc-100 font-mono\">{advisories.length}</div>\n          <div className=\"text-[11px] text-zinc-500 mt-1\">\n            Generated &amp; Logged\n          </div>\n        </div>\n      </div>\n\n      {/* Two Column Section: Correlated Vulnerabilities + Product Exposure Breakdown */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Monitored Product Vulnerabilities (2 cols) */}\n        <div className=\"lg:col-span-2 bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-5 shadow-sm\">\n          <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-zinc-800/80\">\n            <div className=\"flex items-center space-x-2\">\n              <Shield className=\"w-4 h-4 text-zinc-300\" />\n              <h2 className=\"text-xs font-semibold text-zinc-200 uppercase tracking-wider\">\n                Correlated Product Vulnerabilities\n              </h2>\n            </div>\n            <button\n              onClick={() => setActiveTab(\'findings\')}\n              className=\"text-xs text-zinc-400 hover:text-zinc-200 font-medium flex items-center space-x-1\"\n            >\n              <span>View All Vulnerabilities</span>\n              <ArrowUpRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-2.5\">\n            {findings.slice(0, 4).map(finding => {\n              const isKev = finding.cve.cisaKev.isKev;\n\n              return (\n                <div\n                  key={finding.id}\n                  onClick={() => handleSelectFinding(finding)}\n                  className=\"p-3.5 rounded-xl border border-zinc-800/70 bg-zinc-950/40 hover:bg-zinc-900/60 hover:border-zinc-700 transition cursor-pointer flex flex-col sm:flex-row sm:items-center justify-between gap-3\"\n                >\n                  <div className=\"space-y-1\">\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-mono font-bold text-sm text-zinc-100\">\n                        {finding.cveId}\n                      </span>\n                      {isKev && (\n                        <span className=\"text-[10px] font-medium bg-zinc-800 text-zinc-300 border border-zinc-700 px-2 py-0.5 rounded-full flex items-center gap-1\">\n                          <Flame className=\"w-3 h-3 text-amber-500\" />\n                          CISA KEV\n                        </span>\n                      )}\n                      <span className=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-800/80 text-zinc-300 border border-zinc-700/60\">\n                        CVSS {finding.cve.cvss.score.toFixed(1)} ({finding.cve.cvss.severity})\n                      </span>\n                    </div>\n                    <div className=\"text-xs text-zinc-300 line-clamp-1\">\n                      {finding.cve.title}\n                    </div>\n                    <div className=\"text-[11px] text-zinc-400 font-mono flex items-center gap-2\">\n                      <span>Product: <strong className=\"text-zinc-200\">{finding.matchedAssetName}</strong></span>\n                      <span>\342\200\242</span>\n                      <span>Exposure: <span className=\"text-zinc-300\">{finding.exposure.replace(\'_\', \' \')}</span></span>\n                    </div>\n                  </div>\n\n                  <div className=\"sm:text-right shrink-0\">\n                    <span className=\"inline-flex items-center gap-1 text-[11px] font-medium px-2 py-0.5 rounded-full bg-zinc-800/80 text-zinc-300 border border-zinc-700/60\">\n                      <Send className=\"w-3 h-3 text-emerald-400\" />\n                      <span>{finding.notificationStatus.replace(/_/g, \' \')}</span>\n                    </span>\n                    <div className=\"text-[10px] text-zinc-500 font-mono mt-1\">\n                      Auto-Dispatched on Detection\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Monitored Products by Exposure Level (1 col) */}\n        <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-5 shadow-sm flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center space-x-2 mb-4 pb-3 border-b border-zinc-800/80\">\n              <Server className=\"w-4 h-4 text-zinc-300\" />\n              <h2 className=\"text-xs font-semibold text-zinc-200 uppercase tracking-wider\">\n                Product Inventory Exposure\n              </h2>\n            </div>\n\n            <div className=\"space-y-3.5\">\n              {/* Internet-Facing */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    Internet-Facing (Perimeter)\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{internetFacingCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-300 h-1.5 rounded-full\"\n                    style={{ width: `${(internetFacingCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n\n              {/* Internal Critical */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    Internal Critical (Core Infrastructure)\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{internalCriticalCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-400 h-1.5 rounded-full\"\n                    style={{ width: `${(internalCriticalCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n\n              {/* DMZ */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    DMZ Inspection Zones\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{dmzCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-500 h-1.5 rounded-full\"\n                    style={{ width: `${(dmzCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n\n              {/* Workstations / Cloud */}\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <span className=\"text-zinc-300 font-medium flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-zinc-400\" />\n                    Workstations &amp; Cloud Infra\n                  </span>\n                  <span className=\"font-mono text-zinc-200 font-bold\">{otherCount}</span>\n                </div>\n                <div className=\"w-full bg-zinc-800/70 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-zinc-600 h-1.5 rounded-full\"\n                    style={{ width: `${(otherCount / (watchlist.length || 1)) * 100}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-5 pt-4 border-t border-zinc-800/80\">\n            <button\n              onClick={() => setActiveTab(\'watchlist\')}\n              className=\"w-full text-xs py-2 bg-zinc-800/70 hover:bg-zinc-700/70 text-zinc-200 rounded-xl font-medium border border-zinc-700/40 transition text-center\"\n            >\n              Configure Monitored Products \342\206\222\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Autonomous Pipeline Steps */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-5 shadow-sm\">\n        <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-zinc-800/80\">\n          <div className=\"flex items-center space-x-2\">\n            <Cpu className=\"w-4 h-4 text-zinc-300\" />\n            <h2 className=\"text-xs font-semibold text-zinc-200 uppercase tracking-wider\">\n              Autonomous Pipeline Architecture (No Human Intervention)\n            </h2>\n          </div>\n          <span className=\"text-[11px] font-mono text-zinc-400\">\n            Interval: 60m \342\200\242 Auto-Dispatch: Enabled\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-3\">\n          {[\n            { phase: \'1. Feed Ingestion & SSRF\', desc: \'19 Vendor Feeds, STIX/TAXII, RSS & NVD\' },\n            { phase: \'2. Deduplication\', desc: \'Canonical CVE IDs, O(1) set check\' },\n            { phase: \'3. Auto-Enrichment\', desc: \'NVD CVSS v3.1, EPSS percentile, CISA KEV\' },\n            { phase: \'4. Product CPE Match\', desc: \'Strict component matching + fallback\' },\n            { phase: \'5. Instant Auto-Dispatch\', desc: \'Direct Mailgun / SMTP distribution without human gate\' },\n          ].map((step, idx) => (\n            <div key={idx} className=\"bg-zinc-950/60 border border-zinc-800/70 rounded-xl p-3 relative\">\n              <div className=\"text-[10px] font-mono text-zinc-400 flex items-center justify-between\">\n                <span>PHASE {idx + 1}</span>\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-zinc-400\" />\n              </div>\n              <div className=\"font-semibold text-xs text-zinc-200 mt-1\">{step.phase}</div>\n              <div className=\"text-[11px] text-zinc-400 mt-1\">{step.desc}</div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
