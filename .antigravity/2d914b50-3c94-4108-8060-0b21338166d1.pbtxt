    content: "  executions: PipelineExecution[];\n  isPipelineRunning: boolean;\n  currentPipelinePhase: string | null;\n  triggerPipelineRun: (scopeHoursOverride?: number) => Promise<PipelineExecution>;\n  latestExecution: PipelineExecution | null;\n\n  // Email & Recipients\n  recipients: EmailRecipient[];\n  addRecipient: (rec: Omit<EmailRecipient, \'id\' | \'deliverySuccessRate\'>) => boolean;\n  toggleRecipientEnabled: (id: string) => void;\n  deleteRecipient: (id: string) => void;\n  emailLogs: EmailDeliveryLog[];\n  retryEmailDelivery: (logId: string) => void;\n\n  // Advisory Template\n  advisoryTemplate: string;\n  setAdvisoryTemplate: (template: string) => void;\n  sendTestEmail: (recipientEmail: string) => { success: boolean; message: string };\n\n  // Settings & NTP\n  settings: AppSettings;\n  updateSettings: (newSettings: Partial<AppSettings>) => void;\n  ntpSyncStatus: { synchronized: boolean; driftMs: number; lastChecked: string };\n\n  // Audit Logs\n  auditLogs: AuditLog[];\n  addAuditLog: (category: AuditLog[\'category\'], level: AuditLog[\'level\'], event: string, details: string) => void;\n\n  // Security & Session\n  csrfToken: string;\n  sessionTimeRemainingSec: number;\n  resetSessionTimeout: () => void;\n}\n\nconst AppContext = createContext<AppContextType | undefined>(undefined);\n\nexport const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [activeTab, setActiveTab] = useState<string>(\'dashboard\');\n\n  const [feeds, setFeeds] = useState<ThreatFeed[]>(INITIAL_FEEDS);\n  const [watchlist, setWatchlist] = useState<WatchListItem[]>(INITIAL_WATCHLIST);\n  const [cveData, setCveData] = useState<NormalizedCVE[]>(INITIAL_NORMALIZED_CVES);\n  const [findings, setFindings] = useState<Finding[]>(INITIAL_FINDINGS);\n  const [advisories, setAdvisories] = useState<Advisory[]>(INITIAL_ADVISORIES);\n  const [alertedCves, setAlertedCves] = useState<AlertedCVE[]>(INITIAL_ALERTED_CVES);\n  const [recipients, setRecipients] = useState<EmailRecipient[]>(INITIAL_RECIPIENTS);\n  const [emailLogs, setEmailLogs] = useState<EmailDeliveryLog[]>(INITIAL_EMAIL_LOGS);\n  const [auditLogs, setAuditLogs] = useState<AuditLog[]>(INITIAL_AUDIT_LOGS);\n  const [settings, setSettings] = useState<AppSettings>(INITIAL_SETTINGS);\n  const [advisoryTemplate, setAdvisoryTemplate] = useState<string>(INITIAL_ADVISORY_TEMPLATE);\n\n  const [selectedFinding, setSelectedFinding] = useState<Finding | null>(null);\n  const [selectedAdvisory, setSelectedAdvisory] = useState<Advisory | null>(null);\n\n  const [executions, setExecutions] = useState<PipelineExecution[]>([]);\n  const [isPipelineRunning, setIsPipelineRunning] = useState<boolean>(false);\n  const [currentPipelinePhase, setCurrentPipelinePhase] = useState<string | null>(null);\n\n  const [csrfToken] = useState<string>(() => \'csrf_\' + Math.random().toString(36).substring(2) + Date.now().toString(36));\n  const [sessionTimeRemainingSec, setSessionTimeRemainingSec] = useState<number>(1800);\n  const [ntpSyncStatus] = useState({\n    synchronized: true,\n    driftMs: 12,\n    lastChecked: new Date().toISOString(),\n  });\n\n  // Session Timeout countdown\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSessionTimeRemainingSec(prev => (prev > 0 ? prev - 1 : 1800));\n    }, 1000);"
