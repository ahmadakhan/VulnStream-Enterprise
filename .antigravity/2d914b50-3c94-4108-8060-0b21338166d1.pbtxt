  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { Finding, PriorityTier, FindingStatus, ExposureLevel } from \'../types\';\nimport {\n  ShieldAlert,\n  Flame,\n  AlertTriangle,\n  Clock,\n  CheckCircle2,\n  ExternalLink,\n  ChevronRight,\n  Filter,\n  Search,\n  UserCheck,\n  RotateCcw,\n  Terminal,\n  FileCheck,\n  AlertOctagon,\n  Copy,\n  Check,\n  X,\n  ArrowUpRight,\n} from \'lucide-react\';\n\nexport const FindingsView: React.FC = () => {\n  const {\n    findings,\n    selectedFinding,\n    setSelectedFinding,\n    updateFindingStatus,\n    assignFinding,\n    reAlertCve,\n  } = useApp();\n\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [severityFilter, setSeverityFilter] = useState(\'ALL\');\n  const [slaFilter, setSlaFilter] = useState(\'ALL\');\n  const [exposureFilter, setExposureFilter] = useState(\'ALL\');\n  const [copiedCmd, setCopiedCmd] = useState<string | null>(null);\n\n  // Status transition note modal\n  const [statusModalOpen, setStatusModalOpen] = useState(false);\n  const [targetStatus, setTargetStatus] = useState<FindingStatus>(\'INVESTIGATING\');\n  const [statusNote, setStatusNote] = useState(\'\');\n\n  // Re-alert modal\n  const [reAlertModalOpen, setReAlertModalOpen] = useState(false);\n  const [reAlertReason, setReAlertReason] = useState(\'\');\n\n  // Live timer tick\n  const [, setTick] = useState(0);\n  useEffect(() => {\n    const timer = setInterval(() => setTick(t => t + 1), 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const formatCountdown = (deadlineIso: string, isBreached: boolean) => {\n    const diff = new Date(deadlineIso).getTime() - Date.now();\n    if (diff <= 0 || isBreached) {\n      const overdueMins = Math.abs(Math.floor(diff / 60000));\n      const overdueHours = Math.floor(overdueMins / 60);\n      return {\n        text: `BREACHED (-${overdueHours}h ${overdueMins % 60}m)`,\n        isBreached: true,\n      };\n    }\n    const mins = Math.floor(diff / 60000);\n    const hours = Math.floor(mins / 60);\n    const secs = Math.floor((diff % 60000) / 1000);\n    return {\n      text: `${hours}h ${mins % 60}m ${secs}s`,\n      isBreached: false,\n    };\n  };\n\n  const filteredFindings = findings.filter(f => {\n    const matchesSearch =\n      f.cveId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      f.matchedAssetName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      f.cve.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      (f.assignee && f.assignee.toLowerCase().includes(searchTerm.toLowerCase()));\n\n    const matchesSeverity =\n      severityFilter === \'ALL\' || f.cve.cvss.severity === severityFilter;\n\n    const matchesExposure =\n      exposureFilter === \'ALL\' || f.exposure === exposureFilter;\n\n    let matchesSla = true;\n    if (slaFilter === \'BREACHED\') {\n      matchesSla = f.slaBreached && f.status !== \'CLOSED\' && f.status !== \'MITIGATED\';\n    } else if (slaFilter === \'IMMINENT\') {\n      const diff = new Date(f.slaDeadline).getTime() - Date.now();\n      matchesSla = !f.slaBreached && diff > 0 && diff < 4 * 3600 * 1000;\n    } else if (slaFilter === \'CLOSED\') {\n      matchesSla = f.status === \'CLOSED\' || f.status === \'MITIGATED\';\n    }\n\n    return matchesSearch && matchesSeverity && matchesExposure && matchesSla;\n  });\n\n  const handleCopy = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedCmd(text);\n    setTimeout(() => setCopiedCmd(null), 2000);\n  };\n\n  const handleOpenStatusChange = (status: FindingStatus) => {\n    setTargetStatus(status);\n    setStatusNote(\'\');\n    setStatusModalOpen(true);\n  };\n\n  const handleConfirmStatusChange = () => {\n    if (selectedFinding) {\n      updateFindingStatus(selectedFinding.id, targetStatus, statusNote);\n      setSelectedFinding({\n        ...selectedFinding,\n        status: targetStatus,\n      });\n    }\n    setStatusModalOpen(false);\n  };\n\n  const handleConfirmReAlert = () => {\n    if (selectedFinding && reAlertReason.trim()) {\n      reAlertCve(selectedFinding.cveId, reAlertReason);\n      setReAlertModalOpen(false);\n      setReAlertReason(\'\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-white tracking-tight flex items-center gap-2\">\n            <ShieldAlert className=\"w-5 h-5 text-red-500\" />\n            Vulnerability Findings &amp; SLA Triage Queue\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Prioritized by CISA KEV (6h SLA), EPSS score (&gt;0.40), CVSS v3.1 base score, and internet-facing perimeter escalation.\n          </p>\n        </div>\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-md\">\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by CVE, asset, or title...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n          />\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2\">\n          {/* SLA Filter */}\n          <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n            <span>SLA:</span>\n            <select\n              value={slaFilter}\n              onChange={e => setSlaFilter(e.target.value)}\n              className=\"bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              <option value=\"ALL\">All SLAs</option>\n              <option value=\"BREACHED\">Breached Only</option>\n              <option value=\"IMMINENT\">Imminent (&lt;4h)</option>\n              <option value=\"CLOSED\">Mitigated / Closed</option>\n            </select>\n          </div>\n\n          {/* Severity Filter */}\n          <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n            <span>Severity:</span>\n            <select\n              value={severityFilter}\n              onChange={e => setSeverityFilter(e.target.value)}\n              className=\"bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              <option value=\"ALL\">All Severities</option>\n              <option value=\"CRITICAL\">Critical (9.0 - 10.0)</option>\n              <option value=\"HIGH\">High (7.0 - 8.9)</option>\n              <option value=\"MEDIUM\">Medium (4.0 - 6.9)</option>\n              <option value=\"LOW\">Low</option>\n            </select>\n          </div>\n\n          {/* Exposure Filter */}\n          <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n            <span>Exposure:</span>\n            <select\n              value={exposureFilter}\n              onChange={e => setExposureFilter(e.target.value)}\n              className=\"bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              <option value=\"ALL\">All Exposure</option>\n              <option value=\"INTERNET_FACING\">Internet-Facing</option>\n              <option value=\"INTERNAL_CRITICAL\">Internal Critical</option>\n              <option value=\"DMZ\">DMZ</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Layout: Findings Table + Details Drawer */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* Table column (8 cols or full width) */}\n        <div className={`transition-all ${selectedFinding ? \'lg:col-span-7\' : \'lg:col-span-12\'}`}>\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden shadow-lg\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-slate-950/80 border-b border-slate-800 text-slate-400 font-mono uppercase text-[11px]\">\n                  <tr>\n                    <th className=\"py-3 px-3\">CVE ID</th>\n                    <th className=\"py-3 px-3\">Priority Tier &amp; SLA</th>\n                    <th className=\"py-3 px-3\">Matched Asset</th>\n                    <th className=\"py-3 px-3\">CVSS / EPSS</th>\n                    <th className=\"py-3 px-3\">Status</th>\n                    <th className=\"py-3 px-3 text-right\">Triage</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-800/60\">\n                  {filteredFindings.length === 0 ? (\n                    <tr>\n                      <td colSpan={6} className=\"py-8 text-center text-slate-500 text-xs\">\n                        No findings match the current filter criteria.\n                      </td>\n                    </tr>\n                  ) : (\n                    filteredFindings.map(finding => {\n                      const countdown = formatCountdown(finding.slaDeadline, finding.slaBreached);\n                      const isSelected = selectedFinding?.id === finding.id;\n\n                      return (\n                        <tr\n                          key={finding.id}\n                          onClick={() => setSelectedFinding(finding)}\n                          className={`cursor-pointer transition ${\n                            isSelected\n                              ? \'bg-slate-800/90 border-l-2 border-red-500\'\n                              : \'hover:bg-slate-800/40\'\n                          } ${finding.slaBreached ? \'bg-red-950/10\' : \'\'}`}\n                        >\n                          {/* CVE ID */}\n                          <td className=\"py-3 px-3\">\n                            <div className=\"font-mono font-bold text-white flex items-center space-x-1.5\">\n                              <span>{finding.cveId}</span>\n                              {finding.cve.cisaKev.isKev && (\n                                <Flame className=\"w-3.5 h-3.5 text-amber-400 animate-pulse\" title=\"CISA KEV Catalog\" />\n                              )}\n                            </div>\n                            <div className=\"text-[10px] text-slate-400 line-clamp-1 max-w-[160px]\">\n                              {finding.cve.title}\n                            </div>\n                          </td>\n\n                          {/* Priority Tier & SLA */}\n                          <td className=\"py-3 px-3\">\n                            <div className=\"flex items-center space-x-1.5\">\n                              <span\n                                className={`text-[10px] font-mono font-bold px-1.5 py-0.5 rounded ${\n                                  finding.priorityTier === \'P0_CISA_KEV\'\n                                    ? \'bg-red-950 text-red-300 border border-red-800\'\n                                    : finding.priorityTier === \'P1_CRITICAL\'\n                                    ? \'bg-rose-950 text-rose-300 border border-rose-800\'\n                                    : \'bg-amber-950 text-amber-300 border border-amber-800\'\n                                }`}\n                              >\n                                {finding.priorityTier.replace(\'_\', \' \')}\n                              </span>\n                              {finding.slaPromotedFrom && (\n                                <span className=\"text-[9px] bg-indigo-950 text-indigo-300 border border-indigo-800 px-1 rounded\">\n                                  +1 Escalated\n                                </span>\n                              )}\n                            </div>\n                            <div\n                              className={`text-[11px] font-mono mt-1 font-bold ${\n                                countdown.isBreached\n                                  ? \'text-red-400 animate-pulse\'\n                                  : \'text-amber-400\'\n                              }`}\n                            >\n                              {countdown.text}\n                            </div>\n                          </td>\n\n                          {/* Matched Asset */}\n                          <td className=\"py-3 px-3\">\n                            <div className=\"font-medium text-slate-200 line-clamp-1 max-w-[180px]\">\n                              {finding.matchedAssetName}\n                            </div>\n                            <div className=\"text-[10px] text-cyan-400 font-mono\">\n                              {finding.exposure}\n                            </div>\n                          </td>\n\n                          {/* CVSS & EPSS */}\n                          <td className=\"py-3 px-3 font-mono text-[11px]\">\n                            <div className=\"flex items-center space-x-1.5\">\n                              <span\n                                className={`font-bold ${\n                                  finding.cve.cvss.score >= 9.0\n                                    ? \'text-red-400\'\n                                    : finding.cve.cvss.score >= 7.0\n                                    ? \'text-amber-400\'\n                                    : \'text-slate-300\'\n                                }`}\n                              >\n                                {finding.cve.cvss.score.toFixed(1)}\n                              </span>\n                              <span className=\"text-slate-500\">|</span>\n                              <span className=\"text-purple-300\" title=\"EPSS Probability Score\">\n                                EPSS: {(finding.cve.epss.score * 100).toFixed(1)}%\n                              </span>\n                            </div>\n                          </td>\n\n                          {/* Status */}\n                          <td className=\"py-3 px-3\">\n                            <span\n                              className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${\n                                finding.status === \'OPEN\'\n                                  ? \'bg-slate-800 text-slate-300 border border-slate-700\'\n                                  : finding.status === \'INVESTIGATING\'\n                                  ? \'bg-indigo-950 text-indigo-300 border border-indigo-800\'\n                                  : finding.status === \'PATCHING\'\n                                  ? \'bg-amber-950 text-amber-300 border border-amber-800\'\n                                  : finding.status === \'MITIGATED\'\n                                  ? \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n                                  : \'bg-slate-900 text-slate-500\'\n                              }`}\n                            >\n                              {finding.status}\n                            </span>\n                          </td>\n\n                          {/* Triage button */}\n                          <td className=\"py-3 px-3 text-right\">\n                            <button\n                              onClick={() => setSelectedFinding(finding)}\n                              className=\"text-xs text-indigo-400 hover:text-indigo-300 inline-flex items-center\"\n                            >\n                              <span>Playbook</span>\n                              <ChevronRight className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </td>\n                        </tr>\n                      );\n                    })\n                  )}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n\n        {/* Remediation Playbook & Details Drawer (5 cols) */}\n        {selectedFinding && (\n          <div className=\"lg:col-span-5 bg-slate-900/95 border border-slate-700 rounded-xl p-5 shadow-2xl space-y-5 sticky top-20\">\n            {/* Drawer Header */}\n            <div className=\"flex items-start justify-between pb-3 border-b border-slate-800\">\n              <div>\n                <div className=\"flex items-center space-x-2\">\n                  <span className=\"text-base font-bold font-mono text-white\">\n                    {selectedFinding.cveId}\n                  </span>\n                  {selectedFinding.cve.cisaKev.isKev && (\n                    <span className=\"text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 px-1.5 py-0.5 rounded flex items-center gap-1\">\n                      <Flame className=\"w-3 h-3 text-amber-400\" />\n                      CISA KEV\n                    </span>\n                  )}\n                </div>\n                <div className=\"text-xs text-slate-300 font-medium mt-1\">\n                  {selectedFinding.cve.title}\n                </div>\n              </div>\n\n              <button\n                onClick={() => setSelectedFinding(null)}\n                className=\"text-slate-400 hover:text-white p-1\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* SLA Clock & Tier Card */}\n            <div\n              className={`p-3.5 rounded-lg border ${\n                selectedFinding.slaBreached\n                  ? \'bg-red-950/40 border-red-800 text-red-200\'\n                  : \'bg-slate-950/80 border-slate-800 text-slate-200\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between text-xs mb-1.5\">\n                <span className=\"font-semibold flex items-center gap-1.5\">\n                  <Clock className=\"w-4 h-4 text-amber-400\" />\n                  SLA Remediation Clock ({selectedFinding.slaHours}h Target)\n                </span>\n                <span className=\"font-mono text-[11px] text-slate-400\">\n                  Deadline: {new Date(selectedFinding.slaDeadline).toLocaleTimeString()}\n                </span>\n              </div>\n              <div\n                className={`font-mono text-sm font-bold ${\n                  selectedFinding.slaBreached ? \'text-red-400 animate-pulse\' : \'text-amber-300\'\n                }`}\n              >\n                {formatCountdown(selectedFinding.slaDeadline, selectedFinding.slaBreached).text}\n              </div>\n              {selectedFinding.slaPromotedFrom && (\n                <div className=\"text-[11px] text-indigo-300 mt-1\">\n                  *Escalated from {selectedFinding.slaPromotedFrom} due to Internet-Facing perimeter exposure.\n                </div>\n              )}\n            </div>\n\n            {/* Action Bar: Transition Status, Assignee, Re-Alert */}\n            <div className=\"flex flex-wrap items-center gap-2 pt-1\">\n              <select\n                value={selectedFinding.status}\n                onChange={e => handleOpenStatusChange(e.target.value as FindingStatus)}\n                className=\"bg-slate-950 border border-slate-700 text-slate-200 text-xs rounded px-2.5 py-1.5 font-semibold focus:border-indigo-500\"\n              >\n                <option value=\"OPEN\">Status: OPEN</option>\n                <option value=\"INVESTIGATING\">Status: INVESTIGATING</option>\n                <option value=\"PATCHING\">Status: PATCHING</option>\n                <option value=\"MITIGATED\">Status: MITIGATED</option>\n                <option value=\"FALSE_POSITIVE\">Status: FALSE POSITIVE</option>\n                <option value=\"CLOSED\">Status: CLOSED</option>\n              </select>\n\n              <button\n                onClick={() => setReAlertModalOpen(true)}\n                className=\"text-xs bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-800/60 px-2.5 py-1.5 rounded flex items-center space-x-1\"\n                title=\"Reset SLA clock and notify recipients\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>Re-Alert (Reset SLA)</span>\n              </button>\n            </div>\n\n            {/* Matched Asset & CPE details */}\n            <div className=\"bg-slate-950/60 border border-slate-800 rounded-lg p-3 text-xs space-y-1.5\">\n              <div className=\"text-slate-400 font-mono text-[11px] uppercase\">Asset Context</div>\n              <div className=\"text-white font-semibold\">{selectedFinding.matchedAssetName}</div>\n              <div className=\"text-cyan-400 font-mono text-[11px]\">\n                Exposure: {selectedFinding.exposure}\n              </div>\n              <div className=\"text-slate-400 font-mono text-[10px] break-all\">\n                Matched CPE: {selectedFinding.matchedCpe}\n              </div>\n            </div>\n\n            {/* Vendor Patch & Advisory link */}\n            <div className=\"flex items-center justify-between text-xs bg-indigo-950/30 border border-indigo-900/40 p-3 rounded-lg\">\n              <div>\n                <div className=\"font-semibold text-white\">Vendor Security Advisory</div>\n                <div className=\"text-[11px] text-slate-400 font-mono\">\n                  Ref: {selectedFinding.cve.remediation.vendorAdvisoryRef}\n                </div>\n              </div>\n              <a\n                href={selectedFinding.cve.remediation.patchUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded font-medium flex items-center space-x-1 transition\"\n              >\n                <span>Vendor Patch</span>\n                <ExternalLink className=\"w-3 h-3\" />\n              </a>\n            </div>\n\n            {/* Remediation Playbook: Immediate Actions */}\n            <div>\n              <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <AlertTriangle className=\"w-3.5 h-3.5 text-amber-400\" />\n                Immediate Containment Actions\n              </h3>\n              <ul className=\"space-y-1.5 text-xs text-slate-300\">\n                {selectedFinding.cve.remediation.immediateActions.map((action, i) => (\n                  <li key={i} className=\"flex items-start space-x-2 bg-slate-950/50 p-2 rounded border border-slate-800/80\">\n                    <span className=\"text-amber-400 font-mono font-bold\">\342\200\242</span>\n                    <span>{action}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Step-by-Step Remediation CLI Instructions */}\n            <div>\n              <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <Terminal className=\"w-3.5 h-3.5 text-cyan-400\" />\n                Step-by-Step CLI Execution Commands\n              </h3>\n              <div className=\"space-y-2\">\n                {selectedFinding.cve.remediation.stepByStep.map((step, idx) => (\n                  <div key={idx} className=\"bg-slate-950 border border-slate-800 rounded p-2 text-xs\">\n                    <div className=\"flex items-center justify-between text-[11px] text-slate-400 font-mono mb-1\">\n                      <span>Step {idx + 1}</span>\n                      <button\n                        onClick={() => handleCopy(step)}\n                        className=\"text-slate-400 hover:text-white transition flex items-center space-x-1\"\n                      >\n                        {copiedCmd === step ? (\n                          <Check className=\"w-3 h-3 text-emerald-400\" />\n                        ) : (\n                          <Copy className=\"w-3 h-3\" />\n                        )}\n                        <span className=\"text-[10px]\">{copiedCmd === step ? \'Copied\' : \'Copy\'}</span>\n                      </button>\n                    </div>\n                    <code className=\"text-emerald-400 font-mono block break-all text-[11px]\">\n                      {step}\n                    </code>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Rollback Plan */}\n            <div className=\"text-xs bg-slate-950/80 border border-slate-800 p-3 rounded-lg\">\n              <div className=\"text-slate-400 font-bold mb-1 flex items-center gap-1.5\">\n                <RotateCcw className=\"w-3.5 h-3.5 text-purple-400\" />\n                Rollback Plan\n              </div>\n              <p className=\"text-slate-300 text-[11px] leading-relaxed\">\n                {selectedFinding.cve.remediation.rollbackPlan}\n              </p>\n            </div>\n\n            {/* Audit Timeline */}\n            <div>\n              <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider mb-2\">\n                Finding History Timeline\n              </h3>\n              <div className=\"space-y-2 border-l border-slate-800 pl-3 ml-1 text-xs\">\n                {selectedFinding.timeline.map((event, idx) => (\n                  <div key={idx} className=\"relative\">\n                    <div className=\"absolute -left-[17px] top-1 w-2 h-2 rounded-full bg-indigo-500\" />\n                    <div className=\"font-semibold text-white\">{event.action}</div>\n                    <div className=\"text-[10px] text-slate-400 font-mono\">\n                      {new Date(event.timestamp).toLocaleString()} \342\200\242 {event.user}\n                    </div>\n                    <div className=\"text-[11px] text-slate-300 mt-0.5\">{event.note}</div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Status Change Note Modal */}\n      {statusModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4\">\n          <div className=\"bg-slate-900 border border-slate-700 rounded-xl max-w-md w-full p-5 shadow-2xl\">\n            <h3 className=\"text-sm font-bold text-white mb-2\">\n              Confirm Status Transition to {targetStatus}\n            </h3>\n            <p className=\"text-xs text-slate-400 mb-3\">\n              Add a mandatory triage rationale or patch verification note for SOC audit logs.\n            </p>\n            <textarea\n              rows={3}\n              placeholder=\"e.g. Patch tested in staging cluster; change order RFC-9821 approved.\"\n              value={statusNote}\n              onChange={e => setStatusNote(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-xs text-white focus:border-indigo-500\"\n            />\n            <div className=\"flex justify-end space-x-2 mt-4\">\n              <button\n                onClick={() => setStatusModalOpen(false)}\n                className=\"px-3 py-1.5 rounded bg-slate-800 text-slate-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmStatusChange}\n                className=\"px-4 py-1.5 rounded bg-red-600 hover:bg-red-500 text-white font-semibold text-xs\"\n              >\n                Apply Transition\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Re-Alert Modal */}\n      {reAlertModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4\">\n          <div className=\"bg-slate-900 border border-slate-700 rounded-xl max-w-md w-full p-5 shadow-2xl\">\n            <h3 className=\"text-sm font-bold text-white mb-2 flex items-center gap-1.5 text-amber-300\">\n              <RotateCcw className=\"w-4 h-4\" />\n              Re-Alert on Vulnerability (Reset SLA Clock)\n            </h3>\n            <p className=\"text-xs text-slate-400 mb-3\">\n              This will reset the SLA countdown timer, increase the re-alert counter, and re-dispatch urgent notifications to assigned engineering teams.\n            </p>\n            <label className=\"block text-slate-400 text-xs mb-1 font-mono\">\n              Re-Alert Justification *\n            </label>\n            <textarea\n              rows={3}\n              required\n              placeholder=\"e.g. Vendor released critical Rev 2 patch; initial mitigation was ineffective.\"\n              value={reAlertReason}\n              onChange={e => setReAlertReason(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-xs text-white focus:border-indigo-500\"\n            />\n            <div className=\"flex justify-end space-x-2 mt-4\">\n              <button\n                onClick={() => setReAlertModalOpen(false)}\n                className=\"px-3 py-1.5 rounded bg-slate-800 text-slate-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmReAlert}\n                disabled={!reAlertReason.trim()}\n                className=\"px-4 py-1.5 rounded bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs disabled:opacity-50\"\n              >\n                Dispatch Re-Alert\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
