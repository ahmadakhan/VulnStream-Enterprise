    end_line: 149
    content: "import {\n  ThreatFeed,\n  WatchListItem,\n  NormalizedCVE,\n  Finding,\n  Advisory,\n  AlertedCVE,\n  PipelineExecution,\n  PipelinePhase,\n  AppSettings,\n  ExploitRiskLevel,\n  EmailDeliveryLog,\n  AuditLog,\n} from \'../types\';\nimport { normalizeCveId, isWithinTimelineScope, InRunDeduplicator } from \'../utils/deduplicator\';\nimport { matchesWatchlistItem } from \'../utils/cpeMatcher\';\n\nexport interface PipelineRunResult {\n  execution: PipelineExecution;\n  newFindings: Finding[];\n  newAdvisories: Advisory[];\n  updatedAlertedCves: AlertedCVE[];\n  newEmailLogs: EmailDeliveryLog[];\n  newAuditLogs: AuditLog[];\n}\n\nexport function validateSsrfSafety(urlString: string): { safe: boolean; reason?: string } {\n  try {\n    const parsed = new URL(urlString);\n    if (![\'http:\', \'https:\'].includes(parsed.protocol)) {\n      return { safe: false, reason: \'Invalid protocol. Only HTTP and HTTPS are permitted.\' };\n    }\n    if (parsed.username || parsed.password) {\n      return { safe: false, reason: \'Embedded credentials in URL are prohibited.\' };\n    }\n\n    const host = parsed.hostname.toLowerCase();\n\n    // Check localhost & loopbacks\n    if (host === \'localhost\' || host === \'127.0.0.1\' || host === \'::1\' || host.startsWith(\'127.\')) {\n      return { safe: false, reason: \'SSRF Violation: Loopback addresses are blocked.\' };\n    }\n\n    // Check RFC1918 private ranges & RFC3927 link-local\n    if (\n      host.startsWith(\'10.\') ||\n      host.startsWith(\'192.168.\') ||\n      host.startsWith(\'169.254.\') ||\n      /^172\\.(1[6-9]|2[0-9]|3[0-1])\\./.test(host)\n    ) {\n      return { safe: false, reason: \'SSRF Violation: Private and link-local IP addresses are blocked.\' };\n    }\n\n    return { safe: true };\n  } catch {\n    return { safe: false, reason: \'Malformed URL.\' };\n  }\n}\n\nexport function determineExploitRisk(cve: NormalizedCVE): ExploitRiskLevel {\n  if (cve.cisaKev.isKev) {\n    return \'CISA_KEV_EXPLOITED\';\n  }\n  if (cve.exploitStatus === \'Active Weaponized\') {\n    return \'WEAPONIZED_EXPLOIT\';\n  }\n  if (cve.epss.score >= 0.40) {\n    return \'HIGH_EPSS_PROBABILITY\';\n  }\n  if (cve.cvss.score >= 7.0) {\n    return \'ELEVATED\';\n  }\n  return \'STANDARD\';\n}\n\nexport function runVulnerabilityPipeline(\n  activeFeeds: ThreatFeed[],\n  cveCorpus: NormalizedCVE[],\n  watchlist: WatchListItem[],\n  existingAlertedCves: AlertedCVE[],\n  existingFindings: Finding[],\n  settings: AppSettings,\n  callerName: string = \'Autonomous APScheduler\'\n): PipelineRunResult {\n  const startTime = new Date();\n  const phases: PipelinePhase[] = [];\n  const logs: string[] = [];\n  const newAuditLogs: AuditLog[] = [];\n  const executionId = `PIPE-${startTime.getTime().toString(36).toUpperCase()}`;\n\n  function logMessage(level: \'INFO\' | \'WARNING\' | \'ERROR\', msg: string, category: AuditLog[\'category\'] = \'PIPELINE\') {\n    const ts = new Date().toISOString();\n    logs.push(`[${ts}] [${level}] ${msg}`);\n    newAuditLogs.push({\n      id: `audit-${Math.random().toString(36).substring(2, 9)}`,\n      timestamp: ts,\n      category,\n      level,\n      event: \'Pipeline Execution\',\n      details: msg,\n      actor: callerName,\n      ipAddress: \'127.0.0.1\',\n    });\n  }\n\n  logMessage(\'INFO\', `Starting autonomous vulnerability tracking run ${executionId}. Scope: ${settings.scopeHours}h.`);\n\n  // -------------------------------------------------------------\n  // Phase 1: Ingestion & SSRF Pre-flight\n  // -------------------------------------------------------------\n  const p1Start = Date.now();\n  const enabledFeeds = activeFeeds.filter(f => f.enabled);\n  let totalFeedItemsIngested = 0;\n\n  for (const feed of enabledFeeds) {\n    const ssrfCheck = validateSsrfSafety(feed.url);\n    if (!ssrfCheck.safe) {\n      logMessage(\'ERROR\', `Feed \"${feed.name}\" SSRF check failed: ${ssrfCheck.reason}`, \'SECURITY\');\n    } else {\n      totalFeedItemsIngested += feed.itemCountLastRun || 15;\n    }\n  }\n\n  phases.push({\n    name: \'Feed Ingestion & Ingress Validation\',\n    status: \'SUCCESS\',\n    durationMs: Date.now() - p1Start + 120,\n    details: `Checked ${enabledFeeds.length} feeds. SSRF safety verified. Ingested ${totalFeedItemsIngested} candidate records.`,\n    metrics: { feedsChecked: enabledFeeds.length, rawItems: totalFeedItemsIngested },\n  });\n\n  // -------------------------------------------------------------\n  // Phase 2: Deduplication, Normalization & Scope Filtering\n  // -------------------------------------------------------------\n  const p2Start = Date.now();\n  const previouslyAlertedIds = existingAlertedCves.map(a => a.cveId);\n  const deduplicator = new InRunDeduplicator(previouslyAlertedIds);\n\n  const scopeFilteredCves: NormalizedCVE[] = [];\n  let inRunDuplicatesDropped = 0;\n  let previouslyAlertedDropped = 0;\n\n  for (const cve of cveCorpus) {\n    const canonical = normalizeCveId(cve.cveId);\n    if (!canonical) {\n      logMessage(\'WARNING\', `Dropped malformed CVE identifier: \"${cve.cveId}\"`);\n      continue;\n    }\n\n    const inScope = isWithinTimelineScope(cve.publishedDate, cve.modifiedDate, settings.scopeHours, startTime);"
    num_lines: 381
    num_bytes: 13173
    line_range_bytes: 5007
  }
}
