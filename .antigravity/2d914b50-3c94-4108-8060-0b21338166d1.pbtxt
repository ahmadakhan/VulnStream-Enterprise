  view_file {
    absolute_path_uri: "file:///src/components/AdvisoryTemplateView.tsx"
    end_line: 242
    content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  FileCode,\n  Send,\n  Eye,\n  RotateCcw,\n  CheckCircle2,\n  AlertCircle,\n  Copy,\n  Check,\n  Code,\n  X,\n} from \'lucide-react\';\nimport { INITIAL_ADVISORY_TEMPLATE } from \'../data/seedData\';\n\nexport const AdvisoryTemplateView: React.FC = () => {\n  const { advisoryTemplate, setAdvisoryTemplate, sendTestEmail } = useApp();\n  const [testEmail, setTestEmail] = useState(\'secops-team@enterprise.org\');\n  const [showTestModal, setShowTestModal] = useState(false);\n  const [testResult, setTestResult] = useState<{ success: boolean; message: string } | null>(null);\n  const [saveToast, setSaveToast] = useState(false);\n\n  const getRenderedHtml = () => {\n    return advisoryTemplate\n      .replace(/{{severity}}/g, \'CRITICAL\')\n      .replace(/{{advisory_id}}/g, \'ADV-2026-0842\')\n      .replace(/{{advisory_title}}/g, \'Microsoft Windows RDLicsvr Remote Code Execution (MadLicence)\')\n      .replace(/{{dispatch_date}}/g, new Date().toUTCString())\n      .replace(/{{executive_summary}}/g, \'An unauthenticated remote code execution vulnerability exists in the Windows Remote Desktop Licensing Service. Attackers can gain SYSTEM privileges without credentials. Monitored product Windows Server 2022 is affected.\')\n      .replace(/{{cve_ids}}/g, \'CVE-2024-38077 (CVSS 9.8)\')\n      .replace(/{{affected_systems}}/g, \'DC-CORP-PDC01 (Active Directory Root Controller)\')\n      .replace(/{{remediation_steps}}/g, \'1. Stop-Service -Name TermServLicensing -Force\\n2. Set-Service -Name TermServLicensing -StartupType Disabled\\n3. Deploy Cumulative Update KB5040437\')\n      .replace(/{{vendor_link}}/g, \'https://msrc.microsoft.com/update-guide/vulnerability/CVE-2024-38077\');\n  };\n\n  const handleSave = () => {\n    setSaveToast(true);\n    setTimeout(() => setSaveToast(false), 2000);\n  };\n\n  const handleReset = () => {\n    if (confirm(\'Reset email template to default factory template?\')) {\n      setAdvisoryTemplate(INITIAL_ADVISORY_TEMPLATE);\n    }\n  };\n\n  const handleSendTest = (e: React.FormEvent) => {\n    e.preventDefault();\n    const res = sendTestEmail(testEmail);\n    setTestResult(res);\n    if (res.success) {\n      setTimeout(() => {\n        setShowTestModal(false);\n        setTestResult(null);\n      }, 1500);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\">\n            <FileCode className=\"w-5 h-5 text-zinc-300\" />\n            Advisory Email Template &amp; Automated Notice Sandbox\n          </h1>\n          <p className=\"text-xs text-zinc-400 mt-1\">\n            Customizable HTML email template used by the autonomous dispatcher when new product vulnerabilities are correlated.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          <button\n            onClick={handleReset}\n            className=\"text-xs px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 font-medium transition flex items-center space-x-1\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            <span>Reset Default</span>\n          </button>\n          <button\n            onClick={() => {\n              setTestResult(null);\n              setShowTestModal(true);\n            }}\n            className=\"text-xs px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 font-semibold transition flex items-center space-x-1.5\"\n          >\n            <Send className=\"w-3.5 h-3.5\" />\n            <span>Send Test Email</span>\n          </button>\n          <button\n            onClick={handleSave}\n            className=\"text-xs px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold transition\"\n          >\n            {saveToast ? \'Template Saved!\' : \'Save Template\'}\n          </button>\n        </div>\n      </div>\n\n      {/* Variables Token Bar */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-3.5 flex flex-wrap items-center gap-2 text-xs\">\n        <span className=\"text-zinc-500 font-mono text-[11px] font-medium\">Available Tokens:</span>\n        {[\n          \'{{advisory_id}}\',\n          \'{{advisory_title}}\',\n          \'{{severity}}\',\n          \'{{dispatch_date}}\',\n          \'{{executive_summary}}\',\n          \'{{cve_ids}}\',\n          \'{{affected_systems}}\',\n          \'{{remediation_steps}}\',\n          \'{{vendor_link}}\',\n        ].map(token => (\n          <code\n            key={token}\n            className=\"bg-zinc-950 border border-zinc-800 text-zinc-300 px-2 py-0.5 rounded-lg text-[11px] font-mono cursor-pointer hover:border-zinc-600 transition\"\n            onClick={() => navigator.clipboard.writeText(token)}\n            title=\"Click to copy token\"\n          >\n            {token}\n          </code>\n        ))}\n      </div>\n\n      {/* 2-Column Layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Editor */}\n        <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 shadow-sm flex flex-col\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <h3 className=\"text-xs font-semibold text-zinc-300 uppercase tracking-wider flex items-center gap-1.5\">\n              <Code className=\"w-4 h-4 text-zinc-400\" />\n              HTML Email Template\n            </h3>\n            <span className=\"text-[10px] text-zinc-500 font-mono\">\n              Inline CSS Compatible\n            </span>\n          </div>\n\n          <textarea\n            rows={22}\n            value={advisoryTemplate}\n            onChange={e => setAdvisoryTemplate(e.target.value)}\n            className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-3 font-mono text-xs text-zinc-300 leading-relaxed focus:outline-none focus:border-zinc-600 resize-none\"\n          />\n        </div>\n\n        {/* Live Email Client Preview */}\n        <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 shadow-sm flex flex-col\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <h3 className=\"text-xs font-semibold text-zinc-300 uppercase tracking-wider flex items-center gap-1.5\">\n              <Eye className=\"w-4 h-4 text-zinc-400\" />\n              Rendered Client Preview\n            </h3>\n            <span className=\"text-[10px] text-zinc-500 font-mono\">\n              Automated Dispatch Sandbox\n            </span>\n          </div>\n\n          <div className=\"w-full h-full min-h-[500px] bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden relative\">\n            <iframe\n              title=\"Advisory Template Preview\"\n              srcDoc={getRenderedHtml()}\n              className=\"w-full h-full min-h-[500px] border-none\"\n              sandbox=\"allow-same-origin\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Test Email Modal */}\n      {showTestModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative\">\n            <button\n              onClick={() => setShowTestModal(false)}\n              className=\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <h2 className=\"text-base font-bold text-zinc-100 mb-1 flex items-center gap-2\">\n              <Send className=\"w-4 h-4 text-zinc-300\" />\n              Send Test Vulnerability Notification\n            </h2>\n            <p className=\"text-xs text-zinc-400 mb-4\">\n              Sends an email with sample product vulnerability data to verify mailbox rendering.\n            </p>\n\n            {testResult && (\n              <div\n                className={`p-3 rounded-xl text-xs mb-3 flex items-center gap-2 ${\n                  testResult.success\n                    ? \'bg-zinc-950 border border-emerald-800 text-emerald-300\'\n                    : \'bg-zinc-950 border border-zinc-700 text-zinc-300\'\n                }`}\n              >\n                {testResult.success ? (\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                ) : (\n                  <AlertCircle className=\"w-4 h-4 text-zinc-400 shrink-0\" />\n                )}\n                <span>{testResult.message}</span>\n              </div>\n            )}\n\n            <form onSubmit={handleSendTest} className=\"space-y-4 text-xs\">\n              <div>\n                <label className=\"block text-zinc-400 mb-1 font-mono\">\n                  Destination Email Address *\n                </label>\n                <input\n                  type=\"email\"\n                  required\n                  value={testEmail}\n                  onChange={e => setTestEmail(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"flex justify-end space-x-2 pt-3 border-t border-zinc-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowTestModal(false)}\n                  className=\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300\"\n                >\n                  Cancel\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold\"\n                >\n                  Send Test\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    num_lines: 243
    num_bytes: 9923
    line_range_bytes: 9923
  }
}
