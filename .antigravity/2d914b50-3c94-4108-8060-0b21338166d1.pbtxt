  planner_response {
    thinking: "**Constructing Advisory Template**\n\nI\'m focusing on building the `AdvisoryTemplateView.tsx` component. The core requirement is an editable HTML email template that includes a live preview and the ability to test-send the template to a configured recipient. I\'m noting the necessary variable tags too, like `{{advisory_id}}` and `{{advisory_title}}` for dynamic content.\n\n\n"
    tool_calls {
      id: "call_82845"
      name: "write_to_file"
      arguments_json: "{\"Append\":false,\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useApp } from \'../context/AppContext\';\\nimport {\\n  FileCode,\\n  Send,\\n  Eye,\\n  RotateCcw,\\n  CheckCircle2,\\n  AlertCircle,\\n  Copy,\\n  Check,\\n  Code,\\n  X,\\n} from \'lucide-react\';\\nimport { INITIAL_ADVISORY_TEMPLATE } from \'../data/seedData\';\\n\\nexport const AdvisoryTemplateView: React.FC = () => {\\n  const { advisoryTemplate, setAdvisoryTemplate, sendTestEmail } = useApp();\\n  const [testEmail, setTestEmail] = useState(\'secops-team@enterprise.org\');\\n  const [showTestModal, setShowTestModal] = useState(false);\\n  const [testResult, setTestResult] = useState<{ success: boolean; message: string } | null>(null);\\n  const [saveToast, setSaveToast] = useState(false);\\n\\n  // Render dummy preview by substituting variables\\n  const getRenderedHtml = () => {\\n    return advisoryTemplate\\n      .replace(/{{severity}}/g, \'CRITICAL\')\\n      .replace(/{{advisory_id}}/g, \'ADV-2026-0842\')\\n      .replace(/{{advisory_title}}/g, \'Microsoft Windows RDLicsvr Remote Code Execution (MadLicence)\')\\n      .replace(/{{dispatch_date}}/g, new Date().toUTCString())\\n      .replace(/{{sla_hours}}/g, \'6\')\\n      .replace(/{{sla_deadline}}/g, new Date(Date.now() + 6 * 3600 * 1000).toUTCString())\\n      .replace(/{{sla_warning}}/g, \'P0 CISA KEV Remediation Clock: Strict 6h SLA mandatory.\')\\n      .replace(/{{executive_summary}}/g, \'An unauthenticated remote code execution vulnerability exists in the Windows Remote Desktop Licensing Service. Attackers can gain SYSTEM privileges without credentials. Tier 0 Domain Controllers are exposed.\')\\n      .replace(/{{cve_ids}}/g, \'CVE-2024-38077 (CVSS 9.8)\')\\n      .replace(/{{affected_systems}}/g, \'DC-CORP-PDC01 (Active Directory Root Controller)\')\\n      .replace(/{{remediation_steps}}/g, \'1. Stop-Service -Name TermServLicensing -Force\\\\n2. Set-Service -Name TermServLicensing -StartupType Disabled\\\\n3. Deploy Cumulative Update KB5040437\')\\n      .replace(/{{vendor_link}}/g, \'https://msrc.microsoft.com/update-guide/vulnerability/CVE-2024-38077\');\\n  };\\n\\n  const handleSave = () => {\\n    setSaveToast(true);\\n    setTimeout(() => setSaveToast(false), 2000);\\n  };\\n\\n  const handleReset = () => {\\n    if (confirm(\'Reset advisory email template to default factory template?\')) {\\n      setAdvisoryTemplate(INITIAL_ADVISORY_TEMPLATE);\\n    }\\n  };\\n\\n  const handleSendTest = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const res = sendTestEmail(testEmail);\\n    setTestResult(res);\\n    if (res.success) {\\n      setTimeout(() => {\\n        setShowTestModal(false);\\n        setTestResult(null);\\n      }, 1500);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Header */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h1 className=\\\"text-xl font-bold text-white tracking-tight flex items-center gap-2\\\">\\n            <FileCode className=\\\"w-5 h-5 text-indigo-400\\\" />\\n            Advisory Email Template &amp; Live Sandbox\\n          </h1>\\n          <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n            Customizable responsive HTML email template for dispatching automated security advisories with token substitution.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center space-x-2\\\">\\n          <button\\n            onClick={handleReset}\\n            className=\\\"text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-medium transition flex items-center space-x-1\\\"\\n          >\\n            <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Reset Default</span>\\n          </button>\\n          <button\\n            onClick={() => {\\n              setTestResult(null);\\n              setShowTestModal(true);\\n            }}\\n            className=\\\"text-xs px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition flex items-center space-x-1.5\\\"\\n          >\\n            <Send className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Send Test Email</span>\\n          </button>\\n          <button\\n            onClick={handleSave}\\n            className=\\\"text-xs px-4 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-semibold shadow transition\\\"\\n          >\\n            {saveToast ? \'Template Saved!\' : \'Save Template\'}\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Variables Token Bar */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-xl p-3 flex flex-wrap items-center gap-2 text-xs\\\">\\n        <span className=\\\"text-slate-400 font-mono text-[11px] font-semibold\\\">Available Tokens:</span>\\n        {[\\n          \'{{advisory_id}}\',\\n          \'{{advisory_title}}\',\\n          \'{{severity}}\',\\n          \'{{dispatch_date}}\',\\n          \'{{sla_hours}}\',\\n          \'{{sla_deadline}}\',\\n          \'{{executive_summary}}\',\\n          \'{{cve_ids}}\',\\n          \'{{affected_systems}}\',\\n          \'{{remediation_steps}}\',\\n          \'{{vendor_link}}\',\\n        ].map(token => (\\n          <code\\n            key={token}\\n            className=\\\"bg-slate-950 border border-slate-800 text-emerald-400 px-2 py-0.5 rounded text-[11px] font-mono cursor-pointer hover:border-slate-600\\\"\\n            onClick={() => navigator.clipboard.writeText(token)}\\n            title=\\\"Click to copy token\\\"\\n          >\\n            {token}\\n          </code>\\n        ))}\\n      </div>\\n\\n      {/* 2-Column Layout: Code Editor on Left, Live Preview on Right */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n        {/* HTML Template Editor */}\\n        <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-lg flex flex-col\\\">\\n          <div className=\\\"flex items-center justify-between mb-2\\\">\\n            <h3 className=\\\"text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5\\\">\\n              <Code className=\\\"w-4 h-4 text-indigo-400\\\" />\\n              HTML Email Template Editor\\n            </h3>\\n            <span className=\\\"text-[10px] text-slate-500 font-mono\\\">\\n              Responsive Inline CSS\\n            </span>\\n          </div>\\n\\n          <textarea\\n            rows={22}\\n            value={advisoryTemplate}\\n            onChange={e => setAdvisoryTemplate(e.target.value)}\\n            className=\\\"w-full bg-slate-950 border border-slate-800 rounded-lg p-3 font-mono text-xs text-indigo-200 leading-relaxed focus:outline-none focus:border-indigo-500 resize-none\\\"\\n          />\\n        </div>\\n\\n        {/* Live Email Sandbox Preview */}\\n        <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-lg flex flex-col\\\">\\n          <div className=\\\"flex items-center justify-between mb-2\\\">\\n            <h3 className=\\\"text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5\\\">\\n              <Eye className=\\\"w-4 h-4 text-emerald-400\\\" />\\n              Live Email Client Rendering\\n            </h3>\\n            <span className=\\\"text-[10px] text-slate-400 font-mono\\\">\\n              Simulated Mailgun / Exchange Ingestion\\n            </span>\\n          </div>\\n\\n          <div className=\\\"w-full h-full min-h-[500px] bg-slate-950 border border-slate-800 rounded-lg overflow-hidden relative\\\">\\n            <iframe\\n              title=\\\"Advisory Template Preview\\\"\\n              srcDoc={getRenderedHtml()}\\n              className=\\\"w-full h-full min-h-[500px] border-none\\\"\\n              sandbox=\\\"allow-same-origin\\\"\\n            />\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Send Test Email Modal */}\\n      {showTestModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-slate-700 rounded-xl max-w-md w-full p-6 shadow-2xl relative\\\">\\n            <button\\n              onClick={() => setShowTestModal(false)}\\n              className=\\\"absolute top-4 right-4 text-slate-400 hover:text-white\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <h2 className=\\\"text-base font-bold text-white mb-2 flex items-center gap-2\\\">\\n              <Send className=\\\"w-4 h-4 text-indigo-400\\\" />\\n              Send Test Advisory Email\\n            </h2>\\n            <p className=\\\"text-xs text-slate-400 mb-4\\\">\\n              Dispatches a test bulletin to verify SMTP/Mailgun rendering and mailbox deliverability.\\n            </p>\\n\\n            {testResult && (\\n              <div\\n                className={`p-3 rounded text-xs mb-3 flex items-center gap-2 ${\\n                  testResult.success\\n                    ? \'bg-emerald-950 border border-emerald-800 text-emerald-200\'\\n                    : \'bg-red-950 border border-red-800 text-red-200\'\\n                }`}\\n              >\\n                {testResult.success ? (\\n                  <CheckCircle2 className=\\\"w-4 h-4 text-emerald-400 shrink-0\\\" />\\n                ) : (\\n                  <AlertCircle className=\\\"w-4 h-4 text-red-400 shrink-0\\\" />\\n                )}\\n                <span>{testResult.message}</span>\\n              </div>\\n            )}\\n\\n            <form onSubmit={handleSendTest} className=\\\"space-y-4 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-slate-400 mb-1 font-mono\\\">\\n                  Target Recipient Email *\\n                </label>\\n                <input\\n                  type=\\\"email\\\"\\n                  required\\n                  value={testEmail}\\n                  onChange={e => setTestEmail(e.target.value)}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex justify-end space-x-2 pt-3 border-t border-slate-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowTestModal(false)}\\n                  className=\\\"px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-semibold\\\"\\n                >\\n                  Transmit Test\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Implement AdvisoryTemplateView with code editor, variable tokens, live email client preview iframe, and test send modal\",\"Overwrite\":true,\"TargetFile\":\"/src/components/AdvisoryTemplateView.tsx\",\"toolAction\":\"Creating AdvisoryTemplateView.tsx\",\"toolSummary\":\"Create advisory template view\"}"
