      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { AlertedCVE } from \'../types\';\nimport {\n  Bell,\n  RotateCcw,\n  Search,\n  CheckCircle2,\n  Clock,\n  ShieldCheck,\n  Mail,\n  AlertTriangle,\n  X,\n} from \'lucide-react\';\n\nexport const AlertedCVEsView: React.FC = () => {\n  const { alertedCves, reAlertCve } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedCve, setSelectedCve] = useState<AlertedCVE | null>(null);\n  const [reAlertReason, setReAlertReason] = useState(\'\');\n\n  const filtered = alertedCves.filter(item =>\n    item.cveId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    item.advisoryId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    item.recipientEmails.some(r => r.toLowerCase().includes(searchTerm.toLowerCase()))\n  );\n\n  const handleConfirmReAlert = () => {\n    if (selectedCve && reAlertReason.trim()) {\n      reAlertCve(selectedCve.cveId, reAlertReason);\n      setSelectedCve(null);\n      setReAlertReason(\'\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-white tracking-tight flex items-center gap-2\">\n            <Bell className=\"w-5 h-5 text-indigo-400\" />\n            Alerted CVEs &amp; Suppression Registry\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Canonical O(1) lookup preventing duplicate advisory notifications across pipeline runs. Supports explicit re-alerting with SLA clock resets.\n          </p>\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 shadow-md\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by CVE, Advisory ID, or recipient...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n          />\n        </div>\n\n        <div className=\"text-xs font-mono text-slate-400\">\n          Total Tracked: <strong className=\"text-white\">{alertedCves.length}</strong>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden shadow-lg\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-950/80 border-b border-slate-800 text-slate-400 font-mono uppercase text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Canonical CVE ID</th>\n                <th className=\"py-3 px-4\">Advisory Ref</th>\n                <th className=\"py-3 px-4\">First Dispatched</th>\n                <th className=\"py-3 px-4\">Last Dispatched</th>\n                <th className=\"py-3 px-4\">Re-Alerts</th>\n                <th className=\"py-3 px-4\">Lifecycle Status</th>\n                <th className=\"py-3 px-4 text-right\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {filtered.map(item => (\n                <tr key={item.cveId} className=\"hover:bg-slate-800/40 transition\">\n                  <td className=\"py-3 px-4 font-mono font-bold text-white text-sm\">\n                    {item.cveId}\n                  </td>\n                  <td className=\"py-3 px-4 font-mono text-indigo-300\">\n                    {item.advisoryId}\n                  </td>\n                  <td className=\"py-3 px-4 text-slate-400 font-mono text-[11px]\">\n                    {new Date(item.firstAlertedAt).toLocaleString()}\n                  </td>\n                  <td className=\"py-3 px-4 text-slate-400 font-mono text-[11px]\">\n                    {new Date(item.lastAlertedAt).toLocaleString()}\n                    {item.lastReAlertReason && (\n                      <div className=\"text-[10px] text-amber-300 font-sans italic line-clamp-1\">\n                        Reason: {item.lastReAlertReason}\n                      </div>\n                    )}\n                  </td>\n                  <td className=\"py-3 px-4 font-mono\">\n                    <span className={`px-2 py-0.5 rounded text-[11px] font-bold ${\n                      item.reAlertCount > 0 ? \'bg-amber-950 text-amber-300 border border-amber-800\' : \'text-slate-400\'\n                    }`}>\n                      {item.reAlertCount}\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-4\">\n                    <span\n                      className={`text-[10px] font-semibold px-2 py-0.5 rounded font-mono ${\n                        item.status === \'ACTIVE_REMEDIATION\'\n                          ? \'bg-red-950 text-red-300 border border-red-800\'\n                          : item.status === \'RESOLVED\'\n                          ? \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n                          : \'bg-slate-800 text-slate-400\'\n                      }`}\n                    >\n                      {item.status.replace(\'_\', \' \')}\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-4 text-right\">\n                    <button\n                      onClick={() => {\n                        setSelectedCve(item);\n                        setReAlertReason(\'\');\n                      }}\n                      className=\"px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-800/60 font-medium text-xs inline-flex items-center space-x-1\"\n                    >\n                      <RotateCcw className=\"w-3 h-3\" />\n                      <span>Re-Alert</span>\n                    </button>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Re-Alert Modal */}\n      {selectedCve && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4\">\n          <div className=\"bg-slate-900 border border-slate-700 rounded-xl max-w-md w-full p-6 shadow-2xl relative\">\n            <button\n              onClick={() => setSelectedCve(null)}\n              className=\"absolute top-4 right-4 text-slate-400 hover:text-white\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <h3 className=\"text-base font-bold text-white mb-2 flex items-center gap-2\">\n              <RotateCcw className=\"w-4 h-4 text-amber-400\" />\n              Re-Alert: {selectedCve.cveId}\n            </h3>\n            <p className=\"text-xs text-slate-400 mb-4\">\n              Re-alerting on this CVE will reset the active remediation SLA clock, increment re-alert counters, and trigger immediate email notification dispatch.\n            </p>\n\n            <label className=\"block text-slate-300 text-xs font-mono mb-1\">\n              Audit Rationale / Reason *\n            </label>\n            <textarea\n              rows={3}\n              required\n              placeholder=\"e.g. Host failed vulnerability scan validation after patching; remediation incomplete.\"\n              value={reAlertReason}\n              onChange={e => setReAlertReason(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-xs text-white focus:border-indigo-500\"\n            />\n\n            <div className=\"flex justify-end space-x-2 mt-4 pt-3 border-t border-slate-800\">\n              <button\n                onClick={() => setSelectedCve(null)}\n                className=\"px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmReAlert}\n                disabled={!reAlertReason.trim()}\n                className=\"px-4 py-1.5 rounded bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs disabled:opacity-50\"\n              >\n                Dispatch Re-Alert\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AlertedCVEsView.tsx"
        }
        overwrite: true
      }
