      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { NormalizedCVE } from \'../types\';\nimport {\n  Database,\n  Search,\n  Filter,\n  Flame,\n  ExternalLink,\n  Code,\n  FileJson,\n  Layers,\n  CheckCircle2,\n  X,\n  Copy,\n  Check,\n} from \'lucide-react\';\n\nexport const ThreatDataView: React.FC = () => {\n  const { cveData } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [kevFilter, setKevFilter] = useState<\'ALL\' | \'KEV_ONLY\'>(\'ALL\');\n  const [epssFilter, setEpssFilter] = useState<\'ALL\' | \'HIGH_EPSS\'>(\'ALL\');\n  const [inspectCve, setInspectCve] = useState<NormalizedCVE | null>(null);\n  const [copied, setCopied] = useState(false);\n\n  const filteredCves = cveData.filter(cve => {\n    const matchesSearch =\n      cve.cveId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      cve.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      cve.sourceFeeds.some(s => s.toLowerCase().includes(searchTerm.toLowerCase())) ||\n      cve.cpeMatches.some(c => c.toLowerCase().includes(searchTerm.toLowerCase()));\n\n    const matchesKev = kevFilter === \'ALL\' || cve.cisaKev.isKev;\n    const matchesEpss = epssFilter === \'ALL\' || cve.epss.score >= 0.40;\n\n    return matchesSearch && matchesKev && matchesEpss;\n  });\n\n  const handleCopyJson = () => {\n    if (inspectCve) {\n      navigator.clipboard.writeText(JSON.stringify(inspectCve, null, 2));\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-white tracking-tight flex items-center gap-2\">\n            <Database className=\"w-5 h-5 text-indigo-400\" />\n            Threat Data Cache &amp; Ingestion Explorer\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Unified normalized record format merging NVD CVSS v3.1, FIRST.org EPSS scores, CISA KEV ransomware intelligence, and GitHub Advisories.\n          </p>\n        </div>\n      </div>\n\n      {/* Filter Bar */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-md\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search normalized cache by CVE, title, or CPE...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n          />\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          {/* CISA KEV Filter */}\n          <button\n            onClick={() => setKevFilter(k => (k === \'ALL\' ? \'KEV_ONLY\' : \'ALL\'))}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition ${\n              kevFilter === \'KEV_ONLY\'\n                ? \'bg-amber-600 text-white\'\n                : \'bg-slate-950 border border-slate-800 text-slate-300 hover:bg-slate-800\'\n            }`}\n          >\n            <Flame className=\"w-3.5 h-3.5\" />\n            <span>CISA KEV Only</span>\n          </button>\n\n          {/* EPSS Filter */}\n          <button\n            onClick={() => setEpssFilter(e => (e === \'ALL\' ? \'HIGH_EPSS\' : \'ALL\'))}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition ${\n              epssFilter === \'HIGH_EPSS\'\n                ? \'bg-purple-600 text-white\'\n                : \'bg-slate-950 border border-slate-800 text-slate-300 hover:bg-slate-800\'\n            }`}\n          >\n            <span>EPSS &gt; 0.40</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Normalized Records Table */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden shadow-lg\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-950/80 border-b border-slate-800 text-slate-400 font-mono uppercase text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Canonical CVE</th>\n                <th className=\"py-3 px-4\">CVSS v3.1 Score</th>\n                <th className=\"py-3 px-4\">EPSS Percentile</th>\n                <th className=\"py-3 px-4\">Exploit Status</th>\n                <th className=\"py-3 px-4\">Normalized Sources</th>\n                <th className=\"py-3 px-4 text-right\">Inspect</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {filteredCves.map(cve => (\n                <tr key={cve.cveId} className=\"hover:bg-slate-800/40 transition\">\n                  {/* Canonical CVE */}\n                  <td className=\"py-3 px-4\">\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-mono font-bold text-white text-sm\">{cve.cveId}</span>\n                      {cve.cisaKev.isKev && (\n                        <span className=\"bg-amber-950/80 text-amber-300 border border-amber-800 px-1.5 py-0.2 rounded font-mono text-[10px] font-bold flex items-center gap-1\">\n                          <Flame className=\"w-3 h-3 text-amber-400\" />\n                          KEV\n                        </span>\n                      )}\n                    </div>\n                    <div className=\"text-xs text-slate-300 line-clamp-1 max-w-md mt-0.5\">\n                      {cve.title}\n                    </div>\n                  </td>\n\n                  {/* CVSS Score */}\n                  <td className=\"py-3 px-4 font-mono\">\n                    <div className=\"flex items-center space-x-1.5\">\n                      <span\n                        className={`font-bold text-sm ${\n                          cve.cvss.score >= 9.0\n                            ? \'text-red-400\'\n                            : cve.cvss.score >= 7.0\n                            ? \'text-amber-400\'\n                            : \'text-slate-300\'\n                        }`}\n                      >\n                        {cve.cvss.score.toFixed(1)}\n                      </span>\n                      <span className=\"text-[10px] text-slate-500\">{cve.cvss.severity}</span>\n                    </div>\n                    <div className=\"text-[10px] text-slate-500 truncate max-w-[150px]\" title={cve.cvss.vector}>\n                      {cve.cvss.vector}\n                    </div>\n                  </td>\n\n                  {/* EPSS */}\n                  <td className=\"py-3 px-4 font-mono\">\n                    <div className=\"text-purple-300 font-bold\">\n                      {(cve.epss.score * 100).toFixed(2)}%\n                    </div>\n                    <div className=\"text-[10px] text-slate-500\">\n                      {cve.epss.percentile}th Percentile\n                    </div>\n                  </td>\n\n                  {/* Exploit Status */}\n                  <td className=\"py-3 px-4\">\n                    <span\n                      className={`text-[10px] px-2 py-0.5 rounded font-semibold font-mono ${\n                        cve.exploitStatus === \'Active Weaponized\'\n                          ? \'bg-red-950 text-red-300 border border-red-800\'\n                          : cve.exploitStatus === \'POC Available\'\n                          ? \'bg-amber-950 text-amber-300 border border-amber-800\'\n                          : \'bg-slate-800 text-slate-400\'\n                      }`}\n                    >\n                      {cve.exploitStatus}\n                    </span>\n                  </td>\n\n                  {/* Ingestion Sources */}\n                  <td className=\"py-3 px-4\">\n                    <div className=\"flex flex-wrap gap-1\">\n                      {cve.sourceFeeds.map((src, i) => (\n                        <span\n                          key={i}\n                          className=\"bg-slate-950 border border-slate-800 text-slate-300 px-1.5 py-0.2 rounded text-[10px] font-mono\"\n                        >\n                          {src}\n                        </span>\n                      ))}\n                    </div>\n                  </td>\n\n                  {/* Action */}\n                  <td className=\"py-3 px-4 text-right\">\n                    <button\n                      onClick={() => setInspectCve(cve)}\n                      className=\"text-xs text-indigo-400 hover:text-indigo-300 font-medium inline-flex items-center space-x-1 bg-slate-950 px-2 py-1 rounded border border-slate-800\"\n                    >\n                      <FileJson className=\"w-3.5 h-3.5\" />\n                      <span>JSON</span>\n                    </button>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Raw JSON Inspector Modal */}\n      {inspectCve && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4\">\n          <div className=\"bg-slate-900 border border-slate-700 rounded-xl max-w-3xl w-full p-6 shadow-2xl relative\">\n            <button\n              onClick={() => setInspectCve(null)}\n              className=\"absolute top-4 right-4 text-slate-400 hover:text-white\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"flex items-center justify-between mb-4\">\n              <h2 className=\"text-base font-bold text-white font-mono flex items-center gap-2\">\n                <FileJson className=\"w-5 h-5 text-indigo-400\" />\n                Normalized Ingestion Record: {inspectCve.cveId}\n              </h2>\n              <button\n                onClick={handleCopyJson}\n                className=\"text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1 rounded border border-slate-700 flex items-center space-x-1\"\n              >\n                {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copied ? \'Copied JSON\' : \'Copy JSON\'}</span>\n              </button>\n            </div>\n\n            <pre className=\"bg-slate-950 border border-slate-800 rounded-lg p-4 font-mono text-[11px] text-emerald-400 max-h-96 overflow-y-auto leading-relaxed\">\n              {JSON.stringify(inspectCve, null, 2)}\n            </pre>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ThreatDataView.tsx"
        }
        overwrite: true
      }
    }
    action_result {
