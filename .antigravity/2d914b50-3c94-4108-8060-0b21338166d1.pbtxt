  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Mail,\n  RotateCw,\n  CheckCircle2,\n  Clock,\n  Search,\n  ShieldCheck,\n} from \'lucide-react\';\n\nexport const EmailHistoryView: React.FC = () => {\n  const { emailLogs, retryEmailDelivery } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [retryingId, setRetryingId] = useState<string | null>(null);\n\n  const filteredLogs = emailLogs.filter(log =>\n    log.recipientEmail.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    log.subject.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    log.advisoryId.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const handleRetry = async (logId: string) => {\n    setRetryingId(logId);\n    await new Promise(r => setTimeout(r, 500));\n    retryEmailDelivery(logId);\n    setRetryingId(null);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\">\n            <Mail className=\"w-5 h-5 text-zinc-300\" />\n            Automated Notification Delivery Log\n          </h1>\n          <p className=\"text-xs text-zinc-400 mt-1\">\n            Audit history of notifications dispatched by the autonomous engine with retry schedules (5m / 15m / 1h / 3h / 12h).\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2 text-xs font-mono bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-xl\">\n          <ShieldCheck className=\"w-3.5 h-3.5 text-zinc-400\" />\n          <span className=\"text-zinc-300\">Mailgun TLS 1.3 Active</span>\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 flex items-center justify-between gap-3 shadow-sm\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search logs by recipient, subject, or advisory...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 transition\"\n          />\n        </div>\n\n        <div className=\"text-xs font-mono text-zinc-400\">\n          Total Dispatches: <strong className=\"text-zinc-200\">{emailLogs.length}</strong>\n        </div>\n      </div>\n\n      {/* Email History Table */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-zinc-950/80 border-b border-zinc-800/80 text-zinc-400 font-mono uppercase text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Recipient Email</th>\n                <th className=\"py-3 px-4\">Subject &amp; Advisory</th>\n                <th className=\"py-3 px-4\">Provider</th>\n                <th className=\"py-3 px-4\">Delivery Status</th>\n                <th className=\"py-3 px-4\">Dispatched Timestamp</th>\n                <th className=\"py-3 px-4 text-right\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-zinc-800/60\">\n              {filteredLogs.map(log => {\n                const isDelivered = log.status === \'DELIVERED\';\n\n                return (\n                  <tr key={log.id} className=\"hover:bg-zinc-800/30 transition\">\n                    {/* Recipient */}\n                    <td className=\"py-3 px-4 font-mono font-medium text-zinc-100\">\n                      {log.recipientEmail}\n                    </td>\n\n                    {/* Subject & Advisory */}\n                    <td className=\"py-3 px-4\">\n                      <div className=\"font-medium text-zinc-200 line-clamp-1 max-w-sm\">\n                        {log.subject}\n                      </div>\n                      <div className=\"text-[10px] text-zinc-400 font-mono mt-0.5\">\n                        Ref: {log.advisoryId}\n                      </div>\n                    </td>\n\n                    {/* Provider */}\n                    <td className=\"py-3 px-4 font-mono text-zinc-400 text-[11px]\">\n                      {log.provider}\n                    </td>\n\n                    {/* Status */}\n                    <td className=\"py-3 px-4 font-mono\">\n                      <span className=\"inline-flex items-center space-x-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-zinc-800 text-zinc-300 border border-zinc-700\">\n                        {isDelivered && <CheckCircle2 className=\"w-3 h-3 text-emerald-400\" />}\n                        <span>{log.status}</span>\n                      </span>\n                    </td>\n\n                    {/* Timestamp */}\n                    <td className=\"py-3 px-4 font-mono text-zinc-500 text-[11px]\">\n                      {new Date(log.sentAt).toLocaleString()}\n                    </td>\n\n                    {/* Actions */}\n                    <td className=\"py-3 px-4 text-right\">\n                      {log.status !== \'DELIVERED\' && (\n                        <button\n                          onClick={() => handleRetry(log.id)}\n                          disabled={retryingId === log.id}\n                          className=\"px-2.5 py-1 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 text-xs font-medium inline-flex items-center space-x-1\"\n                        >\n                          <RotateCw className={`w-3 h-3 ${retryingId === log.id ? \'animate-spin\' : \'\'}`} />\n                          <span>Retry</span>\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
