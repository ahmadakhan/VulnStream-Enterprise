hType: \'NONE\',\n    rateLimitPerMin: 60,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:25:00.000Z\',\n    latencyMs: 105,\n    vendorSeed: true,\n    itemCountLastRun: 15,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-chrome\',\n    name: \'Google Chrome Releases & V8 Vulns\',\n    type: \'RSS_ATOM\',\n    url: \'https://chromereleases.googleblog.com/feeds/posts/default\',\n    authType: \'NONE\',\n    rateLimitPerMin: 60,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:40:00.000Z\',\n    latencyMs: 74,\n    vendorSeed: true,\n    itemCountLastRun: 9,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-f5\',\n    name: \'F5 Networks Security Incident Response\',\n    type: \'JSON_SEARCH_API\',\n    url: \'https://my.f5.com/manage/s/article/K99920192\',\n    authType: \'NONE\',\n    rateLimitPerMin: 60,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T21:55:00.000Z\',\n    latencyMs: 180,\n    vendorSeed: true,\n    itemCountLastRun: 7,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-juniper\',\n    name: \'Juniper Networks PSIRT Advisory\',\n    type: \'RSS_ATOM\',\n    url: \'https://kb.juniper.net/InfoCenter/rss/security_advisories.xml\',\n    authType: \'NONE\',\n    rateLimitPerMin: 60,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T21:50:00.000Z\',\n    latencyMs: 195,\n    vendorSeed: true,\n    itemCountLastRun: 5,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-linux\',\n    name: \'Linux Kernel Security Advisory Stream\',\n    type: \'JSON_SEARCH_API\',\n    url: \'https://git.kernel.org/pub/scm/linux/security/vulns.json\',\n    authType: \'NONE\',\n    rateLimitPerMin: 120,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:42:00.000Z\',\n    latencyMs: 65,\n    vendorSeed: true,\n    itemCountLastRun: 33,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-atlassian\',\