              text: "                                <span title=\"CISA KEV Catalog\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                  <Flame className=\"w-3.5 h-3.5 text-amber-400 animate-pulse\" />"
