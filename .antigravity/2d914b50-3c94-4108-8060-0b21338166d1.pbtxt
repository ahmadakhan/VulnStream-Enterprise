}\n      {activeTab === \'health\' && <SystemHealthView />}\n      {activeTab === \'settings\' && <SettingsView />}\n    </main>\n  );\n};\n\nconst Footer: React.FC = () => {\n  return (\n    <footer className=\"border-t border-zinc-800/80 bg-zinc-950 py-5 text-xs text-zinc-500\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono\">\n        <div className=\"flex items-center space-x-2\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" />\n          <span>VulnStream Autonomous Engine v3.4.1</span>\n          <span>\342\200\242</span>\n          <span>PostgreSQL: 127.0.0.1:5432</span>\n        </div>\n        <div className=\"flex items-center space-x-3 text-[11px] text-zinc-500\">\n          <span>APScheduler: Max Instances 1</span>\n          <span>\342\200\242</span>\n          <span>Strict CPE 2.3 IR 7695</span>\n          <span>\342\200\242</span>\n          <span>Zero-Human Autonomous Mode</span>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nexport default function App() {\n  return (\n    <AppProvider>\n      <div className=\"min-h-screen bg-[#09090b] text-zinc-100 flex flex-col selection:bg-zinc-800 selection:text-zinc-100\">\n        <TopHeader />\n        <div className=\"flex-1\">\n          <MainContent />\n        </div>\n        <Footer />\n      </div>\n    </AppProvider>\n  );\n}\n"
        path {
