        replacement_chunks {
          target_content: "  const latestExecution = useMemo(() => executions[0] || null, [executions]);\n\n  const value = {\n    activeTab,\n    setActiveTab,\n    feeds,\n    toggleFeedEnabled,\n    testFeedConnectivity,\n    addFeed,\n    updateFeed,\n    deleteFeed,\n    watchlist,\n    addWatchlistItem,\n    updateWatchlistItem,\n    deleteWatchlistItem,\n    bulkImportWatchlist,\n    cveData,\n    addCustomCve,\n    findings,\n    updateFindingStatus,\n    selectedFinding,\n    setSelectedFinding,\n    advisories,\n    selectedAdvisory,\n    setSelectedAdvisory,\n    alertedCves,\n    resendNotification,\n    executions,\n    isPipelineRunning,\n    currentPipelinePhase,\n    triggerPipelineRun,\n    latestExecution,\n    recipients,\n    addRecipient,\n    toggleRecipientEnabled,\n    deleteRecipient,\n    emailLogs,\n    retryEmailDelivery,\n    advisoryTemplate,\n    setAdvisoryTemplate,\n    sendTestEmail,\n    settings,\n    updateSettings,\n    ntpSyncStatus,\n    auditLogs,\n    addAuditLog,\n    csrfToken,\n    sessionTimeRemainingSec,\n    resetSessionTimeout,\n  };"
          replacement_content: "  const addWebhook = useCallback(\n    (hook: Omit<WebhookEndpoint, \'id\' | \'deliveryCount\'>) => {\n      const newHook: WebhookEndpoint = {\n        ...hook,\n        id: `wh-${Math.random().toString(36).substring(2, 7)}`,\n        deliveryCount: 0,\n      };\n      setWebhooks(prev => [...prev, newHook]);\n      addAuditLog(\'WEBHOOK\', \'INFO\', \'Webhook Endpoint Registered\', `Registered ${newHook.provider} endpoint \"${newHook.name}\".`);\n    },\n    [addAuditLog]\n  );\n\n  const toggleWebhookEnabled = useCallback((id: string) => {\n    setWebhooks(prev => prev.map(w => (w.id === id ? { ...w, enabled: !w.enabled } : w)));\n  }, []);\n\n  const deleteWebhook = useCallback((id: string) => {\n    setWebhooks(prev => prev.filter(w => w.id !== id));\n  }, []);\n\n  const testWebhook = useCallback(\n    async (id: string) => {\n      const hook = webhooks.find(w => w.id === id);\n      if (!hook) return { success: false, statusCode: 404, signature: \'\' };\n\n      const simulatedSig = `sha256=${Array.from({ length: 64 }, () =>\n        Math.floor(Math.random() * 16).toString(16)\n      ).join(\'\')}`;\n      const newLog: WebhookDeliveryLog = {\n        id: `whl-${Date.now().toString(36)}`,\n        endpointId: hook.id,\n        endpointName: hook.name,\n        provider: hook.provider,\n        advisoryId: \'ADV-TEST-001\',\n        cveId: \'CVE-2024-3400\',\n        status: \'SUCCESS\',\n        statusCode: 200,\n        hmacSignature: simulatedSig,\n        sentAt: new Date().toISOString(),\n      };\n\n      setWebhookLogs(prev => [newLog, ...prev]);\n      setWebhooks(prev =>\n        prev.map(w => (w.id === id ? { ...w, deliveryCount: w.deliveryCount + 1 } : w))\n      );\n      addAuditLog(\n        \'WEBHOOK\',\n        \'INFO\',\n        \'Webhook Test Ping Dispatched\',\n        `Payload delivered to ${hook.name} (${hook.provider}) with status 200 OK.`\n      );\n      return { success: true, statusCode: 200, signature: simulatedSig };\n    },\n    [webhooks, addAuditLog]\n  );\n\n  const value = {\n    activeTab,\n    setActiveTab,\n    feeds,\n    toggleFeedEnabled,\n    testFeedConnectivity,\n    addFeed,\n    updateFeed,\n    deleteFeed,\n    watchlist,\n    addWatchlistItem,\n    updateWatchlistItem,\n    deleteWatchlistItem,\n    bulkImportWatchlist,\n    cveData,\n    addCustomCve,\n    findings,\n    updateFindingStatus,\n    selectedFinding,\n    setSelectedFinding,\n    advisories,\n    selectedAdvisory,\n    setSelectedAdvisory,\n    alertedCves,\n    resendNotification,\n    executions,\n    isPipelineRunning,\n    currentPipelinePhase,\n    triggerPipelineRun,\n    latestExecution,\n    recipients,\n    addRecipient,\n    toggleRecipientEnabled,\n    deleteRecipient,\n    webhooks,\n    webhookLogs,\n    addWebhook,\n    toggleWebhookEnabled,\n    deleteWebhook,\n    testWebhook,\n    emailLogs,\n    retryEmailDelivery,\n    advisoryTemplate,\n    setAdvisoryTemplate,\n    sendTestEmail,\n    settings,\n    updateSettings,\n    ntpSyncStatus,\n    auditLogs,\n    addAuditLog,\n    csrfToken,\n    sessionTimeRemainingSec,\n    resetSessionTimeout,\n  };"
