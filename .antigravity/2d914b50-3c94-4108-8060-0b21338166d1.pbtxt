  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport {\n  Mail,\n  RotateCw,\n  CheckCircle2,\n  AlertTriangle,\n  Clock,\n  Search,\n  ExternalLink,\n  ShieldCheck,\n  Send,\n} from \'lucide-react\';\n\nexport const EmailHistoryView: React.FC = () => {\n  const { emailLogs, retryEmailDelivery } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [retryingId, setRetryingId] = useState<string | null>(null);\n\n  const filteredLogs = emailLogs.filter(log =>\n    log.recipientEmail.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    log.subject.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    log.advisoryId.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const handleRetry = async (logId: string) => {\n    setRetryingId(logId);\n    await new Promise(r => setTimeout(r, 600));\n    retryEmailDelivery(logId);\n    setRetryingId(null);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-white tracking-tight flex items-center gap-2\">\n            <Mail className=\"w-5 h-5 text-indigo-400\" />\n            Email Notification History &amp; Backoff Queue\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Tracks Mailgun and SMTP Relay delivery attempts with automated exponential backoff schedule (5m / 15m / 1h / 3h / 12h).\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2 text-xs font-mono bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg\">\n          <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n          <span className=\"text-slate-300\">Mailgun TLS 1.3 Active</span>\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 shadow-md\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search logs by recipient, subject, or advisory...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n          />\n        </div>\n\n        <div className=\"text-xs font-mono text-slate-400\">\n          Total Logs: <strong className=\"text-white\">{emailLogs.length}</strong>\n        </div>\n      </div>\n\n      {/* Email History Table */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden shadow-lg\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-950/80 border-b border-slate-800 text-slate-400 font-mono uppercase text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Recipient Email</th>\n                <th className=\"py-3 px-4\">Subject &amp; Advisory</th>\n                <th className=\"py-3 px-4\">Provider</th>\n                <th className=\"py-3 px-4\">Attempts / Backoff Tier</th>\n                <th className=\"py-3 px-4\">Delivery Status</th>\n                <th className=\"py-3 px-4\">Dispatched Timestamp</th>\n                <th className=\"py-3 px-4 text-right\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {filteredLogs.map(log => {\n                const isRetrying = log.status === \'RETRYING\';\n                const isDelivered = log.status === \'DELIVERED\';\n\n                return (\n                  <tr key={log.id} className=\"hover:bg-slate-800/40 transition\">\n                    {/* Recipient */}\n                    <td className=\"py-3 px-4 font-mono font-medium text-white\">\n                      {log.recipientEmail}\n                    </td>\n\n                    {/* Subject & Advisory */}\n                    <td className=\"py-3 px-4\">\n                      <div className=\"font-semibold text-slate-200 line-clamp-1 max-w-sm\">\n                        {log.subject}\n                      </div>\n                      <div className=\"text-[10px] text-indigo-400 font-mono mt-0.5\">\n                        Ref: {log.advisoryId}\n                      </div>\n                      {log.errorMessage && (\n                        <div className=\"text-[10px] text-red-300 font-mono mt-1 bg-red-950/50 p-1 rounded border border-red-900/60\">\n                          {log.errorMessage}\n                        </div>\n                      )}\n                    </td>\n\n                    {/* Provider */}\n                    <td className=\"py-3 px-4 font-mono text-slate-300 text-[11px]\">\n                      {log.provider}\n                    </td>\n\n                    {/* Backoff schedule */}\n                    <td className=\"py-3 px-4 font-mono text-[11px]\">\n                      <div>Attempt #{log.attemptCount}</div>\n                      <div className=\"text-[10px] text-slate-500 mt-0.5\">\n                        Queue: [{log.retrySchedule.join(\' \342\206\222 \')}]\n                      </div>\n                      {log.nextRetryTime && (\n                        <div className=\"text-[10px] text-amber-300 flex items-center gap-1 mt-0.5\">\n                          <Clock className=\"w-3 h-3\" />\n                          <span>Next retry: {new Date(log.nextRetryTime).toLocaleTimeString()}</span>\n                        </div>\n                      )}\n                    </td>\n\n                    {/* Status */}\n                    <td className=\"py-3 px-4 font-mono\">\n                      <span\n                        className={`inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold ${\n                          isDelivered\n                            ? \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n                            : isRetrying\n                            ? \'bg-amber-950 text-amber-300 border border-amber-800 animate-pulse\'\n                            : \'bg-red-950 text-red-300 border border-red-800\'\n                        }`}\n                      >\n                        {isDelivered && <CheckCircle2 className=\"w-3 h-3\" />}\n                        {isRetrying && <Clock className=\"w-3 h-3\" />}\n                        <span>{log.status}</span>\n                      </span>\n                    </td>\n\n                    {/* Timestamp */}\n                    <td className=\"py-3 px-4 font-mono text-slate-400 text-[11px]\">\n                      {new Date(log.sentAt).toLocaleString()}\n                    </td>\n\n                    {/* Actions */}\n                    <td className=\"py-3 px-4 text-right\">\n                      {log.status !== \'DELIVERED\' && (\n                        <button\n                          onClick={() => handleRetry(log.id)}\n                          disabled={retryingId === log.id}\n                          className=\"px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-medium inline-flex items-center space-x-1\"\n                        >\n                          <RotateCw className={`w-3 h-3 ${retryingId === log.id ? \'animate-spin\' : \'\'}`} />\n                          <span>Retry</span>\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
