      arguments_json: "{\"Append\":false,\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useApp } from \'../context/AppContext\';\\nimport { EmailRecipient } from \'../types\';\\nimport {\\n  Users,\\n  Plus,\\n  Trash2,\\n  Mail,\\n  CheckCircle2,\\n  AlertCircle,\\n  X,\\n  Search,\\n} from \'lucide-react\';\\n\\nexport const RecipientsView: React.FC = () => {\\n  const { recipients, addRecipient, toggleRecipientEnabled, deleteRecipient } = useApp();\\n  const [searchTerm, setSearchTerm] = useState(\'\');\\n  const [showAddModal, setShowAddModal] = useState(false);\\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\\n\\n  const [formData, setFormData] = useState({\\n    name: \'\',\\n    email: \'\',\\n    role: \'\',\\n    subscriptionTier: \'CRITICAL_HIGH_ONLY\' as EmailRecipient[\'subscriptionTier\'],\\n    enabled: true,\\n  });\\n\\n  const filtered = recipients.filter(r =>\\n    r.name.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n    r.email.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n    r.role.toLowerCase().includes(searchTerm.toLowerCase())\\n  );\\n\\n  const handleAddSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setErrorMsg(null);\\n    const ok = addRecipient({\\n      name: formData.name.trim(),\\n      email: formData.email.trim(),\\n      role: formData.role.trim() || \'Security Engineer\',\\n      subscriptionTier: formData.subscriptionTier,\\n      enabled: formData.enabled,\\n    });\\n\\n    if (ok) {\\n      setShowAddModal(false);\\n      setFormData({\\n        name: \'\',\\n        email: \'\',\\n        role: \'\',\\n        subscriptionTier: \'CRITICAL_HIGH_ONLY\',\\n        enabled: true,\\n      });\\n    } else {\\n      setErrorMsg(\'Invalid email format. Please check and try again.\');\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Header */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h1 className=\\\"text-xl font-bold text-white tracking-tight flex items-center gap-2\\\">\\n            <Users className=\\\"w-5 h-5 text-indigo-400\\\" />\\n            Security Notification Recipients &amp; Distribution Lists\\n          </h1>\\n          <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n            Manage authorized SOC stakeholders, on-call pagers, and subscription tiers (All, Critical/High Only, CISA KEV Emergency).\\n          </p>\\n        </div>\\n\\n        <button\\n          onClick={() => {\\n            setErrorMsg(null);\\n            setShowAddModal(true);\\n          }}\\n          className=\\\"text-xs px-3.5 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-semibold shadow-md shadow-red-950/40 transition flex items-center space-x-1.5\\\"\\n        >\\n          <Plus className=\\\"w-3.5 h-3.5\\\" />\\n          <span>Add Recipient</span>\\n        </button>\\n      </div>\\n\\n      {/* Search */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 shadow-md\\\">\\n        <div className=\\\"relative w-full sm:w-80\\\">\\n          <Search className=\\\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\\\" />\\n          <input\\n            type=\\\"text\\\"\\n            placeholder=\\\"Search recipients by name, email, or role...\\\"\\n            value={searchTerm}\\n            onChange={e => setSearchTerm(e.target.value)}\\n            className=\\\"w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500\\\"\\n          />\\n        </div>\\n\\n        <div className=\\\"text-xs font-mono text-slate-400\\\">\\n          Active Recipients: <strong className=\\\"text-emerald-400\\\">{recipients.filter(r => r.enabled).length}</strong> / {recipients.length}\\n        </div>\\n      </div>\\n\\n      {/* Recipients Table */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden shadow-lg\\\">\\n        <div className=\\\"overflow-x-auto\\\">\\n          <table className=\\\"w-full text-left text-xs\\\">\\n            <thead className=\\\"bg-slate-950/80 border-b border-slate-800 text-slate-400 font-mono uppercase text-[11px]\\\">\\n              <tr>\\n                <th className=\\\"py-3 px-4\\\">Recipient Name</th>\\n                <th className=\\\"py-3 px-4\\\">Email Address</th>\\n                <th className=\\\"py-3 px-4\\\">Role / Team</th>\\n                <th className=\\\"py-3 px-4\\\">Subscription Filter</th>\\n                <th className=\\\"py-3 px-4\\\">Delivery Health</th>\\n                <th className=\\\"py-3 px-4\\\">Active</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">Action</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-800/60\\\">\\n              {filtered.map(rec => (\\n                <tr key={rec.id} className=\\\"hover:bg-slate-800/40 transition\\\">\\n                  <td className=\\\"py-3 px-4 font-bold text-white\\\">\\n                    {rec.name}\\n                  </td>\\n                  <td className=\\\"py-3 px-4 font-mono text-indigo-300\\\">\\n                    {rec.email}\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-slate-300\\\">\\n                    {rec.role}\\n                  </td>\\n                  <td className=\\\"py-3 px-4\\\">\\n                    <span className=\\\"text-[10px] font-mono px-2 py-0.5 rounded bg-slate-950 border border-slate-800 text-slate-300\\\">\\n                      {rec.subscriptionTier.replace(/_/g, \' \')}\\n                    </span>\\n                  </td>\\n                  <td className=\\\"py-3 px-4 font-mono text-emerald-400\\\">\\n                    {rec.deliverySuccessRate.toFixed(1)}% Success\\n                  </td>\\n                  <td className=\\\"py-3 px-4\\\">\\n                    <button\\n                      onClick={() => toggleRecipientEnabled(rec.id)}\\n                      className={`w-8 h-4 flex items-center rounded-full p-0.5 transition ${\\n                        rec.enabled ? \'bg-emerald-600 justify-end\' : \'bg-slate-700 justify-start\'\\n                      }`}\\n                      title={rec.enabled ? \'Disable\' : \'Enable\'}\\n                    >\\n                      <span className=\\\"bg-white w-3 h-3 rounded-full shadow-md\\\" />\\n                    </button>\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right\\\">\\n                    <button\\n                      onClick={() => {\\n                        if (confirm(`Remove ${rec.email} from distribution list?`)) {\\n                          deleteRecipient(rec.id);\\n                        }\\n                      }}\\n                      className=\\\"p-1 text-slate-400 hover:text-red-400 transition\\\"\\n                      title=\\\"Remove Recipient\\\"\\n                    >\\n                      <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                    </button>\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n\\n      {/* Add Recipient Modal */}\\n      {showAddModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-slate-700 rounded-xl max-w-md w-full p-6 shadow-2xl relative\\\">\\n            <button\\n              onClick={() => setShowAddModal(false)}\\n              className=\\\"absolute top-4 right-4 text-slate-400 hover:text-white\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <h2 className=\\\"text-base font-bold text-white mb-2 flex items-center gap-2\\\">\\n              <Users className=\\\"w-4 h-4 text-indigo-400\\\" />\\n              Add Security Distribution Recipient\\n            </h2>\\n            <p className=\\\"text-xs text-slate-400 mb-4\\\">\\n              Validated emails receive automated emergency advisories based on selected SLA criteria.\\n            </p>\\n\\n            {errorMsg && (\\n              <div className=\\\"bg-red-950/60 border border-red-800 text-red-200 text-xs p-2.5 rounded mb-3 flex items-center gap-2\\\">\\n                <AlertCircle className=\\\"w-4 h-4 text-red-400 shrink-0\\\" />\\n                <span>{errorMsg}</span>\\n              </div>\\n            )}\\n\\n            <form onSubmit={handleAddSubmit} className=\\\"space-y-4 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-slate-400 mb-1 font-mono\\\">Recipient Name *</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  placeholder=\\\"e.g. Incident Response Lead\\\"\\n                  value={formData.name}\\n                  onChange={e => setFormData({ ...formData, name: e.target.value })}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-400 mb-1 font-mono\\\">Email Address *</label>\\n                <input\\n                  type=\\\"email\\\"\\n                  required\\n                  placeholder=\\\"e.g. secops-alerts@corp.org\\\"\\n                  value={formData.email}\\n                  onChange={e => setFormData({ ...formData, email: e.target.value })}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-400 mb-1 font-mono\\\">Role / Department</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  placeholder=\\\"e.g. Cloud Infrastructure Admin\\\"\\n                  value={formData.role}\\n                  onChange={e => setFormData({ ...formData, role: e.target.value })}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-slate-400 mb-1 font-mono\\\">Alert Subscription Tier</label>\\n                <select\\n                  value={formData.subscriptionTier}\\n                  onChange={e => setFormData({ ...formData, subscriptionTier: e.target.value as any })}\\n                  className=\\\"w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono focus:border-indigo-500\\\"\\n                >\\n                  <option value=\\\"CRITICAL_HIGH_ONLY\\\">Critical &amp; High Only (Default)</option>\\n                  <option value=\\\"CISA_KEV_ONLY\\\">CISA KEV Emergencies Only (P0)</option>\\n                  <option value=\\\"ALL_SEVERITIES\\\">All Severities (P0 - P4)</option>\\n                  <option value=\\\"WEEKLY_DIGEST\\\">Weekly Summary Digest</option>\\n                </select>\\n              </div>\\n\\n              <div className=\\\"flex justify-end space-x-2 pt-3 border-t border-slate-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddModal(false)}\\n                  className=\\\"px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 rounded bg-red-600 hover:bg-red-500 text-white font-semibold\\\"\\n                >\\n                  Add Recipient\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Implement RecipientsView for managing security distribution list with email validation and subscription tiers\",\"Overwrite\":true,\"TargetFile\":\"/src/components/RecipientsView.tsx\",\"toolAction\":\"Creating RecipientsView.tsx\",\"toolSummary\":\"Create recipients view\"}"
