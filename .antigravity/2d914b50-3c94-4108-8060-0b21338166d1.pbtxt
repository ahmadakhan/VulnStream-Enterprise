   ownerGroup: \'NetOps-Infra\',\\n    active: true,\\n    notes: \'Secondary SSL-VPN concentrator for remote engineering\',\\n    createdAt: \'2026-09-05T09:30:00Z\',\\n  },\\n  {\\n    id: \'asset-win-dc\',\\n    vendor: \'microsoft\',\\n    product: \'windows_server_2022\',\\n    cpes: [\\n      \'cpe:2.3:o:microsoft:windows_server_2022:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:a:microsoft:remote_desktop_services:*:*:*:*:*:*:*:*\',\\n    ],\\n    exposure: \'INTERNAL_CRITICAL\',\\n    assetTag: \'DC-CORP-PDC01\',\\n    ownerGroup: \'SysOps-Identity\',\\n    active: true,\\n    notes: \'Tier 0 Active Directory Root Controller and RDS licensing host\',\\n    createdAt: \'2026-08-15T10:00:00Z\',\\n  },\\n  {\\n    id: \'asset-cisco-core\',\\n    vendor: \'cisco\',\\n    product: \'adaptive_security_appliance_software\',\\n    cpes: [\\n      \'cpe:2.3:a:cisco:adaptive_security_appliance_software:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:cisco:ios_xe:*:*:*:*:*:*:*:*\',\\n    ],\\n    exposure: \'DMZ\',\\n    assetTag: \'DMZ-ASA-CLUSTER-A\',\\n    ownerGroup: \'SecOps-Perimeter\',\\n    active: true,\\n    notes: \'DMZ routing and security inspection cluster\',\\n    createdAt: \'2026-08-20T11:00:00Z\',\\n  },\\n  {\\n    id: \'asset-vmw-esxi\',\\n    vendor: \'vmware\',\\n    product: \'esxi\',\\n    cpes: [\\n      \'cpe:2.3:o:vmware:esxi:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:a:vmware:vcenter_server:*:*:*:*:*:*:*:*\',\\n    ],\\n    exposure: \'INTERNAL_CRITICAL\',\\n    assetTag: \'HV-CLUSTER-PROD-01\',\\n    ownerGroup: \'CloudOps-Virtualization\',\\n    active: true,\\n    notes: \'Production VMware vSphere compute hypervisors\',\\n    createdAt: \'2026-07-10T14:00:00Z\',\\n  },\\n  {\\n    id: \'asset-ssh-bastion\',\\n    vendor: \'openbsd\',\\n    product: \'openssh\',\\n    cpes: [\\n      \'cpe:2.3:a:openbsd:openssh:*:*:*:*:*:*:*:*\',\\n    ],\\n    exposure: \'INTERNET_FACING\',\\n    assetTag: \'BASTION-JUMP-PUBLIC\',\\n    ownerGroup: \'DevSecOps\',\\n    active: true,\\n    notes: \'Public SSH jump host protected by Duo MFA\',\\n    createdAt: \'2026-08-01T12:00:00Z\',\\n  },\\n  {\\n    id: \'asset-atlassian-confl\',\\n    vendor: \'atlassian\',\\n    product: \'confluence_server\',\\n    cpes: [\\n      \'cpe:2.3:a:atlassian:confluence_server:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:a:atlassian:confluence_data_center:*:*:*:*:*:*:*:*\',\\n    ],\\n    exposure: \'INTERNAL_CRITICAL\',\\n    assetTag: \'WIKI-CORP-CONFLUENCE\',\\n    ownerGroup: \'IT-Collaboration\',\\n    active: true,\\n    notes: \'Internal engineering wiki with proprietary architectures\',\\n    createdAt: \'2026-09-12T16:00:00Z\',\\n  },\\n  {\\n    id: \'asset-f5-lb\',\\n    vendor: \'f5\',\\n    product: \'big-ip_access_policy_manager\',\\n    cpes: [\\n      \'cpe:2.3:a:f5:big-ip_access_policy_manager:*:*:*:*:*:*:*:*\',\\n    ],\\n    exposure: \'INTERNET_FACING\',\\n    assetTag: \'LB-EXT-APM-VIP\',\\n    ownerGroup: \'NetOps-Infra\',\\n    active: true,\\n    notes: \'Application delivery controller and SSL offload\',\\n    createdAt: \'2026-09-18T09:00:00Z\',\\n  },\\n];\\n\\nexport const INITIAL_NORMALIZED_CVES: NormalizedCVE[] = [\\n  {\\n    cveId: \'CVE-2024-3400\',\\n    title: \'Palo Alto Networks PAN-OS GlobalProtect Command Injection Vulnerability\',\\n    description: \'A command injection vulnerability in the GlobalProtect feature of Palo Alto Networks PAN-OS software for specific PAN-OS versions and distinct feature configurations may enable an unauthenticated attacker to execute arbitrary code with root privileges on the firewall.\',\\n    publishedDate: \'2026-10-18T14:30:00Z\',\\n    modifiedDate: \'2026-10-19T21:45:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 10.0,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H\',\\n      severity: \'CRITICAL\',\\n    },\\n    cwe: [\'CWE-77\', \'CWE-78\'],\\n    cpeMatches: [\\n      \'cpe:2.3:o:paloaltonetworks:pan-os:10.2:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:paloaltonetworks:pan-os:11.0:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:paloaltonetworks:pan-os:11.1:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'CISA KEV\', \'NVD\', \'Palo Alto Networks Unit 42\', \'VulCheck\', \'EPSS\'],\\n    epss: {\\n      score: 0.97341,\\n      percentile: 99.9,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-18\',\\n      dueDate: \'2026-10-21\',\\n      requiredAction: \'Apply vendor hotfixes immediately per PAN-SA-2024-0015 or disable device telemetry.\',\\n      knownRansomwareCampaignUse: \'Known\',\\n    },\\n    exploitStatus: \'Active Weaponized\',\\n    remediation: {\\n      patchUrl: \'https://security.paloaltonetworks.com/CVE-2024-3400\',\\n      vendorAdvisoryRef: \'PAN-SA-2024-0015\',\\n      immediateActions: [\\n        \'Disable Device Telemetry on all active PAN-OS firewalls (Device > Setup > Telemetry).\',\\n        \'Inspect session logs for outbound curl/bash requests originated from management plane.\',\\n        \'Apply Threat Prevention Threat IDs 95187, 95189, and 95191 with action set to reset-both.\',\\n      ],\\n      workarounds: [\\n        \'Restrict GlobalProtect portal access exclusively to sanctioned source IP ranges via geofencing and security rules.\',\\n        \'Apply packet inspection profile to drop malformed SESSID cookies containing shell metacharacters.\',\\n      ],\\n      rollbackPlan: \'If hotfix causes daemon instability, restore PAN-OS configuration snapshot using command \\\"load config from pre-patch-snapshot.xml\\\" and verify BGP peering.\',\\n      stepByStep: [\\n        \'Log into Palo Alto Firewall CLI via SSH.\',\\n        \'Execute: set deviceconfig system device-telemetry opt-out yes\',\\n        \'Commit configuration changes: commit force\',\\n        \'Download required maintenance release: request system software download version 11.0.4-h1\',\\n        \'Install and reboot: request system software install version 11.0.4-h1\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-21762\',\\n    title: \'Fortinet FortiOS Out-of-bounds Write in sslvpn Daemon\',\\n    description: \'A out-of-bounds write vulnerability [CWE-787] in Fortinet FortiOS may allow a remote unauthenticated attacker to execute arbitrary code or commands via specially crafted HTTP requests targeting the SSL-VPN portal.\',\\n    publishedDate: \'2026-10-17T18:00:00Z\',\\n    modifiedDate: \'2026-10-19T20:15:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 9.8,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\',\\n      severity: \'CRITICAL\',\\n    },\\n    cwe: [\'CWE-787\'],\\n    cpeMatches: [\\n      \'cpe:2.3:o:fortinet:fortios:7.0:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:fortinet:fortios:7.2:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:fortinet:fortios:7.4:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'CISA KEV\', \'NVD\', \'Fortinet PSIRT\', \'OpenCVE\', \'EPSS\'],\\n    epss: {\\n      score: 0.96820,\\n      percentile: 99.8,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-17\',\\n      dueDate: \'2026-10-20\',\\n      requiredAction: \'Upgrade to FortiOS 7.4.3+ or disable SSL-VPN interface immediately.\',\\n      knownRansomwareCampaignUse: \'Known\',\\n    },\\n    exploitStatus: \'Active Weaponized\',\\n    remediation: {\\n      patchUrl: \'https://www.fortiguard.com/psirt/FG-IR-24-015\',\\n      vendorAdvisoryRef: \'FG-IR-24-015\',\\n      immediateActions: [\\n        \'Disable SSL-VPN feature completely if not business critical: config vpn ssl settings -> set status disable.\',\\n        \'Review FortiGate crash logs for sslvpnd segmentation fault indicators.\',\\n      ],\\n      workarounds: [\\n        \'Migrate remote users to IPsec VPN tunnels with IKEv2 and certificate-based authentication.\',\\n      ],\\n      rollbackPlan: \'Verify dual firmware partition with \\\"diagnose sys flash list\\\". Boot previous partition in BIOS menu if traffic forwarding degrades.\',\\n      stepByStep: [\\n        \'Connect via serial console or out-of-band management IP.\',\\n        \'Back up current config: execute backup config tftp backup-pre-patch.conf <TFTP_IP>\',\\n        \'Execute upgrade: execute restore image tftp FGT_VM64-v7.4.3.F-build2573.out <TFTP_IP>\',\\n        \'Confirm reboot and verify integrity: diagnose hardware sysinfo\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-38077\',\\n    title: \'Windows Remote Desktop Licensing Service Remote Code Execution Vulnerability (MadLicence)\',\\n    description: \'An unauthenticated remote code execution vulnerability exists in the Windows Remote Desktop Licensing Service. Any unauthenticated attacker can send specially crafted network packets over port 135/3389 to execute arbitrary code within the context of the NT AUTHORITY\\\\\\\\SYSTEM account.\',\\n    publishedDate: \'2026-10-16T12:00:00Z\',\\n    modifiedDate: \'2026-10-19T18:00:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 9.8,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\',\\n      severity: \'CRITICAL\',\\n    },\\n    cwe: [\'CWE-121\', \'CWE-787\'],\\n    cpeMatches: [\\n      \'cpe:2.3:o:microsoft:windows_server_2022:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:microsoft:windows_server_2019:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:a:microsoft:remote_desktop_services:*:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'MSRC\', \'NVD\', \'GHSA\', \'EPSS\'],\\n    epss: {\\n      score: 0.89430,\\n      percentile: 98.7,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-18\',\\n      dueDate: \'2026-10-24\',\\n      requiredAction: \'Deploy Microsoft Security Update KB5040437 or disable RDLicsvr service.\',\\n      knownRansomwareCampaignUse: \'Unknown\',\\n    },\\n    exploitStatus: \'POC Available\',\\n    remediation: {\\n      patchUrl: \'https://msrc.microsoft.com/update-guide/vulnerability/CVE-2024-38077\',\\n      vendorAdvisoryRef: \'MS-SEC-2024-38077\',\\n      immediateActions: [\\n        \'Stop and disable Remote Desktop Licensing Service (TermServLicensing) on non-license servers.\',\\n        \'Block inbound TCP ports 135, 445, and RPC dynamic ports (49152-65535) from untrusted subnets.\',\\n      ],\\n      workarounds: [\\n        \'Enable Network Level Authentication (NLA) on all RDS session hosts.\',\\n      ],\\n      rollbackPlan: \'Uninstall LCU KB5040437 via wusa.exe /uninstall /kb:5040437 /quiet /norestart if domain logon errors manifest.\',\\n      stepByStep: [\\n        \'Open Administrative PowerShell on Target Windows Domain Controller.\',\\n        \'Execute: Stop-Service -Name TermServLicensing -Force\',\\n        \'Execute: Set-Service -Name TermServLicensing -StartupType Disabled\',\\n        \'Verify with: Get-Service -Name TermServLicensing | Select-Object Status, StartType\',\\n        \'Deploy Cumulative Update KB5040437 via SCCM / WSUS ring.\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-6387\',\\n    title: \'regreSSHion: Remote Unauthenticated Code Execution in OpenSSH server (sshd)\',\\n    description: \'A signal handler race condition vulnerability in OpenSSH sshd allows unauthenticated remote code execution as root on glibc-based Linux systems due to improper handling of SIGALRM.\',\\n    publishedDate: \'2026-10-15T06:00:00Z\',\\n    modifiedDate: \'2026-10-19T14:20:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 8.1,\\n      vector: \'CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H\',\\n      severity: \'HIGH\',\\n    },\\n    cwe: [\'CWE-362\', \'CWE-364\'],\\n    cpeMatches: [\\n      \'cpe:2.3:a:openbsd:openssh:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:linux:linux_kernel:*:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'GHSA\', \'NVD\', \'Red Hat Security Data\', \'OSV\', \'EPSS\'],\\n    epss: {\\n      score: 0.74100,\\n      percentile: 97.2,\\n    },\\n    cisaKev: {\\n      isKev: false,\\n    },\\n    exploitStatus: \'POC Available\',\\n    remediation: {\\n      patchUrl: \'https://www.openssh.com/txt/release-9.8\',\\n      vendorAdvisoryRef: \'OSSH-ADV-9.8P1\',\\n      immediateActions: [\\n        \'Set LoginGraceTime 0 in /etc/ssh/sshd_config (prevents remote code execution, note potential DoS if max connections saturated).\',\\n        \'Reload sshd daemon: systemctl reload sshd\',\\n      ],\\n      workarounds: [\\n        \'Enforce IP allowlisting on port 22 at external firewall perimeter.\',\\n      ],\\n      rollbackPlan: \'Revert LoginGraceTime back to 120 and reload sshd.\',\\n      stepByStep: [\\n        \'Edit sshd configuration: sed -i \\\"s/#LoginGraceTime.*/LoginGraceTime 0/\\\" /etc/ssh/sshd_config\',\\n        \'Test sshd config syntax: sshd -t\',\\n        \'Reload service: systemctl reload sshd.service\',\\n        \'Upgrade openssh packages: apt update && apt install --only-upgrade openssh-server\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-20353\',\\n    title: \'Cisco Adaptive Security Appliance and Firepower Threat Defense Web Server Denial of Service Vulnerability\',\\n    description: \'A vulnerability in the web server of Cisco Adaptive Security Appliance (ASA) Software and Cisco Firepower Threat Defense (FTD) Software could allow an unauthenticated remote attacker to trigger a reload of the device, resulting in denial of service.\',\\n    publishedDate: \'2026-10-18T10:00:00Z\',\\n    modifiedDate: \'2026-10-19T19:30:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 8.6,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:N/I:N/A:H\',\\n      severity: \'HIGH\',\\n    },\\n    cwe: [\'CWE-399\', \'CWE-400\'],\\n    cpeMatches: [\\n      \'cpe:2.3:a:cisco:adaptive_security_appliance_software:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:o:cisco:ios_xe:*:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'Cisco PSIRT\', \'NVD\', \'CISA KEV\', \'EPSS\'],\\n    epss: {\\n      score: 0.51200,\\n      percentile: 91.5,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-18\',\\n      dueDate: \'2026-10-22\',\\n      requiredAction: \'Apply Cisco software update or restrict access to administrative interfaces.\',\\n      knownRansomwareCampaignUse: \'Unknown\',\\n    },\\n    exploitStatus: \'Active Weaponized\',\\n    remediation: {\\n      patchUrl: \'https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-websrvs-dos-X8gpenDA\',\\n      vendorAdvisoryRef: \'cisco-sa-asaftd-websrvs-dos\',\\n      immediateActions: [\\n        \'Ensure webvpn or http server is not exposed on untrusted interfaces.\',\\n        \'Run: no http server enable on external interfaces.\',\\n      ],\\n      workarounds: [\\n        \'Apply control plane policing (CoPP) and rate limit HTTP/HTTPS connections on perimeter interfaces.\',\\n      ],\\n      rollbackPlan: \'Reload secondary standby node in failover pair to verify image stability before failover switchover.\',\\n      stepByStep: [\\n        \'Copy software image: copy tftp: flash:asa9-18-4-10-smp-k8.bin\',\\n        \'Set boot variable: boot system flash:asa9-18-4-10-smp-k8.bin\',\\n        \'Save running configuration: write memory\',\\n        \'Reload appliance during maintenance window: reload\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-37085\',\\n    title: \'VMware ESXi Active Directory Integration Authentication Bypass (ESX-AD-Bypass)\',\\n    description: \'A malicious actor with Active Directory administrator privileges could obtain full administrative access to an ESXi host that was previously configured to use an Active Directory group for management by creating an AD group named \\\"ESXi Admins\\\".\',\\n    publishedDate: \'2026-10-14T09:00:00Z\',\\n    modifiedDate: \'2026-10-19T11:00:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 6.8,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H\',\\n      severity: \'MEDIUM\',\\n    },\\n    cwe: [\'CWE-287\'],\\n    cpeMatches: [\\n      \'cpe:2.3:o:vmware:esxi:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:a:vmware:vcenter_server:*:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'VMware / Broadcom\', \'NVD\', \'EPSS\', \'CISA KEV\'],\\n    epss: {\\n      score: 0.43500,\\n      percentile: 88.0,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-18\',\\n      dueDate: \'2026-10-25\',\\n      requiredAction: \'Upgrade ESXi hosts to 8.0U3 or remove default ESXi Admins Active Directory mapping.\',\\n      knownRansomwareCampaignUse: \'Known\',\\n    },\\n    exploitStatus: \'Active Weaponized\',\\n    remediation: {\\n      patchUrl: \'https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/24505\',\\n      vendorAdvisoryRef: \'VMSA-2024-0013\',\\n      immediateActions: [\\n        \'Change advanced setting Config.HostAgent.plugins.hostsvc.esxAdminsGroup to a non-default custom AD group name.\',\\n        \'Audit domain members of \\\"ESXi Admins\\\" security group immediately.\',\\n      ],\\n      workarounds: [\\n        \'Leave ESXi hosts in standalone local authentication mode without AD integration.\',\\n      ],\\n      rollbackPlan: \'Revert advanced system configuration to previous Active Directory group via PowerCLI.\',\\n      stepByStep: [\\n        \'Connect via PowerCLI: Connect-VIServer -Server vcenter.corp.local\',\\n        \'Set custom group: Get-VMHost | Get-AdvancedSetting -Name \\\"Config.HostAgent.plugins.hostsvc.esxAdminsGroup\\\" | Set-AdvancedSetting -Value \\\"SecOps_ESXi_Admin_Protected\\\" -Confirm:$false\',\\n        \'Verify applied setting: Get-VMHost | Get-AdvancedSetting -Name \\\"Config.HostAgent.plugins.hostsvc.esxAdminsGroup\\\"\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-4577\',\\n    title: \'PHP CGI Argument Injection Remote Code Execution Vulnerability\',\\n    description: \'A vulnerability in PHP when used in CGI mode on Windows systems allows parameter injection via Best-Fit encoding, leading to remote arbitrary code execution on Apache and IIS web servers.\',\\n    publishedDate: \'2026-10-15T15:00:00Z\',\\n    modifiedDate: \'2026-10-18T20:00:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 9.8,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\',\\n      severity: \'CRITICAL\',\\n    },\\n    cwe: [\'CWE-78\', \'CWE-88\'],\\n    cpeMatches: [\\n      \'cpe:2.3:a:php:php:*:*:*:*:*:*:*:*\',\\n      \'cpe:2.3:a:apache:http_server:*:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'CISA KEV\', \'NVD\', \'Apache Security\', \'VulCheck\', \'EPSS\'],\\n    epss: {\\n      score: 0.94210,\\n      percentile: 99.4,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-16\',\\n      dueDate: \'2026-10-23\',\\n      requiredAction: \'Apply PHP security release or implement mod_rewrite rule blocking %ad argument sequence.\',\\n      knownRansomwareCampaignUse: \'Known\',\\n    },\\n    exploitStatus: \'Active Weaponized\',\\n    remediation: {\\n      patchUrl: \'https://www.php.net/ChangeLog-8.php#8.3.8\',\\n      vendorAdvisoryRef: \'PHP-SA-2024-4577\',\\n      immediateActions: [\\n        \'Add mod_rewrite rule to Apache httpd.conf: RewriteEngine On RewriteCond %{QUERY_STRING} ^(%ad|%AD) [NC] RewriteRule .* - [F]\',\\n        \'Restart Apache Web Server service.\',\\n      ],\\n      workarounds: [\\n        \'Migrate from Legacy CGI architecture to FastCGI (php-fpm).\',\\n      ],\\n      rollbackPlan: \'Remove mod_rewrite condition and verify website script endpoints.\',\\n      stepByStep: [\\n        \'Open /etc/apache2/conf-available/security.conf\',\\n        \'Append RewriteCond %{QUERY_STRING} ^.*-d.* [NC] and RewriteRule .* - [F]\',\\n        \'Test syntax: apache2ctl configtest\',\\n        \'Reload Apache: systemctl reload apache2\',\\n      ],\\n    },\\n  },\\n  {\\n    cveId: \'CVE-2024-27198\',\\n    title: \'JetBrains TeamCity Authentication Bypass Vulnerability in Web Server\',\\n    description: \'An authentication bypass vulnerability in the web component of JetBrains TeamCity allows an unauthenticated remote attacker to perform administrative actions, create admin tokens, and execute arbitrary code on the TeamCity server.\',\\n    publishedDate: \'2026-10-13T10:00:00Z\',\\n    modifiedDate: \'2026-10-18T18:00:00Z\',\\n    cvss: {\\n      version: \'3.1\',\\n      score: 9.8,\\n      vector: \'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\',\\n      severity: \'CRITICAL\',\\n    },\\n    cwe: [\'CWE-287\', \'CWE-306\'],\\n    cpeMatches: [\\n      \'cpe:2.3:a:jetbrains:teamcity:*:*:*:*:*:*:*:*\',\\n    ],\\n    sourceFeeds: [\'CISA KEV\', \'NVD\', \'GHSA\', \'EPSS\'],\\n    epss: {\\n      score: 0.91230,\\n      percentile: 98.9,\\n    },\\n    cisaKev: {\\n      isKev: true,\\n      dateAdded: \'2026-10-15\',\\n      dueDate: \'2026-10-22\',\\n      requiredAction: \'Upgrade TeamCity to version 2023.11.4 or apply vendor security plugin.\',\\n      knownRansomwareCampaignUse: \'Known\',\\n    },\\n    exploitStatus: \'Active Weaponized\',\\n    remediation: {\\n      patchUrl: \'https://blog.jetbrains.com/teamcity/2024/03/additional-critical-security-issues-affecting-teamcity-on-premises-cve-2024-27198-and-cve-2024-27199/\',\\n      vendorAdvisoryRef: \'TEAMCITY-2024-001\',\\n      immediateActions: [\\n        \'Install TeamCity security patch plugin immediately.\',\\n        \'Audit all newly registered user accounts and access tokens generated in the last 72 hours.\',\\n      ],\\n      workarounds: [\\n        \'Place TeamCity web UI strictly behind internal VPN with IP restriction.\',\\n      ],\\n      rollbackPlan: \'Restore TeamCity database backup and application binary directory.\',\\n      stepByStep: [\\n        \'Download TeamCity-2023.11.4 upgrade package.\',\\n        \'Stop TeamCity server: ./bin/teamcity-server.sh stop\',\\n        \'Extract binaries and perform automatic migration.\',\\n        \'Restart TeamCity: ./bin/teamcity-server.sh start