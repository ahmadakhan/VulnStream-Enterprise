      arguments_json: "{\"Append\":false,\"CodeContent\":\"import React from \'react\';\\nimport { useApp } from \'../context/AppContext\';\\nimport {\\n  Shield,\\n  Flame,\\n  Radio,\\n  FileText,\\n  Server,\\n  ArrowUpRight,\\n  Zap,\\n  Cpu,\\n  MailCheck,\\n  Send,\\n  ExternalLink,\\n  Layers,\\n  ChevronRight,\\n  Database,\\n  Bell,\\n} from \'lucide-react\';\\nimport { Finding } from \'../types\';\\n\\nexport const DashboardView: React.FC = () => {\\n  const {\\n    findings,\\n    watchlist,\\n    feeds,\\n    advisories,\\n    setActiveTab,\\n    setSelectedFinding,\\n    triggerPipelineRun,\\n    isPipelineRunning,\\n    emailLogs,\\n    webhooks,\\n  } = useApp();\\n\\n  const activeVulnerabilities = findings.filter(\\n    f => f.status !== \'RESOLVED\' && f.status !== \'FALSE_POSITIVE\'\\n  );\\n  const kevFindings = findings.filter(f => f.cve.cisaKev.isKev);\\n  const criticalFindings = findings.filter(f => f.cve.cvss.severity === \'CRITICAL\');\\n  const deliveredEmails = emailLogs.filter(e => e.status === \'DELIVERED\').length;\\n\\n  const internetFacingCount = watchlist.filter(w => w.exposure === \'INTERNET_FACING\').length;\\n  const internalCriticalCount = watchlist.filter(w => w.exposure === \'INTERNAL_CRITICAL\').length;\\n  const dmzCount = watchlist.filter(w => w.exposure === \'DMZ\').length;\\n  const otherCount = watchlist.length - internetFacingCount - internalCriticalCount - dmzCount;\\n\\n  const handleSelectFinding = (finding: Finding) => {\\n    setSelectedFinding(finding);\\n    setActiveTab(\'findings\');\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Hero Welcome Card */}\\n      <div className=\\\"bg-zinc-900/60 dark:bg-zinc-900/60 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 rounded-2xl p-6 shadow-sm relative overflow-hidden transition-colors\\\">\\n        <div className=\\\"flex flex-col md:flex-row md:items-center justify-between gap-4\\\">\\n          <div>\\n  