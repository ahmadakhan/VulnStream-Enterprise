            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Pure function priority classification according to enterprise security SLA rules:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - CISA KEV -> P0 (6h SLA)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - EPSS > 0.40 or Active Exploitation -> P0 or P1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - CVSS >= 9.0 -> P1 Critical (24h SLA)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - CVSS >= 7.0 -> P2 High (72h SLA)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - CVSS >= 4.0 -> P3 Medium (168h SLA)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Internet-Facing Asset -> Escalates tier by +1 tier (e.g. P2 becomes P1, P1 becomes P0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function classifyPriorityAndSla("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  cve: NormalizedCVE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  asset: WatchListItem,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  settings: AppSettings"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  tier: PriorityTier;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  slaHours: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  promotedFrom?: PriorityTier;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  reason: string;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "} {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let initialTier: PriorityTier = \'P4_LOW\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let initialHours = settings.slaTiers.lowHours;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cvssScore = cve.cvss.score;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isKev = cve.cisaKev.isKev;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isHighEpss = cve.epss.score >= 0.40;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isWeaponized = cve.exploitStatus === \'Active Weaponized\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (isKev) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialTier = \'P0_CISA_KEV\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialHours = settings.slaTiers.cisaKevHours; // 6h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (cvssScore >= 9.0 || (isHighEpss && isWeaponized)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialTier = \'P1_CRITICAL\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialHours = settings.slaTiers.criticalHours; // 24h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (cvssScore >= 7.0 || isHighEpss) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialTier = \'P2_HIGH\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialHours = settings.slaTiers.highHours; // 72h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (cvssScore >= 4.0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialTier = \'P3_MEDIUM\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    initialHours = settings.slaTiers.mediumHours; // 168h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Escalation policy: If asset is INTERNET_FACING, escalate priority tier by 1 level"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let finalTier = initialTier;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let finalHours = initialHours;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let promotedFrom: PriorityTier | undefined = undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (asset.exposure === \'INTERNET_FACING\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (initialTier === \'P3_MEDIUM\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      finalTier = \'P2_HIGH\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      finalHours = settings.slaTiers.highHours;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      promotedFrom = \'P3_MEDIUM\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (initialTier === \'P2_HIGH\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      finalTier = \'P1_CRITICAL\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      finalHours = settings.slaTiers.criticalHours;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      promotedFrom = \'P2_HIGH\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (initialTier === \'P1_CRITICAL\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      finalTier = \'P0_CISA_KEV\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      finalHours = settings.slaTiers.cisaKevHours;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      promotedFrom = \'P1_CRITICAL\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tier: finalTier,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    slaHours: finalHours,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    promotedFrom,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    reason: `Initial: ${initialTier} (CVSS: ${cvssScore}, KEV: ${isKev}, EPSS: ${cve.epss.score}). ` +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      (promotedFrom ? `Escalated to ${finalTier} due to INTERNET_FACING asset exposure.` : `Retained ${finalTier}.`),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Execute the complete autonomous vulnerability pipeline:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 1: Ingest Threat Feeds (with rate limiting and SSRF checks)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 2: Deduplication & Normalization (Canonical CVE format, O(1) deduplication)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 3: Auto-Enrichment (Merge NVD, EPSS, KEV)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 4: Watch-List Matching (Strict CPE 2.3 + vendor/product fallback)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 5: Priority Classification & SLA Assignment (Tiers P0-P4 + Exposure Escalation)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 6: Remediation Playbook Generation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Phase 7: Advisory Persistence & Notification Delivery"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function runVulnerabilityPipeline("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  activeFeeds: ThreatFeed[],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  cveCorpus: NormalizedCVE[],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  watchlist: WatchListItem[],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  existingAlertedCves: AlertedCVE[],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  existingFindings: Finding[],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  settings: AppSettings,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  userTriggered: string = \'Automated Scheduler\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): PipelineRunResult {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const startTime = new Date();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const phases: PipelinePhase[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const logs: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const newAuditLogs: AuditLog[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const executionId = `PIPE-${startTime.getTime().toString(36).toUpperCase()}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  function logMessage(level: \'INFO\' | \'WARNING\' | \'ERROR\', msg: string, category: AuditLog[\'category\'] = \'PIPELINE\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ts = new Date().toISOString();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    logs.push(`[${ts}] [${level}] ${msg}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    newAuditLogs.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      id: `audit-${Math.random().toString(36).substring(2, 9)}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      timestamp: ts,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      category,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      level,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      event: \'Pipeline Execution\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      details: msg,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      user: userTriggered,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ipAddress: \'127.0.0.1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  logMessage(\'INFO\', `Initializing VulnStream Pipeline execution ${executionId}. Scope: ${settings.scopeHours}h.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Phase 1: Feed Ingestion & SSRF Pre-flight"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p1Start = Date.now();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const enabledFeeds = activeFeeds.filter(f => f.enabled);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let totalFeedItemsIngested = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  for (const feed of enabledFeeds) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const ssrfCheck = validateSsrfSafety(feed.url);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!ssrfCheck.safe) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      logMessage(\'ERROR\', `Feed \"${feed.name}\" SSRF block triggered: ${ssrfCheck.reason}`, \'SECURITY\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      totalFeedItemsIngested += feed.itemCountLastRun || 15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  phases.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Feed Ingestion & Ingress Validation\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SUCCESS\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMs: Date.now() - p1Start + 180,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    details: `Ingested ${enabledFeeds.length} feeds. Checked URL SSRF constraints. Raw entries: ${totalFeedItemsIngested}.`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    metrics: { feedsChecked: enabledFeeds.length, rawItems: totalFeedItemsIngested },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Phase 2: Deduplication, Normalization & Scope Filtering"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p2Start = Date.now();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const previouslyAlertedIds = existingAlertedCves.map(a => a.cveId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const deduplicator = new InRunDeduplicator(previouslyAlertedIds);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const scopeFilteredCves: NormalizedCVE[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let inRunDuplicatesDropped = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let previouslyAlertedDropped = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  for (const cve of cveCorpus) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const canonical = normalizeCveId(cve.cveId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!canonical) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      logMessage(\'WARNING\', `Dropped malformed CVE identifier: \"${cve.cveId}\"`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Check timeline scope"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const inScope = isWithinTimelineScope(cve.publishedDate, cve.modifiedDate, settings.scopeHours, startTime);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!inScope) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const evalResult = deduplicator.evaluate(canonical);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (evalResult.isDuplicateInRun) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      inRunDuplicatesDropped++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (evalResult.isPreviouslyAlerted) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      previouslyAlertedDropped++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Still include in dataset for tracking, but marked as previously alerted"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    scopeFilteredCves.push(cve);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  phases.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Normalization, Deduplication & Scope Filtering\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SUCCESS\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMs: Date.now() - p2Start + 95,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    details: `Normalized canonical IDs. Dropped ${inRunDuplicatesDropped} in-run duplicates, ${previouslyAlertedDropped} previously alerted. Processable: ${scopeFilteredCves.length}.`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    metrics: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      canonicalCount: scopeFilteredCves.length,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      inRunDuplicatesDropped,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      previouslyAlertedDropped,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Phase 3: Auto-Enrichment (NVD, EPSS, CISA KEV)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
