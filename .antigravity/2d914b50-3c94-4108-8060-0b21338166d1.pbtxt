    content: "                  <Download className=\"w-3.5 h-3.5\" />\n                </button>\n                <button\n                  onClick={() => handleCopyMarkdown(adv)}\n                  className=\"p-1.5 rounded-xl bg-zinc-950 border border-zinc-800 text-zinc-400 hover:text-zinc-200 transition\"\n                  title=\"Copy Markdown\"\n                >\n                  {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                </button>\n                <button\n                  onClick={() => handlePrintPdf(adv)}\n                  className=\"px-2.5 py-1 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium border border-zinc-700 flex items-center space-x-1\"\n                  title=\"Export PDF\"\n                >\n                  <Printer className=\"w-3.5 h-3.5 text-zinc-400\" />\n                  <span>PDF Export</span>\n                </button>\n                <button\n                  onClick={() => setActiveModalAdvisory(adv)}\n                  className=\"px-2.5 py-1 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold\"\n                >\n                  View Bulletin\n                </button>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Advisory Modal */}\n      {activeModalAdvisory && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={() => setActiveModalAdvisory(null)}\n              className=\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"border-b border-zinc-800 pb-3 mb-4\">\n              <span className=\"text-[10px] font-medium font-mono px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700\">\n                {activeModalAdvisory.severity} ADVISORY\n              </span>\n              <h2 className=\"text-base font-bold text-zinc-100 mt-2\">\n                {activeModalAdvisory.id}: {activeModalAdvisory.title}\n              </h2>\n              <p className=\"text-xs text-zinc-500 font-mono mt-0.5\">\n                Dispatched automatically on {new Date(activeModalAdvisory.createdDate).toUTCString()}\n              </p>\n            </div>\n\n            <div className=\"space-y-3.5 text-xs\">\n              <div>\n                <h4 className=\"font-semibold text-zinc-300 uppercase tracking-wider mb-1 text-[11px]\">\n                  1. Summary\n                </h4>\n                <p className=\"text-zinc-400 leading-relaxed bg-zinc-950/60 p-3 rounded-xl border border-zinc-800\">\n                  {activeModalAdvisory.executiveSummary}\n                </p>\n              </div>\n\n              <div>\n                <h4 className=\"font-semibold text-zinc-300 uppercase tracking-wider mb-1 text-[11px]\">\n                  2. Impacted Products &amp; Assets\n                </h4>\n                <div className=\"bg-zinc-950/60 p-3 rounded-xl border border-zinc-800 space-y-1 text-zinc-300\">\n                  <div><strong>CVEs:</strong> {activeModalAdvisory.cveIds.join(\', \')}</div>\n                  <div><strong>Monitored Products:</strong> {activeModalAdvisory.affectedSystems.join(\', \')}</div>\n                </div>\n              </div>\n\n              <div>\n                <h4 className=\"font-semibold text-zinc-300 uppercase tracking-wider mb-1 text-[11px]\">\n                  3. Technical Remediation Instructions\n                </h4>\n                <div className=\"bg-zinc-950 p-3 rounded-xl border border-zinc-800 text-zinc-300 font-mono leading-relaxed\">\n                  {activeModalAdvisory.remediationInstructions}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex justify-end space-x-2 mt-5 pt-4 border-t border-zinc-800\">\n              <button\n                onClick={() => handlePrintPdf(activeModalAdvisory)}\n                className=\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs flex items-center space-x-1\"\n              >\n                <Printer className=\"w-3.5 h-3.5\" />\n                <span>Print / Save PDF</span>\n              </button>\n              <button\n                onClick={() => setActiveModalAdvisory(null)}\n                className=\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold text-xs\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
