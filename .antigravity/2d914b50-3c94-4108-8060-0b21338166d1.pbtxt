        instruction: "import {\n  ThreatFeed,\n  WatchListItem,\n  NormalizedCVE,\n  Finding,\n  Advisory,\n  AlertedCVE,\n  EmailRecipient,\n  EmailDeliveryLog,\n  AuditLog,\n  AppSettings,\n} from \'../types\';\n\nexport const INITIAL_FEEDS: ThreatFeed[] = [\n  {\n    id: \'feed-msrc\',\n    name: \'Microsoft Security Response Center (MSRC)\',\n    type: \'JSON_SEARCH_API\',\n    url: \'https://api.msrc.microsoft.com/cvrf/v2.0/updates\',\n    authType: \'API_KEY\',\n    authSecretKey: \'msrc_live_key_99x8a7f...\',\n    rateLimitPerMin: 120,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:30:00.000Z\',\n    latencyMs: 142,\n    vendorSeed: true,\n    itemCountLastRun: 28,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-fortinet\',\n    name: \'Fortinet PSIRT Threat Advisories\',\n    type: \'RSS_ATOM\',\n    url: \'https://www.fortiguard.com/rss/ir.xml\',\n    authType: \'NONE\',\n    rateLimitPerMin: 60,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:35:00.000Z\',\n    latencyMs: 98,\n    vendorSeed: true,\n    itemCountLastRun: 14,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-cisco\',\n    name: \'Cisco Security Advisories & Alerts\',\n    type: \'RSS_ATOM\',\n    url: \'https://tools.cisco.com/security/center/cvrfListing.x?f=rss\',\n    authType: \'NONE\',\n    rateLimitPerMin: 60,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:20:00.000Z\',\n    latencyMs: 210,\n    vendorSeed: true,\n    itemCountLastRun: 19,\n    ssrfValidated: true,\n  },\n  {\n    id: \'feed-vmware\',\n    name: \'VMware / Broadcom Security Advisories\',\n    type: \'STIX_2\',\n    url: \'https://via.broadcom.com/security/advisories/stix2\',\n    authType: \'BEARER\',\n    authSecretKey: \'bcom_token_8829aa01...\',\n    rateLimitPerMin: 90,\n    enabled: true,\n    healthStatus: \'HEALTHY\',\n    lastSync: \'2026-10-19T22:15:00.000Z\',\n    latencyMs: 165,\n    vendorSeed: