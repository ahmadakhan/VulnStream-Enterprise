            }
            lines {
              text: "                <tbody className=\"divide-y divide-slate-800/60\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  {filteredFindings.length === 0 ? ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    <tr>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
