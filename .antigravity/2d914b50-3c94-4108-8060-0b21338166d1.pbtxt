  code_action {
    action_spec {
      create_file {
        instruction: "import React, { createContext, useContext, useState, useEffect, useMemo, useCallback } from \'react\';\nimport {\n  ThreatFeed,\n  WatchListItem,\n  NormalizedCVE,\n  Finding,\n  Advisory,\n  AlertedCVE,\n  EmailRecipient,\n  EmailDeliveryLog,\n  AuditLog,\n  AppSettings,\n  PipelineExecution,\n} from \'../types\';\nimport {\n  INITIAL_FEEDS,\n  INITIAL_WATCHLIST,\n  INITIAL_NORMALIZED_CVES,\n  INITIAL_FINDINGS,\n  INITIAL_ADVISORIES,\n  INITIAL_ALERTED_CVES,\n  INITIAL_RECIPIENTS,\n  INITIAL_EMAIL_LOGS,\n  INITIAL_AUDIT_LOGS,\n  INITIAL_SETTINGS,\n  INITIAL_ADVISORY_TEMPLATE,\n} from \'../data/seedData\';\nimport { runVulnerabilityPipeline, validateSsrfSafety } from \'../engine/pipelineEngine\';\n\ninterface AppContextType {\n  // Navigation\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n\n  // Feeds\n  feeds: ThreatFeed[];\n  toggleFeedEnabled: (id: string) => void;\n  testFeedConnectivity: (id: string) => Promise<{ success: boolean; latency: number; error?: string }>;\n  addFeed: (feed: Omit<ThreatFeed, \'id\' | \'healthStatus\' | \'lastSync\' | \'latencyMs\' | \'itemCountLastRun\' | \'ssrfValidated\'>) => boolean;\n  updateFeed: (feed: ThreatFeed) => void;\n  deleteFeed: (id: string) => void;\n\n  // Watch List\n  watchlist: WatchListItem[];\n  addWatchlistItem: (item: Omit<WatchListItem, \'id\' | \'createdAt\'>) => void;\n  updateWatchlistItem: (item: WatchListItem) => void;\n  deleteWatchlistItem: (id: string) => void;\n  bulkImportWatchlist: (items: any[]) => { imported: number; errors: string[] };\n\n  // Threat Data\n  cveData: NormalizedCVE[];\n  addCustomCve: (cve: NormalizedCVE) => void;\n\n  // Findings\n  findings: Finding[];\n  updateFindingStatus: (findingId: string, newStatus: Finding[\'status\'], note?: string) => void;\n  selectedFinding: Finding | null;\n  setSelectedFinding: (finding: Finding | null) => void;\n\n  // Advisories\n  advisories: Advisory[];\n  selectedAdvisory: Advisory | null;\n  setSelectedAdvisory: (advisory: Advisory | null) => void;\n\n  // Alerted CVEs\n  alertedCves: AlertedCVE[];\n  resendNotification: (cveId: string, reason: string) => void;\n\n  // Pipeline Executions\n  executions: PipelineExecution[];\n  isPipelineRunning: boolean;\n  currentPipelinePhase: string | null;\n  triggerPipelineRun: (scopeHoursOverride?: number) => Promise<PipelineExecution>;\n  latestExecution: PipelineExecution | null;\n\n  // Email & Recipients\n  recipients: EmailRecipient[];\n  addRecipient: (rec: Omit<EmailRecipient, \'id\' | \'deliverySuccessRate\'>) => boolean;\n  toggleRecipientEnabled: (id: string) => void;\n  deleteRecipient: (id: string) => void;\n  emailLogs: EmailDeliveryLog[];\n  retryEmailDelivery: (logId: string) => void;\n\n  // Advisory Template\n  advisoryTemplate: string;\n  setAdvisoryTemplate: (template: string) => void;\n  sendTestEmail: (recipientEmail: string) => { success: boolean; message: string };\n\n  // Settings & NTP\n  settings: AppSettings;\n  updateSettings: (newSettings: Partial<AppSettings>) => void;\n  ntpSyncStatus: { synchronized: boolean; driftMs: number; lastChecked: string };\n\n  // Audit Logs\n  auditLogs: AuditLog[];\n  addAuditLog: (category: AuditLog[\'category\'], level: AuditLog[\'level\'], event: string, details: string) => void;\n\n  // Security & Session\n  csrfToken: string;\n  sessionTimeRemainingSec: number;\n  resetSessionTimeout: () => void;\n}\n\nconst AppContext = createContext<AppContextType | undefined>(undefined);\n\nexport const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [activeTab, setActiveTab] = useState<string>(\'dashboard\');\n\n  const [feeds, setFeeds] = useState<ThreatFeed[]>(INITIAL_FEEDS);\n  const [watchlist, setWatchlist] = useState<WatchListItem[]>(INITIAL_WATCHLIST);\n  const [cveData, setCveData] = useState<NormalizedCVE[]>(INITIAL_NORMALIZED_CVES);\n  const [findings, setFindings] = useState<Finding[]>(INITIAL_FINDINGS);\n  const [advisories, setAdvisories] = useState<Advisory[]>(INITIAL_ADVISORIES);\n  const [alertedCves, setAlertedCves] = useState<AlertedCVE[]>(INITIAL_ALERTED_CVES);\n  const [recipients, setRecipients] = useState<EmailRecipient[]>(INITIAL_RECIPIENTS);\n  const [emailLogs, setEmailLogs] = useState<EmailDeliveryLog[]>(INITIAL_EMAIL_LOGS);\n  const [auditLogs, setAuditLogs] = useState<AuditLog[]>(INITIAL_AUDIT_LOGS);\n  const [settings, setSettings] = useState<AppSettings>(INITIAL_SETTINGS);\n  const [advisoryTemplate, setAdvisoryTemplate] = useState<string>(INITIAL_ADVISORY_TEMPLATE);\n\n  const [selectedFinding, setSelectedFinding] = useState<Finding | null>(null);\n  const [selectedAdvisory, setSelectedAdvisory] = useState<Advisory | null>(null);\n\n  const [executions, setExecutions] = useState<PipelineExecution[]>([]);\n  const [isPipelineRunning, setIsPipelineRunning] = useState<boolean>(false);\n  const [currentPipelinePhase, setCurrentPipelinePhase] = useState<string | null>(null);\n\n  const [csrfToken] = useState<string>(() => \'csrf_\' + Math.random().toString(36).substring(2) + Date.now().toString(36));\n  const [sessionTimeRemainingSec, setSessionTimeRemainingSec] = useState<number>(1800);\n  const [ntpSyncStatus] = useState({\n    synchronized: true,\n    driftMs: 12,\n    lastChecked: new Date().toISOString(),\n  });\n\n  // Session Timeout countdown\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSessionTimeRemainingSec(prev => (prev > 0 ? prev - 1 : 1800));\n    }, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const resetSessionTimeout = useCallback(() => {\n    setSessionTimeRemainingSec(1800);\n  }, []);\n\n  const addAuditLog = useCallback(\n    (category: AuditLog[\'category\'], level: AuditLog[\'level\'], event: string, details: string) => {\n      const newLog: AuditLog = {\n        id: `audit-${Math.random().toString(36).substring(2, 9)}`,\n        timestamp: new Date().toISOString(),\n        category,\n        level,\n        event,\n        details,\n        actor: \'Autonomous Engine\',\n        ipAddress: \'10.0.4.12\',\n      };\n      setAuditLogs(prev => [newLog, ...prev.slice(0, 199)]);\n    },\n    []\n  );\n\n  const toggleFeedEnabled = useCallback((id: string) => {\n    setFeeds(prev =>\n      prev.map(f => (f.id === id ? { ...f, enabled: !f.enabled } : f))\n    );\n  }, []);\n\n  const testFeedConnectivity = useCallback(\n    async (id: string): Promise<{ success: boolean; latency: number; error?: string }> => {\n      const feed = feeds.find(f => f.id === id);\n      if (!feed) return { success: false, latency: 0, error: \'Feed not found\' };\n\n      const ssrfCheck = validateSsrfSafety(feed.url);\n      if (!ssrfCheck.safe) {\n        addAuditLog(\'SECURITY\', \'ERROR\', \'SSRF Violation Blocked\', `Feed ${feed.name}: ${ssrfCheck.reason}`);\n        return { success: false, latency: 0, error: ssrfCheck.reason };\n      }\n\n      const simulatedLatency = Math.floor(65 + Math.random() * 90);\n      await new Promise(r => setTimeout(r, 450));\n\n      setFeeds(prev =>\n        prev.map(f =>\n          f.id === id\n            ? {\n                ...f,\n                healthStatus: \'HEALTHY\',\n                latencyMs: simulatedLatency,\n                lastSync: new Date().toISOString(),\n                errorLog: null,\n              }\n            : f\n        )\n      );\n\n      addAuditLog(\'FEED\', \'INFO\', \'Feed Connectivity Test Passed\', `Feed \"${feed.name}\" responded in ${simulatedLatency}ms.`);\n      return { success: true, latency: simulatedLatency };\n    },\n    [feeds, addAuditLog]\n  );\n\n  const addFeed = useCallback(\n    (newFeedData: Omit<ThreatFeed, \'id\' | \'healthStatus\' | \'lastSync\' | \'latencyMs\' | \'itemCountLastRun\' | \'ssrfValidated\'>) => {\n      const ssrfCheck = validateSsrfSafety(newFeedData.url);\n      if (!ssrfCheck.safe) {\n        addAuditLog(\'SECURITY\', \'ERROR\', \'SSRF Rejected New Feed\', `${newFeedData.url}: ${ssrfCheck.reason}`);\n        return false;\n      }\n\n      const feed: ThreatFeed = {\n        ...newFeedData,\n        id: `feed-custom-${Date.now().toString(36)}`,\n        healthStatus: \'HEALTHY\',\n        lastSync: new Date().toISOString(),\n        latencyMs: 110,\n        itemCountLastRun: 12,\n        ssrfValidated: true,\n      };\n\n      setFeeds(prev => [feed, ...prev]);\n      addAuditLog(\'FEED\', \'INFO\', \'Custom Threat Feed Created\', `Registered new feed \"${feed.name}\"`);\n      return true;\n    },\n    [addAuditLog]\n  );\n\n  const updateFeed = useCallback(\n    (updated: ThreatFeed) => {\n      setFeeds(prev => prev.map(f => (f.id === updated.id ? updated : f)));\n      addAuditLog(\'FEED\', \'INFO\', \'Threat Feed Modified\', `Updated feed \"${updated.name}\"`);\n    },\n    [addAuditLog]\n  );\n\n  const deleteFeed = useCallback(\n    (id: string) => {\n      setFeeds(prev => prev.filter(f => f.id !== id));\n      addAuditLog(\'FEED\', \'WARNING\', \'Threat Feed Removed\', `Deleted feed ID ${id}`);\n    },\n    [addAuditLog]\n  );\n\n  const addWatchlistItem = useCallback(\n    (item: Omit<WatchListItem, \'id\' | \'createdAt\'>) => {\n      const newItem: WatchListItem = {\n        ...item,\n        id: `asset-${Math.random().toString(36).substring(2, 8)}`,\n        createdAt: new Date().toISOString(),\n      };\n      setWatchlist(prev => [newItem, ...prev]);\n      addAuditLog(\'WATCHLIST\', \'INFO\', \'Asset Registered\', `Added product asset ${newItem.assetTag} (${newItem.vendor} ${newItem.product})`);\n    },\n    [addAuditLog]\n  );\n\n  const updateWatchlistItem = useCallback(\n    (item: WatchListItem) => {\n      setWatchlist(prev => prev.map(w => (w.id === item.id ? item : w)));\n      addAuditLog(\'WATCHLIST\', \'INFO\', \'Asset Updated\', `Modified watch-list item ${item.assetTag}`);\n    },\n    [addAuditLog]\n  );\n\n  const deleteWatchlistItem = useCallback(\n    (id: string) => {\n      const found = watchlist.find(w => w.id === id);\n      setWatchlist(prev => prev.filter(w => w.id !== id));\n      if (found) {\n        addAuditLog(\'WATCHLIST\', \'WARNING\', \'Asset Removed\', `Deleted asset ${found.assetTag}`);\n      }\n    },\n    [watchlist, addAuditLog]\n  );\n\n  const bulkImportWatchlist = useCallback(\n    (items: any[]): { imported: number; errors: string[] } => {\n      const errors: string[] = [];\n      let imported = 0;\n      const validNewItems: WatchListItem[] = [];\n\n      if (!Array.isArray(items)) {\n        return { imported: 0, errors: [\'Input must be a valid JSON array of asset objects.\'] };\n      }\n\n      if (items.length > 1000) {\n        return { imported: 0, errors: [\'Bulk import exceeds maximum limit of 1,000 items.\'] };\n      }\n\n      items.forEach((raw, idx) => {\n        if (!raw.vendor || !raw.product || !raw.assetTag) {\n          errors.push(`Row ${idx + 1}: Missing vendor, product, or assetTag.`);\n          return;\n        }\n\n        const exposure = [\n          \'INTERNET_FACING\',\n          \'INTERNAL_CRITICAL\',\n          \'DMZ\',\n          \'WORKSTATION\',\n          \'CLOUD_INFRA\',\n        ].includes(raw.exposure)\n          ? raw.exposure\n          : \'INTERNAL_CRITICAL\';\n\n        const cpes = Array.isArray(raw.cpes) && raw.cpes.length > 0\n          ? raw.cpes\n          : [`cpe:2.3:a:${raw.vendor.toLowerCase()}:${raw.product.toLowerCase()}:*:*:*:*:*:*:*:*`];\n\n        validNewItems.push({\n          id: `asset-bulk-${Date.now().toString(36)}-${idx}`,\n          vendor: String(raw.vendor).toLowerCase().trim(),\n          product: String(raw.product).toLowerCase().trim(),\n          cpes,\n          exposure,\n          assetTag: String(raw.assetTag).trim(),\n          ownerGroup: String(raw.ownerGroup || \'Unassigned\').trim(),\n          active: raw.active !== false,\n          notes: raw.notes ? String(raw.notes) : \'Imported via bulk JSON\',\n          createdAt: new Date().toISOString(),\n        });\n        imported++;\n      });\n\n      if (validNewItems.length > 0) {\n        setWatchlist(prev => [...validNewItems, ...prev]);\n        addAuditLog(\'WATCHLIST\', \'INFO\', \'Bulk Watch-List Import\', `Imported ${imported} product assets.`);\n      }\n\n      return { imported, errors };\n    },\n    [addAuditLog]\n  );\n\n  const addCustomCve = useCallback(\n    (cve: NormalizedCVE) => {\n      setCveData(prev => [cve, ...prev]);\n      addAuditLog(\'PIPELINE\', \'INFO\', \'CVE Ingested\', `Ingested ${cve.cveId} into threat cache.`);\n    },\n    [addAuditLog]\n  );\n\n  const updateFindingStatus = useCallback(\n    (findingId: string, newStatus: Finding[\'status\'], note?: string) => {\n      setFindings(prev =>\n        prev.map(f => {\n          if (f.id === findingId) {\n            const actionNote = note || `Status updated to ${newStatus}`;\n            const updatedTimeline = [\n              ...f.timeline,\n              {\n                timestamp: new Date().toISOString(),\n                action: `Status: ${newStatus}`,\n                system: \'SOC Management\',\n                details: actionNote,\n              },\n            ];\n            return {\n              ...f,\n              status: newStatus,\n              timeline: updatedTimeline,\n            };\n          }\n          return f;\n        })\n      );\n      addAuditLog(\'SECURITY\', \'INFO\', \'Finding Status Transition\', `Finding ${findingId} transitioned to ${newStatus}.`);\n    },\n    [addAuditLog]\n  );\n\n  const resendNotification = useCallback(\n    (cveId: string, reason: string) => {\n      const existingAlert = alertedCves.find(a => a.cveId === cveId);\n\n      setAlertedCves(prev =>\n        prev.map(a =>\n          a.cveId === cveId\n            ? {\n                ...a,\n                lastAlertedAt: new Date().toISOString(),\n                dispatchCount: a.dispatchCount + 1,\n                lastDispatchReason: reason,\n              }\n            : a\n        )\n      );\n\n      const newEmail: EmailDeliveryLog = {\n        id: `eml-resend-${Math.random().toString(36).substring(2, 8)}`,\n        recipientEmail: \'secops-team@enterprise.org\',\n        advisoryId: existingAlert?.advisoryId || \'ADV-2026-NOTICE\',\n        subject: `[AUTONOMOUS NOTICE UPDATE] ${cveId} - Product Vulnerability Advisory`,\n        provider: settings.mailgunConfig.enabled ? \'Mailgun\' : \'SMTP_Relay\',\n        status: \'DELIVERED\',\n        attemptCount: 1,\n        retrySchedule: [\'5m\', \'15m\', \'1h\', \'3h\', \'12h\'],\n        nextRetryTime: null,\n        sentAt: new Date().toISOString(),\n      };\n      setEmailLogs(prev => [newEmail, ...prev]);\n\n      addAuditLog(\'EMAIL\', \'INFO\', \'Notification Dispatched\', `Automated notification re-sent for ${cveId}: ${reason}`);\n    },\n    [alertedCves, settings, addAuditLog]\n  );\n\n  const triggerPipelineRun = useCallback(\n    async (scopeHoursOverride?: number): Promise<PipelineExecution> => {\n      setIsPipelineRunning(true);\n      setCurrentPipelinePhase(\'Ingesting 19 Threat Feeds...\');\n\n      await new Promise(r => setTimeout(r, 250));\n      setCurrentPipelinePhase(\'Normalizing & Deduplicating CVE Identifiers...\');\n      await new Promise(r => setTimeout(r, 250));\n      setCurrentPipelinePhase(\'Correlating NVD CVSS, EPSS & CISA KEV Data...\');\n      await new Promise(r => setTimeout(r, 250));\n      setCurrentPipelinePhase(\'Matching Monitored Product CPE 2.3 Expressions...\');\n      await new Promise(r => setTimeout(r, 250));\n      setCurrentPipelinePhase(\'Autonomous Notification Dispatch (No Human Intervention)...\');\n      await new Promise(r => setTimeout(r, 250));\n\n      const runSettings: AppSettings = scopeHoursOverride\n        ? { ...settings, scopeHours: scopeHoursOverride }\n        : settings;\n\n      const result = runVulnerabilityPipeline(\n        feeds,\n        cveData,\n        watchlist,\n        alertedCves,\n        findings,\n        runSettings,\n        \'Autonomous Pipeline Scheduler\'\n      );\n\n      if (result.newFindings.length > 0) {\n        setFindings(prev => [...result.newFindings, ...prev]);\n      }\n      if (result.newAdvisories.length > 0) {\n        setAdvisories(prev => [...result.newAdvisories, ...prev]);\n      }\n      if (result.newEmailLogs.length > 0) {\n        setEmailLogs(prev => [...result.newEmailLogs, ...prev]);\n      }\n      if (result.newAuditLogs.length > 0) {\n        setAuditLogs(prev => [...result.newAuditLogs, ...prev]);\n      }\n\n      setAlertedCves(result.updatedAlertedCves);\n      setExecutions(prev => [result.execution, ...prev]);\n\n      setIsPipelineRunning(false);\n      setCurrentPipelinePhase(null);\n\n      return result.execution;\n    },\n    [feeds, cveData, watchlist, alertedCves, findings, settings]\n  );\n\n  const addRecipient = useCallback(\n    (rec: Omit<EmailRecipient, \'id\' | \'deliverySuccessRate\'>) => {\n      const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n      if (!emailRegex.test(rec.email)) {\n        return false;\n      }\n\n      const newRec: EmailRecipient = {\n        ...rec,\n        id: `rec-${Math.random().toString(36).substring(2, 7)}`,\n        deliverySuccessRate: 100.0,\n      };\n      setRecipients(prev => [...prev, newRec]);\n      addAuditLog(\'EMAIL\', \'INFO\', \'Recipient Added\', `Added ${newRec.name} <${newRec.email}> to notification list.`);\n      return true;\n    },\n    [addAuditLog]\n  );\n\n  const toggleRecipientEnabled = useCallback((id: string) => {\n    setRecipients(prev => prev.map(r => (r.id === id ? { ...r, enabled: !r.enabled } : r)));\n  }, []);\n\n  const deleteRecipient = useCallback((id: string) => {\n    setRecipients(prev => prev.filter(r => r.id !== id));\n  }, []);\n\n  const retryEmailDelivery = useCallback(\n    (logId: string) => {\n      setEmailLogs(prev =>\n        prev.map(l => {\n          if (l.id === logId) {\n            return {\n              ...l,\n              status: \'DELIVERED\',\n              attemptCount: l.attemptCount + 1,\n              nextRetryTime: null,\n              errorMessage: undefined,\n              sentAt: new Date().toISOString(),\n            };\n          }\n          return l;\n        })\n      );\n      addAuditLog(\'EMAIL\', \'INFO\', \'Email Retried\', `Retry dispatched for log ${logId}`);\n    },\n    [addAuditLog]\n  );\n\n  const sendTestEmail = useCallback(\n    (recipientEmail: string): { success: boolean; message: string } => {\n      const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n      if (!emailRegex.test(recipientEmail)) {\n        return { success: false, message: \'Invalid recipient email format.\' };\n      }\n\n      const testLog: EmailDeliveryLog = {\n        id: `eml-test-${Date.now().toString(36)}`,\n        recipientEmail,\n        advisoryId: \'TEST-NOTICE-001\',\n        subject: \'[TEST ADVISORY] Template Preview Verification\',\n        provider: settings.mailgunConfig.enabled ? \'Mailgun\' : \'SMTP_Relay\',\n        status: \'DELIVERED\',\n        attemptCount: 1,\n        retrySchedule: [\'5m\', \'15m\', \'1h\', \'3h\', \'12h\'],\n        nextRetryTime: null,\n        sentAt: new Date().toISOString(),\n      };\n      setEmailLogs(prev => [testLog, ...prev]);\n      addAuditLog(\'EMAIL\', \'INFO\', \'Test Email Sent\', `Sent template preview to ${recipientEmail}`);\n\n      return { success: true, message: `Test advisory successfully sent to ${recipientEmail}.` };\n    },\n    [settings, addAuditLog]\n  );\n\n  const updateSettings = useCallback(\n    (newSettings: Partial<AppSettings>) => {\n      setSettings(prev => ({ ...prev, ...newSettings }));\n      addAuditLog(\'SECURITY\', \'INFO\', \'Platform Settings Updated\', `Settings updated.`);\n    },\n    [addAuditLog]\n  );\n\n  const latestExecution = useMemo(() => executions[0] || null, [executions]);\n\n  const value = {\n    activeTab,\n    setActiveTab,\n    feeds,\n    toggleFeedEnabled,\n    testFeedConnectivity,\n    addFeed,\n    updateFeed,\n    deleteFeed,\n    watchlist,\n    addWatchlistItem,\n    updateWatchlistItem,\n    deleteWatchlistItem,\n    bulkImportWatchlist,\n    cveData,\n    addCustomCve,\n    findings,\n    updateFindingStatus,\n    selectedFinding,\n    setSelectedFinding,\n    advisories,\n    selectedAdvisory,\n    setSelectedAdvisory,\n    alertedCves,\n    resendNotification,\n    executions,\n    isPipelineRunning,\n    currentPipelinePhase,\n    triggerPipelineRun,\n    latestExecution,\n    recipients,\n    addRecipient,\n    toggleRecipientEnabled,\n    deleteRecipient,\n    emailLogs,\n    retryEmailDelivery,\n    advisoryTemplate,\n    setAdvisoryTemplate,\n    sendTestEmail,\n    settings,\n    updateSettings,\n    ntpSyncStatus,\n    auditLogs,\n    addAuditLog,\n    csrfToken,\n    sessionTimeRemainingSec,\n    resetSessionTimeout,\n  };\n\n  return <AppContext.Provider value={value}>{children}</AppContext.Provider>;\n};\n\nexport const useApp = () => {\n  const context = useContext(AppContext);\n  if (!context) {\n    throw new Error(\'useApp must be used within an AppProvider\');\n  }\n  return context;\n};\n"
        path {
          absolute_uri: "file:///src/context/AppContext.tsx"
        }
        overwrite: true
      }
