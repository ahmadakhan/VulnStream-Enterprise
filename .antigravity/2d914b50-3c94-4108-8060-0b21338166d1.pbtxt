        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { AlertedCVE } from \'../types\';\nimport {\n  Bell,\n  RotateCcw,\n  Search,\n  CheckCircle2,\n  Clock,\n  Mail,\n  Send,\n  X,\n} from \'lucide-react\';\n\nexport const AlertedCVEsView: React.FC = () => {\n  const { alertedCves, resendNotification } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedCve, setSelectedCve] = useState<AlertedCVE | null>(null);\n  const [resendReason, setResendReason] = useState(\'\');\n\n  const filtered = alertedCves.filter(item =>\n    item.cveId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    item.advisoryId.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    item.recipientEmails.some(r => r.toLowerCase().includes(searchTerm.toLowerCase()))\n  );\n\n  const handleConfirmResend = () => {\n    if (selectedCve && resendReason.trim()) {\n      resendNotification(selectedCve.cveId, resendReason);\n      setSelectedCve(null);\n      setResendReason(\'\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\">\n            <Bell className=\"w-5 h-5 text-zinc-300\" />\n            Sent Notification History &amp; Suppression Registry\n          </h1>\n          <p className=\"text-xs text-zinc-400 mt-1\">\n            Canonical O(1) deduplication cache preventing redundant email alerts across periodic runs. Records all automated dispatches.\n          </p>\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 flex items-center justify-between gap-3 shadow-sm\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by CVE, Advisory ID, or recipient...\"\n            value={searchTerm}\n            onChange={e => setSearchTerm(e.target.value)}\n            className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 transition\"\n          />\n        </div>\n\n        <div className=\"text-xs font-mono text-zinc-400\">\n          Total Tracked: <strong className=\"text-zinc-200\">{alertedCves.length}</strong>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-zinc-950/80 border-b border-zinc-800/80 text-zinc-400 font-mono uppercase text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Canonical CVE ID</th>\n                <th className=\"py-3 px-4\">Advisory Reference</th>\n                <th className=\"py-3 px-4\">First Dispatched</th>\n                <th className=\"py-3 px-4\">Last Dispatched</th>\n                <th className=\"py-3 px-4\">Dispatch Count</th>\n                <th className=\"py-3 px-4\">Status</th>\n                <th className=\"py-3 px-4 text-right\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-zinc-800/60\">\n              {filtered.map(item => (\n                <tr key={item.cveId} className=\"hover:bg-zinc-800/30 transition\">\n                  <td className=\"py-3 px-4 font-mono font-bold text-zinc-100 text-sm\">\n                    {item.cveId}\n                  </td>\n                  <td className=\"py-3 px-4 font-mono text-zinc-300\">\n                    {item.advisoryId}\n                  </td>\n                  <td className=\"py-3 px-4 text-zinc-400 font-mono text-[11px]\">\n                    {new Date(item.firstAlertedAt).toLocaleString()}\n                  </td>\n                  <td className=\"py-3 px-4 text-zinc-400 font-mono text-[11px]\">\n                    {new Date(item.lastAlertedAt).toLocaleString()}\n                    {item.lastDispatchReason && (\n                      <div className=\"text-[10px] text-zinc-500 font-sans italic line-clamp-1\">\n                        Reason: {item.lastDispatchReason}\n                      </div>\n                    )}\n                  </td>\n                  <td className=\"py-3 px-4 font-mono text-zinc-300\">\n                    {item.dispatchCount}\n                  </td>\n                  <td className=\"py-3 px-4\">\n                    <span className=\"text-[10px] font-medium px-2 py-0.5 rounded-full font-mono bg-zinc-800 text-zinc-300 border border-zinc-700\">\n                      {item.status}\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-4 text-right\">\n                    <button\n                      onClick={() => {\n                        setSelectedCve(item);\n                        setResendReason(\'\');\n                      }}\n                      className=\"px-2.5 py-1 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 font-medium text-xs inline-flex items-center space-x-1\"\n                    >\n                      <Send className=\"w-3 h-3 text-zinc-400\" />\n                      <span>Resend</span>\n                    </button>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Resend Modal */}\n      {selectedCve && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative\">\n            <button\n              onClick={() => setSelectedCve(null)}\n              className=\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <h3 className=\"text-base font-bold text-zinc-100 mb-1 flex items-center gap-2\">\n              <Send className=\"w-4 h-4 text-zinc-300\" />\n              Resend Notification: {selectedCve.cveId}\n            </h3>\n            <p className=\"text-xs text-zinc-400 mb-4\">\n              Dispatches an updated vulnerability notice for this product to the security distribution list.\n            </p>\n\n            <label className=\"block text-zinc-300 text-xs font-mono mb-1\">\n              Dispatch Rationale / Update Note *\n            </label>\n            <textarea\n              rows={3}\n              required\n              placeholder=\"e.g. Vendor released critical updated patch; re-notifying engineering.\"\n              value={resendReason}\n              onChange={e => setResendReason(e.target.value)}\n              className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-xs text-zinc-100 focus:outline-none focus:border-zinc-600\"\n            />\n\n            <div className=\"flex justify-end space-x-2 mt-4 pt-3 border-t border-zinc-800\">\n              <button\n                onClick={() => setSelectedCve(null)}\n                className=\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmResend}\n                disabled={!resendReason.trim()}\n                className=\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold text-xs disabled:opacity-50\"\n              >\n                Dispatch Notification\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AlertedCVEsView.tsx"
        }
        overwrite: true
      }
    }
