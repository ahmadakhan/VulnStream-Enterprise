      id: "call_153311"
      name: "write_to_file"
      arguments_json: "{\"Append\":false,\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useApp } from \'../context/AppContext\';\\nimport { ThreatFeed, FeedType, FeedAuthType } from \'../types\';\\nimport {\\n  Radio,\\n  Plus,\\n  CheckCircle2,\\n  Lock,\\n  Trash2,\\n  Edit2,\\n  Search,\\n  RotateCw,\\n  ShieldCheck,\\n  X,\\n  Zap,\\n} from \'lucide-react\';\\n\\nexport const ThreatFeedsView: React.FC = () => {\\n  const {\\n    feeds,\\n    toggleFeedEnabled,\\n    testFeedConnectivity,\\n    addFeed,\\n    updateFeed,\\n    deleteFeed,\\n  } = useApp();\\n\\n  const [searchTerm, setSearchTerm] = useState(\'\');\\n  const [testingId, setTestingId] = useState<string | null>(null);\\n  const [showAddModal, setShowAddModal] = useState(false);\\n  const [editingFeed, setEditingFeed] = useState<ThreatFeed | null>(null);\\n\\n  const [formData, setFormData] = useState({\\n    name: \'\',\\n    type: \'RSS_ATOM\' as FeedType,\\n    url: \'\',\\n    authType: \'NONE\' as FeedAuthType,\\n    authSecretKey: \'\',\\n    rateLimitPerMin: 60,\\n    enabled: true,\\n  });\\n\\n  const [formError, setFormError] = useState<string | null>(null);\\n\\n  const filteredFeeds = feeds.filter(feed =>\\n    feed.name.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n    feed.type.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n    feed.url.toLowerCase().includes(searchTerm.toLowerCase())\\n  );\\n\\n  const handleTest = async (feedId: string) => {\\n    setTestingId(feedId);\\n    await testFeedConnectivity(feedId);\\n    setTestingId(null);\\n  };\\n\\n  const handleOpenAdd = () => {\\n    setFormData({\\n      name: \'\',\\n      type: \'RSS_ATOM\',\\n      url: \'https://\',\\n      authType: \'NONE\',\\n      authSecretKey: \'\',\\n      rateLimitPerMin: 60,\\n      enabled: true,\\n    });\\n    setEditingFeed(null);\\n    setFormError(null);\\n    setShowAddModal(true);\\n  };\\n\\n  const handleOpenEdit = (feed: ThreatFeed) => {\\n    setFormData({\\n      name: feed.name,\\n      type: feed.type,\\n      url: feed.url,\\n      authType: feed.authType,\\n      authSecretKey: feed.authSecretKey || \'\',\\n      rateLimitPerMin: feed.rateLimitPerMin,\\n      enabled: feed.enabled,\\n    });\\n    setEditingFeed(feed);\\n    setFormError(null);\\n    setShowAddModal(true);\\n  };\\n\\n  const handleSaveFeed = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setFormError(null);\\n\\n    if (editingFeed) {\\n      updateFeed({\\n        ...editingFeed,\\n        name: formData.name,\\n        type: formData.type,\\n        url: formData.url,\\n        authType: formData.authType,\\n        authSecretKey: formData.authSecretKey ? `pbkdf2_enc_${formData.authSecretKey.slice(0, 4)}***` : undefined,\\n        rateLimitPerMin: formData.rateLimitPerMin,\\n        enabled: formData.enabled,\\n      });\\n      setShowAddModal(false);\\n    } else {\\n      const ok = addFeed({\\n        name: formData.name,\\n        type: formData.type,\\n        url: formData.url,\\n        authType: formData.authType,\\n        authSecretKey: formData.authSecretKey ? `pbkdf2_enc_${formData.authSecretKey.slice(0, 4)}***` : undefined,\\n        rateLimitPerMin: formData.rateLimitPerMin,\\n        enabled: formData.enabled,\\n        vendorSeed: false,\\n      });\\n      if (ok) {\\n        setShowAddModal(false);\\n      } else {\\n        setFormError(\'Failed SSRF validation: URL must not point to private/loopback IP address or include credentials.\');\\n      }\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Header */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h1 className=\\\"text-xl font-bold text-zinc-100 tracking-tight flex items-center gap-2\\\">\\n            <Radio className=\\\"w-5 h-5 text-zinc-300\\\" />\\n            Configurable Threat Feed Ingestion Sources\\n          </h1>\\n          <p className=\\\"text-xs text-zinc-400 mt-1\\\">\\n            Pre-seeded with 16 vendor feeds plus NVD, CISA KEV, and EPSS. Autonomous scheduler polls active feeds without human intervention.\\n          </p>\\n        </div>\\n\\n        <button\\n          onClick={handleOpenAdd}\\n          className=\\\"text-xs px-3.5 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold transition flex items-center space-x-1.5 shadow-sm\\\"\\n        >\\n          <Plus className=\\\"w-3.5 h-3.5\\\" />\\n          <span>Add Threat Feed</span>\\n        </button>\\n      </div>\\n\\n      {/* Search & Stats Bar */}\\n      <div className=\\\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm\\\">\\n        <div className=\\\"relative w-full sm:w-80\\\">\\n          <Search className=\\\"w-4 h-4 text-zinc-500 absolute left-3 top-2.5\\\" />\\n          <input\\n            type=\\\"text\\\"\\n            placeholder=\\\"Search feeds by vendor, protocol, or URL...\\\"\\n            value={searchTerm}\\n            onChange={e => setSearchTerm(e.target.value)}\\n            className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 transition\\\"\\n          />\\n        </div>\\n\\n        <div className=\\\"flex items-center space-x-4 text-xs font-mono\\\">\\n          <div className=\\\"flex items-center space-x-1.5 text-emerald-400\\\">\\n            <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n            <span>{feeds.filter(f => f.enabled).length} Active Feeds</span>\\n          </div>\\n          <div className=\\\"flex items-center space-x-1.5 text-zinc-400\\\">\\n            <ShieldCheck className=\\\"w-3.5 h-3.5 text-zinc-400\\\" />\\n            <span>SSRF Guard: Enforced</span>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Threat Feeds Table */}\\n      <div className=\\\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm\\\">\\n        <div className=\\\"overflow-x-auto\\\">\\n          <table className=\\\"w-full text-left text-xs\\\">\\n            <thead className=\\\"bg-zinc-950/80 border-b border-zinc-800/80 text-zinc-400 font-mono uppercase text-[11px]\\\">\\n              <tr>\\n                <th className=\\\"py-3 px-4\\\">Feed Source / Vendor</th>\\n                <th className=\\\"py-3 px-4\\\">Protocol &amp; Format</th>\\n                <th className=\\\"py-3 px-4\\\">Endpoint URL</th>\\n                <th className=\\\"py-3 px-4\\\">Auth &amp; Rate Limit</th>\\n                <th className=\\\"py-3 px-4\\\">Health &amp; Latency</th>\\n                <th className=\\\"py-3 px-4\\\">Active</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">Actions</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-zinc-800/60\\\">\\n              {filteredFeeds.map(feed => {\\n                const isTesting = testingId === feed.id;\\n\\n                return (\\n                  <tr key={feed.id} className=\\\"hover:bg-zinc-800/30 transition\\\">\\n                    {/* Feed Name */}\\n                    <td className=\\\"py-3 px-4 font-bold text-zinc-100\\\">\\n                      <div className=\\\"flex items-center space-x-2\\\">\\n                        <span>{feed.name}</span>\\n                        {feed.vendorSeed && (\\n                          <span className=\\\"text-[9px] bg-zinc-800 text-zinc-400 px-1.5 py-0.2 rounded font-mono\\\">\\n                            Seed\\n                          </span>\\n                        )}\\n                      </div>\\n                      <div className=\\\"text-[10px] text-zinc-500 font-mono mt-0.5\\\">\\n                        Last Run Ingested: {feed.itemCountLastRun || 0} items\\n                      </div>\\n                    </td>\\n\\n                    {/* Format */}\\n                    <td className=\\\"py-3 px-4 font-mono text-[11px] text-zinc-300\\\">\\n                      {feed.type}\\n                    </td>\\n\\n                    {/* URL */}\\n                    <td className=\\\"py-3 px-4 max-w-xs truncate font-mono text-[11px] text-zinc-400\\\" title={feed.url}>\\n                      {feed.url}\\n                    </td>\\n\\n                    {/* Auth */}\\n                    <td className=\\\"py-3 px-4 font-mono text-[11px]\\\">\\n                      <div className=\\\"flex items-center space-x-1 text-zinc-300\\\">\\n                        {feed.authType !== \'NONE\' && <Lock className=\\\"w-3 h-3 text-zinc-400\\\" />}\\n                        <span>{feed.authType}</span>\\n                      </div>\\n                      <div className=\\\"text-[10px] text-zinc-500\\\">\\n                        Max {feed.rateLimitPerMin} req/min\\n                      </div>\\n                    </td>\\n\\n                    {/* Health & Latency */}\\n                    <td className=\\\"py-3 px-4 font-mono\\\">\\n                      <div className=\\\"flex items-center space-x-1.5\\\">\\n                        <span\\n                          className={`w-2 h-2 rounded-full ${\\n                            feed.healthStatus === \'HEALTHY\'\\n                              ? \'bg-emerald-500\'\\n                              : \'bg-zinc-500\'\\n                          }`}\\n                        />\\n                        <span className=\\\"text-zinc-200 font-semibold text-[11px]\\\">\\n                          {feed.healthStatus}\\n                        </span>\\n                        <span className=\\\"text-zinc-500 text-[10px]\\\">\\n                          ({feed.latencyMs}ms)\\n                        </span>\\n                      </div>\\n                    </td>\\n\\n                    {/* Active toggle */}\\n                    <td className=\\\"py-3 px-4\\\">\\n                      <button\\n                        onClick={() => toggleFeedEnabled(feed.id)}\\n                        className={`w-8 h-4 flex items-center rounded-full p-0.5 transition ${\\n                          feed.enabled ? \'bg-zinc-200 justify-end\' : \'bg-zinc-800 justify-start\'\\n                        }`}\\n                        title={feed.enabled ? \'Disable Feed\' : \'Enable Feed\'}\\n                      >\\n                        <span className=\\\"bg-zinc-950 w-3 h-3 rounded-full shadow-sm\\\" />\\n                      </button>\\n                    </td>\\n\\n                    {/* Actions */}\\n                    <td className=\\\"py-3 px-4 text-right space-x-1.5\\\">\\n                      <button\\n                        onClick={() => handleTest(feed.id)}\\n                        disabled={isTesting}\\n                        className=\\\"px-2.5 py-1 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 text-[11px] font-medium transition inline-flex items-center space-x-1\\\"\\n                        title=\\\"Ping Endpoint & Test SSRF\\\"\\n                      >\\n                        {isTesting ? (\\n                          <RotateCw className=\\\"w-3 h-3 animate-spin text-zinc-400\\\" />\\n                        ) : (\\n                          <Zap className=\\\"w-3 h-3 text-zinc-400\\\" />\\n                        )}\\n                        <span>{isTesting ? \'Testing...\' : \'Test\'}</span>\\n                      </button>\\n                      <button\\n                        onClick={() => handleOpenEdit(feed)}\\n                        className=\\\"p-1 text-zinc-400 hover:text-zinc-200 transition\\\"\\n                        title=\\\"Edit Feed\\\"\\n                      >\\n                        <Edit2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                      {!feed.vendorSeed && (\\n                        <button\\n                          onClick={() => {\\n                            if (confirm(`Delete feed \\\"${feed.name}\\\"?`)) {\\n                              deleteFeed(feed.id);\\n                            }\\n                          }}\\n                          className=\\\"p-1 text-zinc-400 hover:text-zinc-200 transition\\\"\\n                          title=\\\"Delete Feed\\\"\\n                        >\\n                          <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      )}\\n                    </td>\\n                  </tr>\\n                );\\n              })}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n\\n      {/* Add / Edit Custom Feed Modal */}\\n      {showAddModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4\\\">\\n          <div className=\\\"bg-zinc-900 border border-zinc-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative\\\">\\n            <button\\n              onClick={() => setShowAddModal(false)}\\n              className=\\\"absolute top-4 right-4 text-zinc-500 hover:text-zinc-200\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <h2 className=\\\"text-base font-bold text-zinc-100 mb-1 flex items-center gap-2\\\">\\n              <Radio className=\\\"w-4 h-4 text-zinc-300\\\" />\\n              {editingFeed ? \'Edit Threat Feed Source\' : \'Register Custom Threat Feed\'}\\n            </h2>\\n            <p className=\\\"text-xs text-zinc-400 mb-4\\\">\\n              Endpoints are protected against SSRF attacks. API keys are encrypted at rest with PBKDF2.\\n            </p>\\n\\n            {formError && (\\n              <div className=\\\"bg-zinc-950 border border-zinc-700 text-zinc-300 text-xs p-3 rounded-xl mb-4\\\">\\n                {formError}\\n              </div>\\n            )}\\n\\n            <form onSubmit={handleSaveFeed} className=\\\"space-y-4 text-xs\\\">\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Feed Name *</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  placeholder=\\\"e.g. Mandiant Threat Intel Stream\\\"\\n                  value={formData.name}\\n                  onChange={e => setFormData({ ...formData, name: e.target.value })}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Protocol / Format *</label>\\n                  <select\\n                    value={formData.type}\\n                    onChange={e => setFormData({ ...formData, type: e.target.value as FeedType })}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                  >\\n                    <option value=\\\"RSS_ATOM\\\">RSS / Atom XML</option>\\n                    <option value=\\\"STIX_2\\\">STIX 2.x Bundle</option>\\n                    <option value=\\\"TAXII_21\\\">TAXII 2.1 Collection</option>\\n                    <option value=\\\"GITHUB_ADVISORY\\\">GitHub Advisory API</option>\\n                    <option value=\\\"JSON_SEARCH_API\\\">JSON Search API</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Rate Limit (req/min)</label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    min={1}\\n                    max={600}\\n                    value={formData.rateLimitPerMin}\\n                    onChange={e => setFormData({ ...formData, rateLimitPerMin: Number(e.target.value) })}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Endpoint URL *</label>\\n                <input\\n                  type=\\\"url\\\"\\n                  required\\n                  placeholder=\\\"https://feed.provider.org/threats.json\\\"\\n                  value={formData.url}\\n                  onChange={e => setFormData({ ...formData, url: e.target.value })}\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Authentication Type</label>\\n                  <select\\n                    value={formData.authType}\\n                    onChange={e => setFormData({ ...formData, authType: e.target.value as FeedAuthType })}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-200 font-mono focus:border-zinc-600 focus:outline-none\\\"\\n                  >\\n                    <option value=\\\"NONE\\\">None (Public)</option>\\n                    <option value=\\\"API_KEY\\\">API Key Header</option>\\n                    <option value=\\\"BEARER\\\">Bearer Token</option>\\n                    <option value=\\\"BASIC\\\">HTTP Basic Auth</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-zinc-400 mb-1 font-mono\\\">Secret Key / Token</label>\\n                  <input\\n                    type=\\\"password\\\"\\n                    placeholder={formData.authType === \'NONE\' ? \'Not required\' : \'Enter key...\'}\\n                    disabled={formData.authType === \'NONE\'}\\n                    value={formData.authSecretKey}\\n                    onChange={e => setFormData({ ...formData, authSecretKey: e.target.value })}\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-xl p-2.5 text-zinc-100 font-mono focus:border-zinc-600 focus:outline-none disabled:opacity-40\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex justify-end space-x-2 pt-3 border-t border-zinc-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddModal(false)}\\n                  className=\\\"px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-semibold\\\"\\n                >\\n                  {editingFeed ? \'Save Changes\' : \'Save Feed\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Update ThreatFeedsView to NextUI styling and remove any SLA references\",\"Overwrite\":true,\"TargetFile\":\"/src/components/ThreatFeedsView.tsx\",\"toolAction\":\"Updating ThreatFeedsView\",\"toolSummary\":\"Update ThreatFeedsView to NextUI style without SLA\"}"
      thought_signature: ""
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 25
      nanos: 335355456
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "MxPXavX3N5GM28oP0Lq9wQs"
  }
}
