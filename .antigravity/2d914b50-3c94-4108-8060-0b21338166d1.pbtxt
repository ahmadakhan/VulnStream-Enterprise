              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                          <td className=\"py-3 px-3 font-mono text-[11px]\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            <div className=\"flex items-center space-x-1.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                              <span"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                className={`font-bold ${"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                  finding.cve.cvss.score >= 9.0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
