{
  "name": "vulnstream-enterprise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 127.0.0.1",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','server-dist']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:alerts": "node scripts/alert-rule-check.mjs",
    "test:unit": "vitest run --no-coverage --reporter=verbose",
    "test:unit:watch": "vitest --no-coverage --reporter=verbose",
    "test:unit:typecheck": "tsc --noEmit --project tsconfig.json",
    "test:integration": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test-runner",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v --rmi local",
    "test:vitest": "vitest run --reporter=verbose",
    "test:typecheck": "tsc --noEmit",
    "dev:server": "tsx watch --env-file=.env server/main.ts",
    "seed": "node --import tsx --env-file=.env scripts/seed.ts",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server-dist/main.js",
    "operator:create": "node server-dist/create-user.js",
    "correlation:preflight": "node --import tsx --env-file=.env scripts/correlation-preflight.ts",
    "db:migrate": "node --import tsx --env-file=.env server/migrate.ts",
    "correlation:benchmark": "node --import tsx --env-file=.env scripts/correlation-benchmark.ts",
    "deployment:verify": "node --import tsx --env-file=.env scripts/verify-deployment.ts",
    "dev:all": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev\"",
    "matching:evaluate": "node --import tsx scripts/matching-evaluate.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
