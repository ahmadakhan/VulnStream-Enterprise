{
  "name": "vulnstream-enterprise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 127.0.0.1",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','server-dist']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:server": "tsx watch server/main.ts",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server-dist/main.js",
    "operator:create": "node server-dist/create-user.js",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required'); process.exit(1); }\" && node --import tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
